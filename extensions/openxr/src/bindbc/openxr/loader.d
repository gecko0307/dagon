module bindbc.openxr.loader;

import bindbc.loader;
import bindbc.openxr.types;
import bindbc.openxr.funcs;

enum OpenXRSupport
{
    noLibrary,
    badLibrary,
    v100
}

private
{
    SharedLib lib;
    OpenXRSupport loadedVersion;
}

void unloadOpenXR()
{
    if (lib != invalidHandle)
    {
        lib.unload();
    }
}

OpenXRSupport loadedOpenXRVersion()
{
    return loadedVersion;
}

bool isOpenXRLoaded()
{
    return lib != invalidHandle;
}

/// Loads XR_KHR_opengl_enable instance-level entry points after xrCreateInstance.
/// Call this only after enabling XR_KHR_opengl_enable in XrInstanceCreateInfo.
XrResult loadOpenXRGraphicsFunctions(XrInstance instance)
{
    if (xrGetInstanceProcAddr is null || instance is null)
        return XR_ERROR_INITIALIZATION_FAILED;

    PFN_xrVoidFunction proc;
    XrResult result = xrGetInstanceProcAddr(
        instance,
        "xrGetOpenGLGraphicsRequirementsKHR".ptr,
        &proc);

    if (XR_FAILED(result))
    {
        xrGetOpenGLGraphicsRequirementsKHR = null;
        return result;
    }

    xrGetOpenGLGraphicsRequirementsKHR = cast(PFN_xrGetOpenGLGraphicsRequirementsKHR)proc;
    return xrGetOpenGLGraphicsRequirementsKHR is null
        ? XR_ERROR_FUNCTION_UNSUPPORTED
        : XR_SUCCESS;
}

OpenXRSupport loadOpenXR()
{
    version(Windows)
    {
        const(char)[][1] libNames =
        [
            "openxr_loader.dll"
        ];
    }
    else version(OSX)
    {
        const(char)[][1] libNames =
        [
            "libopenxr_loader.dylib"
        ];
    }
    else version(Posix)
    {
        const(char)[][2] libNames =
        [
            "libopenxr_loader.so",
            "/usr/local/lib/libopenxr_loader.so",
        ];
    }
    else static assert(0, "bindbc-openvr doesn't support this platform.");
    
    OpenXRSupport ret;
    foreach(name; libNames)
    {
        ret = loadOpenXR(name.ptr);
        if (ret != OpenXRSupport.noLibrary)
            break;
    }
    return ret;
}

OpenXRSupport loadOpenXR(const(char)* libName)
{
    lib = load(libName);
    if (lib == invalidHandle)
    {
        return OpenXRSupport.noLibrary;
    }
    
    auto errCount = errorCount();
    loadedVersion = OpenXRSupport.badLibrary;
    
    import std.algorithm.searching: startsWith;
    static foreach(symbol; __traits(allMembers, bindbc.openxr.funcs))
    {
        static if (symbol.startsWith("xr") && symbol != "xrGetOpenGLGraphicsRequirementsKHR")
            lib.bindSymbol(
                cast(void**)&__traits(getMember, bindbc.openxr.funcs, symbol),
                __traits(getMember, bindbc.openxr.funcs, symbol).stringof);
    }
    
    loadedVersion = OpenXRSupport.v100;
    
    if (errorCount() != errCount)
        return OpenXRSupport.badLibrary;
    
    return loadedVersion;
}
