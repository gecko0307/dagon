import loader = bindbc.loader.sharedlib;
public import bindbc.openxr;
public import dagon.ext.openxr.stereorenderer;

///
struct EyeSwapchain
{
    XrSwapchain handle;
    int width;
    int height;
    XrSwapchainImageOpenGLKHR[] images;
}

class OpenXRManager: Owner
{
    /// Application this manager is bound to.
    Application application;
    
    ///
    OpenXRSupport openXRSupport;
    
    ///
    bool xrAvailable = false;
    
    ///
    bool running = false;
    
    ///
    XrExtensionProperties[] xrExtensions;
    
    ///
    XrInstance xrInstance;
    
    ///
    XrSystemId xrSystemId;
    
    ///
    XrSession xrSession;
    
    ///
    bool sessionRunning = false;
    
    ///
    uint maxSwapchainImageWidth;
    
    ///
    uint maxSwapchainImageHeight;
    
    ///
    bool orientationTracking;
    
    ///
    bool positionTracking;
    
    ///
    XrEnvironmentBlendMode[] blendModes;
    
    ///
    XrEnvironmentBlendMode blendMode;
    
    ///
    XrViewConfigurationView[] configViews;
    
    ///
    XrSpace xrSpace;
    
    /// Swapchains for each eye.
    EyeSwapchain[] swapchains;
    
    ///
    XrView[] views;
    
    ///
    XrCompositionLayerProjectionView[] projViews;
    
    /// OpenGL framebuffer objects for rendering to the OpenXR swapchain.
    GLuint[2] fbo;
    
    /// Corresponding Dagon framebuffers.
    Framebuffer[2] framebuffers;
    
    ///
    this(Application application, Owner owner)
    {
        super(owner);
        this.application = application;
        xrAvailable = initOpenXR();
        running = xrAvailable;
    }
    
    ///
    ~this()
    {
        foreach(ref sw; swapchains)
        {
            xrDestroySwapchain(sw.handle);
            if (sw.images.length)
                Delete(sw.images);
        }
        
        if (xrSpace)
            xrDestroySpace(xrSpace);
        
        if (xrSession)
            xrDestroySession(xrSession);
        
        if (xrInstance)
            xrDestroyInstance(xrInstance);
        
        if (xrExtensions.length)
            Delete(xrExtensions);
        
        if (blendModes.length)
            Delete(blendModes);
        
        if (configViews.length)
            Delete(configViews);
        
        if (swapchains.length)
            Delete(swapchains);
        
        if (views.length)
            Delete(views);
        
        if (projViews.length)
            Delete(projViews);
        
        if (glIsFramebuffer(fbo[0]))
            glDeleteFramebuffers(1, &fbo[0]);
        if (glIsFramebuffer(fbo[1]))
            glDeleteFramebuffers(1, &fbo[1]);
    }
    
    ///
    protected bool initOpenXR()
    {
        openXRSupport = loadOpenXR();
        logInfo("OpenXR support: ", openXRSupport);
        if (openXRSupport != OpenXRSupport.v100)
        {
            foreach(info; loader.errors)
            {
                logError(info.error.to!string, " ", info.message.to!string);
            }
            return false;
        }
        
        XrResult result;
        
        ulong currentVer = XR_CURRENT_API_VERSION;
        logInfo("OpenXR API version: ",
            XR_VERSION_MAJOR(currentVer), ".",
            XR_VERSION_MINOR(currentVer), ".",
            XR_VERSION_PATCH(currentVer)
        );
        
        // Enumerate OpenXR extensions
        uint numExtensions = 0;
        result = xrEnumerateInstanceExtensionProperties(null, 0, &numExtensions, null);
        xrExtensions = New!(XrExtensionProperties[])(numExtensions);
        foreach(ref e; xrExtensions)
        {
            e.type = XR_TYPE_EXTENSION_PROPERTIES;
            e.next = null;
        }
        result = xrEnumerateInstanceExtensionProperties(null, numExtensions, &numExtensions, xrExtensions.ptr);
        if (XR_FAILED(result))
        {
            logError("xrEnumerateInstanceExtensionProperties failed");
            return false;
        }
        
        // Check OpenGL support
        bool hasGL = false;
        logInfo("OpenXR extensions:");
        foreach (ref e; xrExtensions[0..numExtensions])
        {
            string extName = e.extensionName.ptr.to!string;
            if (extName == XR_KHR_OPENGL_ENABLE_EXTENSION_NAME)
                hasGL = true;
            logInfo("  ", extName, " v", e.extensionVersion);
        }
        if (!hasGL)
        {
            logError("OpenXR runtime does not support XR_KHR_OPENGL_ENABLE_EXTENSION_NAME");
            return false;
        }
        
        // Create OpenXR instance
        const(char)*[1] enabledExts = [XR_KHR_OPENGL_ENABLE_EXTENSION_NAME.ptr];
        XrInstanceCreateInfo ici;
        ici.type = XR_TYPE_INSTANCE_CREATE_INFO;
        ici.next = null;
        ici.createFlags = 0;
        setCString(ici.applicationInfo.applicationName, application.name);
        ici.applicationInfo.applicationVersion = 1;
        setCString(ici.applicationInfo.engineName, "Dagon");
        ici.applicationInfo.engineVersion = 1;
        ici.applicationInfo.apiVersion = XR_CURRENT_API_VERSION;
        ici.enabledApiLayerCount = 0;
        ici.enabledApiLayerNames = null;
        ici.enabledExtensionCount = 1;
        ici.enabledExtensionNames = enabledExts.ptr;
        result = xrCreateInstance(&ici, &xrInstance);
        if (XR_FAILED(result))
        {
            logError("xrCreateInstance failed");
            return false;
        }
        
        // Get instance properties
        XrInstanceProperties ip;
        ip.type = XR_TYPE_INSTANCE_PROPERTIES;
        ip.next = null;
        result = xrGetInstanceProperties(xrInstance, &ip);
        if (XR_FAILED(result))
        {
            logError("xrGetInstanceProperties failed");
            return false;
        }
        logInfo("OpenXR runtime: ", ip.runtimeName.ptr.to!string, " ",
            XR_VERSION_MAJOR(ip.runtimeVersion), ".",
            XR_VERSION_MINOR(ip.runtimeVersion), ".",
            XR_VERSION_PATCH(ip.runtimeVersion));
        
        // Get system info
        XrSystemGetInfo sgi;
        sgi.type = XR_TYPE_SYSTEM_GET_INFO;
        sgi.next = null;
        sgi.formFactor = XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
        result = xrGetSystem(xrInstance, &sgi, &xrSystemId);
        if (XR_FAILED(result))
        {
            logError("xrGetSystem failed");
            return false;
        }
        
        XrSystemProperties sp;
        sp.type = XR_TYPE_SYSTEM_PROPERTIES;
        sp.next = null;
        result = xrGetSystemProperties(xrInstance, xrSystemId, &sp);
        logInfo("OpenXR system: ", sp.systemName.ptr.to!string);
        logInfo("OpenXR vendor ID: ", sp.vendorId);
        maxSwapchainImageWidth = sp.graphicsProperties.maxSwapchainImageWidth;
        maxSwapchainImageHeight = sp.graphicsProperties.maxSwapchainImageHeight;
        orientationTracking = sp.trackingProperties.orientationTracking != 0;
        positionTracking = sp.trackingProperties.positionTracking != 0;
        
        // Blend modes
        uint numBlendModes = 0;
        result = xrEnumerateEnvironmentBlendModes(xrInstance, xrSystemId,
            XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, 0, &numBlendModes, null);
        if (XR_FAILED(result))
        {
            logError("xrEnumerateEnvironmentBlendModes failed");
            return false;
        }
        blendModes = New!(XrEnvironmentBlendMode[])(numBlendModes);
        result = xrEnumerateEnvironmentBlendModes(xrInstance, xrSystemId,
            XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, numBlendModes, &numBlendModes, blendModes.ptr);
        if (XR_FAILED(result))
        {
            logError("xrEnumerateEnvironmentBlendModes failed");
            return false;
        }
        blendMode = blendModes[0];
        
        // View configuration
        uint numViews = 0;
        result = xrEnumerateViewConfigurationViews(xrInstance, xrSystemId,
            XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, 0, &numViews, null);
        if (XR_FAILED(result))
        {
            logError("xrEnumerateViewConfigurationViews failed");
            return false;
        }
        if (numViews != 2)
        {
            logError("OpenXR: unsupported view count");
            return false;
        }
        configViews = New!(XrViewConfigurationView[])(numViews);
        foreach(ref v; configViews)
        {
            v.type = XR_TYPE_VIEW_CONFIGURATION_VIEW;
            v.next = null;
        }
        result = xrEnumerateViewConfigurationViews(xrInstance, xrSystemId,
            XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, numViews, &numViews, configViews.ptr);
         if (XR_FAILED(result))
        {
            logError("xrEnumerateViewConfigurationViews failed");
            return false;
        }
        foreach(i, ref v; configViews)
        {
            logInfo("OpenXR view ", i,
                ": recommended ",
                v.recommendedImageRectWidth, "x", 
                v.recommendedImageRectHeight,
                ", samples: ",
                v.recommendedSwapchainSampleCount);
        }
        
        // Loads XR_KHR_opengl_enable instance-level entry points
        result = loadOpenXRGraphicsFunctions(xrInstance);
        if (XR_FAILED(result))
        {
            logError("loadOpenXRGraphicsFunctions failed");
            return false;
        }
        
        // Get graphics requirements
        XrGraphicsRequirementsOpenGLKHR requirements;
        requirements.type = XR_TYPE_GRAPHICS_REQUIREMENTS_OPENGL_KHR;
        result = xrGetOpenGLGraphicsRequirementsKHR(xrInstance, xrSystemId, &requirements);
        if (XR_FAILED(result))
        {
            logError("xrGetOpenGLGraphicsRequirementsKHR failed");
            return false;
        }
        logInfo("OpenXR runtime wants OpenGL ",
            XR_VERSION_MAJOR(requirements.minApiVersionSupported), ".",
            XR_VERSION_MINOR(requirements.minApiVersionSupported), "..",
            XR_VERSION_MAJOR(requirements.maxApiVersionSupported), ".",
            XR_VERSION_MINOR(requirements.maxApiVersionSupported));
        if (requirements.maxApiVersionSupported < 4 && 
            requirements.maxApiVersionSupported < 3)
        {
            logError("OpenXR runtime is incompatible with OpenGL 4.3");
            return false;
        }
        
        // Create session
        version(Windows)
        {
            XrGraphicsBindingOpenGLWin32KHR gb;
            gb.type = XR_TYPE_GRAPHICS_BINDING_OPENGL_WIN32_KHR;
            gb.next = null;
            gb.hDC = application.hdc;
            gb.hGLRC = application.glcontext;
        }
        else version(linux)
        {
            /+
            // TODO
            XrGraphicsBindingOpenGLXlibKHR gb;
            gb.type = XR_TYPE_GRAPHICS_BINDING_OPENGL_XLIB_KHR;
            gb.next = null;
            gb.xDisplay = glXGetCurrentDisplay();
            gb.glxContext = glXGetCurrentContext();
            gb.glxDrawable = glXGetCurrentDrawable();
            gb.visualid = 0;

            if (gb.xDisplay is null || gb.glxContext is null)
                fail("No GLX context (are you running SDL on Wayland? Try SDL_VIDEODRIVER=x11)");

            int fbConfigId = 0, screen = 0;
            glXQueryContext(gb.xDisplay, gb.glxContext, 0x8013 /* GLX_FBCONFIG_ID */, &fbConfigId);
            glXQueryContext(gb.xDisplay, gb.glxContext, 0x800C /* GLX_SCREEN */, &screen);
            int[3] attribs = [0x8013, fbConfigId, 0];
            int nConfigs = 0;
            void** configs = glXChooseFBConfig(gb.xDisplay, screen, attribs.ptr, &nConfigs);
            if (configs is null || nConfigs < 1)
                fail("glXChooseFBConfig failed");
            gb.glxFBConfig = configs[0];
            +/
        }
        XrSessionCreateInfo sci;
        sci.type = XR_TYPE_SESSION_CREATE_INFO;
        sci.next = &gb;
        sci.createFlags = 0;
        sci.systemId = xrSystemId;
        result = xrCreateSession(xrInstance, &sci, &xrSession);
        if (XR_FAILED(result))
        {
            logError("xrCreateSession failed");
            return false;
        }
        
        // Create space
        XrReferenceSpaceCreateInfo rsci;
        rsci.type = XR_TYPE_REFERENCE_SPACE_CREATE_INFO;
        rsci.next = null;
        rsci.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_LOCAL;
        rsci.poseInReferenceSpace = identityPose();
        result = xrCreateReferenceSpace(xrSession, &rsci, &xrSpace);
        if (XR_FAILED(result))
        {
            logError("xrCreateReferenceSpace failed");
            return false;
        }
        
        // Create eye swapchains
        uint numSwapchainFormats = 0;
        result = xrEnumerateSwapchainFormats(xrSession, 0, &numSwapchainFormats, null);
        if (XR_FAILED(result))
        {
            logError("xrEnumerateSwapchainFormats failed");
            return false;
        }
        auto swapchainFormats = New!(long[])(numSwapchainFormats);
        result = xrEnumerateSwapchainFormats(xrSession, numSwapchainFormats, &numSwapchainFormats, swapchainFormats.ptr);
        if (XR_FAILED(result))
        {
            logError("xrEnumerateSwapchainFormats failed");
            return false;
        }
        long chosenFormat = swapchainFormats[0];
        foreach (f; swapchainFormats)
        {
            if (f == GL_RGBA8)
            {
                chosenFormat = f;
                break;
            }
        }
        Delete(swapchainFormats);
        
        swapchains = New!(EyeSwapchain[])(numViews);
        foreach (i; 0..numViews)
        {
            auto cv = configViews[i];
            XrSwapchainCreateInfo sci2;
            sci2.type = XR_TYPE_SWAPCHAIN_CREATE_INFO;
            sci2.next = null;
            sci2.createFlags = 0;
            sci2.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
            sci2.format = chosenFormat;
            sci2.sampleCount = 1;
            sci2.width = cv.recommendedImageRectWidth;
            sci2.height = cv.recommendedImageRectHeight;
            sci2.faceCount = 1;
            sci2.arraySize = 1;
            sci2.mipCount = 1;
            result = xrCreateSwapchain(xrSession, &sci2, &swapchains[i].handle);
            if (XR_FAILED(result))
            {
                logError("xrCreateSwapchain failed (at view ", i, ")");
                return false;
            }
            swapchains[i].width = cast(int)sci2.width;
            swapchains[i].height = cast(int)sci2.height;
            
            uint numImages = 0;
            result = xrEnumerateSwapchainImages(swapchains[i].handle, 0, &numImages, null);
            if (XR_FAILED(result))
            {
                logError("xrEnumerateSwapchainImages failed (at swapchain ", i, ")");
                return false;
            }
            swapchains[i].images = New!(XrSwapchainImageOpenGLKHR[])(numImages);
            foreach (ref img; swapchains[i].images)
            {
                img.type = XR_TYPE_SWAPCHAIN_IMAGE_OPENGL_KHR;
                img.next = null;
            }
            result = xrEnumerateSwapchainImages(swapchains[i].handle, numImages, &numImages,
                cast(XrSwapchainImageBaseHeader*)swapchains[i].images.ptr);
            if (XR_FAILED(result))
            {
                logError("xrEnumerateSwapchainImages failed (at swapchain ", i, ")");
                return false;
            }
            logInfo("Eye ", i,
                ": swapchain ",
                swapchains[i].width, "x", 
                swapchains[i].height, ", ",
                numImages, " images");
        }
        
        views = New!(XrView[])(numViews);
        projViews = New!(XrCompositionLayerProjectionView[])(numViews);
        
        // Left eye FBO
        glGenFramebuffers(1, &fbo[0]);
        framebuffers[0] = New!Framebuffer(fbo[0], this);
        
        // Right eye FBO
        glGenFramebuffers(1, &fbo[1]);
        framebuffers[1] = New!Framebuffer(fbo[1], this);
        
        GLuint[2] depthTextures;
        glGenTextures(2, depthTextures.ptr);
        foreach(i; 0..2)
        {
            glBindFramebuffer(GL_FRAMEBUFFER, framebuffers[i].framebuffer);
            glBindTexture(GL_TEXTURE_2D, depthTextures[i]);

            glTexImage2D(
                GL_TEXTURE_2D,
                0,
                GL_DEPTH_COMPONENT24,
                swapchains[i].width,
                swapchains[i].height,
                0,
                GL_DEPTH_COMPONENT,
                GL_UNSIGNED_INT,
                null
            );

            glFramebufferTexture2D(
                GL_FRAMEBUFFER,
                GL_DEPTH_ATTACHMENT,
                GL_TEXTURE_2D,
                depthTextures[i],
                0
            );
            glBindFramebuffer(GL_FRAMEBUFFER, 0);
        }
        glBindTexture(GL_TEXTURE_2D, 0);
        
        return true;
    }
    
    void update(Time t)
    {
        if (!xrAvailable || !running)
            return;
        
        // OpenXR events
        while (true)
        {
            XrEventDataBuffer ev;
            ev.type = XR_TYPE_EVENT_DATA_BUFFER;
            ev.next = null;
            XrResult result = xrPollEvent(xrInstance, &ev);
            if (XR_FAILED(result) || result == XR_EVENT_UNAVAILABLE)
                break;
            
            if (ev.type == XR_TYPE_EVENT_DATA_SESSION_STATE_CHANGED)
            {
                auto sc = cast(XrEventDataSessionStateChanged*)&ev;
                switch (sc.state)
                {
                    case XR_SESSION_STATE_READY:
                        XrSessionBeginInfo sbi;
                        sbi.type = XR_TYPE_SESSION_BEGIN_INFO;
                        sbi.next = null;
                        sbi.primaryViewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
                        xrBeginSession(xrSession, &sbi);
                        sessionRunning = true;
                        break;
                    case XR_SESSION_STATE_STOPPING:
                        xrEndSession(xrSession);
                        sessionRunning = false;
                        break;
                    case XR_SESSION_STATE_EXITING:
                    case XR_SESSION_STATE_LOSS_PENDING:
                        sessionRunning = false;
                        running = false;
                        break;
                    default:
                        break;
                }
            }
            else if (ev.type == XR_TYPE_EVENT_DATA_INSTANCE_LOSS_PENDING)
            {
                logError("OpenXR instance loss pending");
                running = false;
            }
        }
    }
    
    void render(StereoRenderer renderer)
    {
        if (!xrAvailable || !running || !sessionRunning)
            return;
        
        if (renderer is null)
            return;
        
        auto fwi = XrFrameWaitInfo(XR_TYPE_FRAME_WAIT_INFO, null);
        auto fs = XrFrameState(XR_TYPE_FRAME_STATE, null);
        xrWaitFrame(xrSession, &fwi, &fs);
        
        auto fbi = XrFrameBeginInfo(XR_TYPE_FRAME_BEGIN_INFO, null);
        xrBeginFrame(xrSession, &fbi);
        
        XrCompositionLayerProjection projLayer = {
            type: XR_TYPE_COMPOSITION_LAYER_PROJECTION,
            next: null,
            layerFlags: 0,
            space: xrSpace,
            viewCount: 0,
            views: null
        };
        
        const(XrCompositionLayerBaseHeader)*[1] layers;
        uint layerCount = 0;
        
        if (fs.shouldRender)
        {
            XrViewLocateInfo vli = {
                type: XR_TYPE_VIEW_LOCATE_INFO,
                next: null,
                viewConfigurationType: XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO,
                displayTime: fs.predictedDisplayTime,
                space: xrSpace
            };
            
            auto vs = XrViewState(XR_TYPE_VIEW_STATE, null);
            foreach(ref v; views)
            {
                v.type = XR_TYPE_VIEW;
                v.next = null;
            }
            uint located = 0;
            xrLocateViews(xrSession, &vli, &vs, cast(uint)views.length, &located, views.ptr);
            
            bool poseValid =
                (vs.viewStateFlags & XR_VIEW_STATE_ORIENTATION_VALID_BIT) != 0 &&
                (vs.viewStateFlags & XR_VIEW_STATE_POSITION_VALID_BIT) != 0;
            
            if (poseValid)
            {
                foreach(i; 0..views.length)
                {
                    auto sw = &swapchains[i];
                    
                    XrSwapchainImageAcquireInfo aci;
                    aci.type = XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO;
                    aci.next = null;
                    uint imageIndex;
                    xrAcquireSwapchainImage(sw.handle, &aci, &imageIndex);
                    
                    XrSwapchainImageWaitInfo wi;
                    wi.type = XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO;
                    wi.next = null;
                    wi.timeout = XR_INFINITE_DURATION;
                    xrWaitSwapchainImage(sw.handle, &wi);
                    
                    glBindFramebuffer(GL_FRAMEBUFFER, fbo[i]);
                    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, sw.images[imageIndex].image, 0);
                    
                    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
                    {
                        logError("OpenXR: incomplete framebuffer ", i);
                        running = false;
                    }
                    
                    glViewport(0, 0, sw.width, sw.height);
                    glDisable(GL_SCISSOR_TEST);
                    
                    //glClearColor(1.0f, 0.0f, 1.0f, 1.0f);
                    //glClear(GL_COLOR_BUFFER_BIT);
                    
                    Vector3f eyePosition = views[i].pose.position;
                    Quaternionf eyeRotation = views[i].pose.orientation;
                    
                    renderer.renderEye(cast(uint)i, eyePosition, eyeRotation);
                    
                    glBindFramebuffer(GL_FRAMEBUFFER, 0);
                    glFinish();
                    
                    XrSwapchainImageReleaseInfo rli;
                    rli.type = XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO;
                    rli.next = null;
                    xrReleaseSwapchainImage(sw.handle, &rli);

                    projViews[i].type = XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW;
                    projViews[i].next = null;
                    projViews[i].pose = views[i].pose;
                    projViews[i].fov = views[i].fov;
                    projViews[i].subImage.swapchain = sw.handle;
                    projViews[i].subImage.imageRect.offset.x = 0;
                    projViews[i].subImage.imageRect.offset.y = 0;
                    projViews[i].subImage.imageRect.extent.width = sw.width;
                    projViews[i].subImage.imageRect.extent.height = sw.height;
                    projViews[i].subImage.imageArrayIndex = 0;
                }
                
                projLayer.viewCount = cast(uint)views.length;
                projLayer.views = projViews.ptr;
                layers[0] = cast(const(XrCompositionLayerBaseHeader)*)&projLayer;
                layerCount = 1;
            }
        }
        
        XrFrameEndInfo fei = {
            type: XR_TYPE_FRAME_END_INFO,
            next: null,
            displayTime: fs.predictedDisplayTime,
            environmentBlendMode: blendMode,
            layerCount: layerCount,
            layers: layerCount > 0 ? layers.ptr : null
        };
        xrEndFrame(xrSession, &fei);
    }
}

///
XrPosef identityPose()
{
    XrPosef p;
    p.orientation = Quaternionf.identity;
    p.position = Vector3f(0.0f, 0.0f, 0.0f);
    return p;
}

///
void setCString(size_t N)(ref char[N] dst, string s)
{
    dst[] = 0;
    dst[0..s.length] = s[];
}
