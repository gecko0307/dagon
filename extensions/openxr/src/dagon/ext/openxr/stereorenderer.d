// TODO: move to dlib.math.transformation
Matrix4x4f vrProjection(float angleLeft, float angleRight, float angleUp, float angleDown, float n, float f)
{
    float l = tan(angleLeft)  * n;
    float r = tan(angleRight) * n;
    float u = tan(angleUp)    * n;
    float d = tan(angleDown)  * n;

    Matrix4x4f m = Matrix4x4f.zero;
    m.arrayof[0]  = 2.0f * n / (r - l);
    m.arrayof[5]  = 2.0f * n / (u - d);
    m.arrayof[8]  = (r + l) / (r - l);
    m.arrayof[9]  = (u + d) / (u - d);
    m.arrayof[10] = -(f + n) / (f - n);
    m.arrayof[11] = -1.0f;
    m.arrayof[14] = -2.0f * f * n / (f - n);
    return m;
}

class StereoRenderView: RenderView
{
    protected OpenXRManager oxr;
    protected VREyeTransformation eye;
    protected Matrix4x4f _viewMatrix;
    protected Matrix4x4f _invViewMatrix;
    
    this(OpenXRManager oxr, uint x, uint y, uint width, uint height, Owner owner)
    {
        super(x, y, width, height, owner);
        this.oxr = oxr;
        _viewMatrix = Matrix4x4f.identity;
        _invViewMatrix = Matrix4x4f.identity;
        eye.position = Vector3f(0.0f, 0.0f, 0.0f);
        eye.rotation = Quaternionf.identity;
        eye.angleLeft = 0.0f;
        eye.angleRight = 0.0f;
        eye.angleUp = 0.0f;
        eye.angleDown = 0.0f;
    }
    
    /// Returns the view matrix.
    override Matrix4x4f viewMatrix()
    {
        return _viewMatrix;
    }
    
    /// Returns the inverse view matrix.
    override Matrix4x4f invViewMatrix()
    {
        return _invViewMatrix;
    }
    
    override Matrix4x4f projectionMatrix()
    {
        float zNear = 0.01f;
        float zFar = 1000.0f;
        if (oxr.camera)
        {
            zNear = oxr.camera.zNear;
            zFar = oxr.camera.zFar;
        }
        return vrProjection(
            eye.angleLeft,
            eye.angleRight,
            eye.angleUp,
            eye.angleDown,
            zNear, zFar);
    }
    
    override float zNear()
    {
        if (oxr.camera)
            return oxr.camera.zNear;
        else
            return 0.01f;
    }
    
    override float zFar()
    {
        if (oxr.camera)
            return oxr.camera.zFar;
        else
            return 1000.0f;
    }
    
    void update(VREyeTransformation* eyeTransformation)
    {
        eye = *eyeTransformation;
        if (oxr.camera)
            _invViewMatrix = oxr.camera.absoluteTransformation * translationMatrix(eye.localPosition) * eye.localRotation.toMatrix4x4;
        else
            _invViewMatrix = translationMatrix(eye.position) * eye.rotation.toMatrix4x4;
        _viewMatrix = _invViewMatrix.inverse;
    }
}

class SimpleStereoRenderer: StereoRenderer
{
    OpenXRManager oxr;
    
    uint width;
    uint height;
    
    SimpleClearPass clearPass;
    SimpleBackgroundPass backgroundPass;
    SimpleSpatialPass spatialPass;
    
    StereoRenderView _viewLeft;
    StereoRenderView _viewRight;
    
    this(OpenXRManager oxr, Application application, Owner owner)
    {
        super(application, owner);
        
        this.oxr = oxr;
        
        width = oxr.swapchains[0].width;
        height = oxr.swapchains[0].height;
        
        _viewLeft = New!StereoRenderView(oxr, 0, 0, width, height, this);
        _viewRight = New!StereoRenderView(oxr, 0, 0, width, height, this);
        
        viewLeft = _viewLeft;
        viewRight = _viewRight;
        
        clearPass = New!SimpleClearPass(pipeline);
        clearPass.view = viewLeft;
        
        backgroundPass = New!SimpleBackgroundPass(pipeline);
        backgroundPass.view = viewLeft;
        
        spatialPass = New!SimpleSpatialPass(pipeline);
        spatialPass.layer = 0;
        spatialPass.view = viewLeft;
    }
    
    override void scene(Scene s)
    {
        backgroundPass.group = s.world.background;
        spatialPass.group = s.world.spatial;
        pipeline.environment = s.environment;
    }
    
    override void render()
    {
        oxr.render(this); // OpenXRManager will call renderEye
    }
    
    override void renderEye(uint eye)
    {
        if (eye == 0)
        {
            _viewLeft.update(&oxr.eyes[0]);
            renderEye(oxr.framebuffers[0], _viewLeft);
        }
        else if (eye == 1)
        {
            _viewRight.update(&oxr.eyes[1]);
            renderEye(oxr.framebuffers[1], _viewRight);
        }
    }
    
    /// Render the pipeline for an individual eye
    void renderEye(Framebuffer outputBuffer, RenderView view)
    {
        clearPass.view = view;
        backgroundPass.view = view;
        spatialPass.view = view;
        pipeline.outputBuffer = outputBuffer;
        pipeline.render();
    }
}
