module dagon.ext.security.kdf;

import minicrypto.blake2b;
import dagon.ext.security.session;

/*
 * Key derivation functions.
 * Generate a master key (Blake2b hash from the ephemeral data)
 * and derive shared session keys from it.
 */

immutable string kdfPrefix = "stp:master:";
immutable string kdfClientEncryptionTag = "client_enc";
immutable string kdfServerEncryptionTag = "server_enc";

void serverDeriveKeys(STPSession* serverSession)
{
    // Make a context string to compute a hash from:
    // "stp:master:" + clientPublicKey + clientRandom + serverPublicKey + serverRandom
    enum size_t pl = kdfPrefix.length;
    ubyte[pl + 32 * 4] context;
    for (size_t i = 0; i < pl; i++)
        context[i] = kdfPrefix[i];
    for (size_t i = 0; i < 32; i++)
        context[pl + i] = serverSession.peerPublicKey[i];
    for (size_t i = 0; i < 32; i++)
        context[pl + 32 + i] = serverSession.peerRandom[i];
    for (size_t i = 0; i < 32; i++)
        context[pl + 32 * 2 + i] = serverSession.publicKey[i];
    for (size_t i = 0; i < 32; i++)
        context[pl + 32 * 3 + i] = serverSession.random[i];
    
    // Derive master key
    crypto_blake2b_keyed(
        serverSession.masterKey.ptr,
        serverSession.masterKey.length,
        serverSession.sharedSecret.ptr,
        serverSession.sharedSecret.length,
        context.ptr,
        context.length);
    
    // Derive client encryption key
    crypto_blake2b_keyed(
        serverSession.clientEncryptionKey.ptr,
        serverSession.clientEncryptionKey.length,
        serverSession.masterKey.ptr,
        serverSession.masterKey.length,
        cast(const(ubyte)*)kdfClientEncryptionTag.ptr,
        kdfClientEncryptionTag.length);
    
    // Derive server encryption key
    crypto_blake2b_keyed(
        serverSession.serverEncryptionKey.ptr,
        serverSession.serverEncryptionKey.length,
        serverSession.masterKey.ptr,
        serverSession.masterKey.length,
        cast(const(ubyte)*)kdfServerEncryptionTag.ptr,
        kdfServerEncryptionTag.length);
}

void clientDeriveKeys(STPSession* clientSession)
{
    // Make a context string to compute a hash from:
    // "stp:master:" + clientPublicKey + clientRandom + serverPublicKey + serverRandom
    enum size_t pl = kdfPrefix.length;
    ubyte[pl + 32 * 4] context;
    for (size_t i = 0; i < pl; i++)
        context[i] = kdfPrefix[i];
    for (size_t i = 0; i < 32; i++)
        context[pl + i] = clientSession.publicKey[i];
    for (size_t i = 0; i < 32; i++)
        context[pl + 32 + i] = clientSession.random[i];
    for (size_t i = 0; i < 32; i++)
        context[pl + 32 * 2 + i] = clientSession.peerPublicKey[i];
    for (size_t i = 0; i < 32; i++)
        context[pl + 32 * 3 + i] = clientSession.peerRandom[i];
    
    // Derive master key
    crypto_blake2b_keyed(
        clientSession.masterKey.ptr,
        clientSession.masterKey.length,
        clientSession.sharedSecret.ptr,
        clientSession.sharedSecret.length,
        context.ptr,
        context.length);
    
    // Derive client encryption key
    crypto_blake2b_keyed(
        clientSession.clientEncryptionKey.ptr,
        clientSession.clientEncryptionKey.length,
        clientSession.masterKey.ptr,
        clientSession.masterKey.length,
        cast(const(ubyte)*)kdfClientEncryptionTag.ptr,
        kdfClientEncryptionTag.length);
    
    // Derive server encryption key
    crypto_blake2b_keyed(
        clientSession.serverEncryptionKey.ptr,
        clientSession.serverEncryptionKey.length,
        clientSession.masterKey.ptr,
        clientSession.masterKey.length,
        cast(const(ubyte)*)kdfServerEncryptionTag.ptr,
        kdfServerEncryptionTag.length);
}
