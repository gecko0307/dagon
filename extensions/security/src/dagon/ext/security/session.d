module dagon.ext.security.session;

import dlib.core.memory;

import minicrypto.x25519;
import minicrypto.aead;

struct STPNonce
{
   align(4):
    ulong counter;
    uint fixed;
}

struct STPMessageHeader
{
    STPNonce nonce;
}

enum size_t NonceSize = 12;
enum size_t HeaderSize = STPMessageHeader.sizeof;
enum size_t MACSize = 16;

static assert(STPNonce.sizeof == NonceSize);

struct STPSession
{
    ubyte[32] privateKey;
    ubyte[32] publicKey;
    ubyte[32] random;

    ubyte[32] peerPublicKey;
    ubyte[32] peerRandom;
    
    ubyte[32] sharedSecret;
    ubyte[64] masterKey;
    
    ubyte[32] clientEncryptionKey;
    ubyte[32] serverEncryptionKey;
    
    uint stpVersion;
    
    STPNonce sendNonce;
    STPNonce recvNonce;
    
    bool established;
    
    void wipe() @nogc nothrow
    {
        for (size_t i = 0; i < privateKey.length; i++)
            privateKey[i] = 0;
        
        for (size_t i = 0; i < publicKey.length; i++)
            publicKey[i] = 0;
        
        for (size_t i = 0; i < random.length; i++)
            random[i] = 0;
        
        for (size_t i = 0; i < peerPublicKey.length; i++)
            peerPublicKey[i] = 0;
        
        for (size_t i = 0; i < peerRandom.length; i++)
            peerRandom[i] = 0;
        
        for (size_t i = 0; i < sharedSecret.length; i++)
            sharedSecret[i] = 0;
        
        for (size_t i = 0; i < masterKey.length; i++)
            masterKey[i] = 0;
        
        for (size_t i = 0; i < clientEncryptionKey.length; i++)
            clientEncryptionKey[i] = 0;
        
        for (size_t i = 0; i < serverEncryptionKey.length; i++)
            serverEncryptionKey[i] = 0;
        
        stpVersion = 0;
        
        sendNonce.counter = 0;
        sendNonce.fixed = 0;
        
        recvNonce.counter = 0;
        recvNonce.fixed = 0;
        
        established = false;
    }
    
    void computeSharedSecret() @nogc nothrow
    {
        crypto_x25519(sharedSecret.ptr, privateKey.ptr, peerPublicKey.ptr);
    }
    
    ubyte[] encodeMessage(string plaintext, ref ubyte[32] key)
    {
        ubyte[] message = New!(ubyte[])(HeaderSize + MACSize + plaintext.length);

        // Copy the header to the message
        STPMessageHeader header;
        header.nonce = sendNonce;
        ubyte* pHeader = cast(ubyte*)&header;
        for (size_t i = 0; i < HeaderSize; i++)
            message[i] = pHeader[i];
        
        // Pointers
        ubyte* pMac = &message[HeaderSize];
        ubyte* pCiphertext = &message[HeaderSize + MACSize];
        ubyte* pAd = pHeader;
        size_t adLength = HeaderSize;

        crypto_aead_ctx ctx;
        crypto_aead_init_ietf(
            &ctx,
            key.ptr,
            cast(const(ubyte)*)&header.nonce);
        crypto_aead_write(
            &ctx,
            pCiphertext,
            pMac,
            pAd,
            adLength,
            cast(const(ubyte)*)plaintext.ptr,
            plaintext.length);
        sendNonce.counter++;
        return message;
    }
    
    ubyte[] encodeClientMessage(string plaintext)
    {
        return encodeMessage(plaintext, clientEncryptionKey);
    }
    
    ubyte[] encodeServerMessage(string plaintext)
    {
        return encodeMessage(plaintext, serverEncryptionKey);
    }
    
    bool decodeMessage(ubyte[] message, ref ubyte[32] key, out string outPlaintext)
    {
        if (message.length < HeaderSize + MACSize)
            return false;
        
        char[] plaintext = New!(char[])(message.length - MACSize - HeaderSize);
        
        // Retrieve the header
        STPMessageHeader header;
        ubyte* pHeader = cast(ubyte*)&header;
        for (size_t i = 0; i < HeaderSize; i++)
            pHeader[i] = message[i];
        
        if (header.nonce != recvNonce)
            return false;
        
        // Pointers
        ubyte* pMac = &message[HeaderSize];
        ubyte* pCiphertext = &message[HeaderSize + MACSize];
        ubyte* pAd = pHeader;
        size_t adLength = HeaderSize;
        
        crypto_aead_ctx ctx;
        crypto_aead_init_ietf(
            &ctx,
            key.ptr,
            cast(const(ubyte)*)&header.nonce);
        int result = crypto_aead_read(
            &ctx,
            cast(ubyte*)plaintext.ptr,
            pMac,
            pAd,
            adLength,
            pCiphertext,
            plaintext.length);
        
        if (result == 0)
        {
            recvNonce.counter++;
            outPlaintext = cast(string)plaintext;
            return true;
        }
        else
        {
            Delete(plaintext);
            return false;
        }
    }
    
    bool decodeClientMessage(ubyte[] message, out string outPlaintext)
    {
        return decodeMessage(message, clientEncryptionKey, outPlaintext);
    }
    
    bool decodeServerMessage(ubyte[] message, out string outPlaintext)
    {
        return decodeMessage(message, serverEncryptionKey, outPlaintext);
    }
}
