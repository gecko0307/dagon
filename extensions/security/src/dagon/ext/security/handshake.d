module dagon.ext.security.handshake;

import minicrypto.csprng;
import minicrypto.x25519;
import minicrypto.eddsa;

import dagon.ext.security.server;
import dagon.ext.security.client;
import dagon.ext.security.session;

/*
 * Diffie-Hellman handshake using elliptic curves.
 *
 * 1. When a connection is established, both parties generate pairs of ephemeral 32-byte X25519 keys and random 32-byte one-time numbers.
 * 2. The client sends client_public_key and client_random to the server.
 * 3. The server generates a string {client_public_key, client_random, server_public_key, server_random} and signs it
 *    with its long-term EdDSA/Ed25519 private key to protect against MITM attacks. server_public_key and server_random, along with the signature, 
 *    are sent to the client.
 * 4. The client generates the exact same string and verifies the signature using server's EdDSA/Ed25519 public key (generated beforehand).
 * 5. Both parties calculate the 32-byte shared secret using X25519.
 */

enum ubyte[4] STP_MAGIC = ['s', 't', 'p', '\0'];
enum uint STP_VERSION = 1;

struct STPHandshakeRequest
{
    ubyte[4] stpMagic;
    uint stpVersion;
    ubyte[32] clientEphemeralPublicKey;
    ubyte[32] clientRandom;
}

enum STPHandshakeStatus: uint
{
    Declined = 0,
    Accepted = 1
}

enum STPHandshakeError: uint
{
    None = 0,
    ProtocolMismatch = 1,
    InvalidClientKey = 2,
    ServerBusy = 3,
    Banned = 4
}

struct STPHandshakeResponse
{
    STPHandshakeStatus status;
    STPHandshakeError error;
    /// If status is `Declined`, the following is filled with zeroes.
    ubyte[32] serverEphemeralPublicKey;
    ubyte[32] serverRandom;
    ubyte[64] serverEdDSASignature;
}

bool stpClientHandshake(
    STPSession* clientSession,
    STPHandshakeRequest* request) @nogc nothrow
{
    clientSession.random = cryptoRandomValue!(ubyte[32])();
    clientSession.privateKey = cryptoRandomValue!(ubyte[32])();
    crypto_x25519_public_key(clientSession.publicKey.ptr, clientSession.privateKey.ptr);

    request.stpMagic = STP_MAGIC;
    request.stpVersion = STP_VERSION;
    request.clientEphemeralPublicKey = clientSession.publicKey;
    request.clientRandom = clientSession.random;

    return true;
}

bool stpServerValidateHandshakeRequest(STPHandshakeRequest* request)
{
    return
        request.stpMagic == STP_MAGIC &&
        request.stpVersion == STP_VERSION;
}

bool stpServerHandshake(
    STPServer* server,
    STPSession* serverSession,
    STPHandshakeResponse* response,
    STPHandshakeStatus status = STPHandshakeStatus.Accepted,
    STPHandshakeError error = STPHandshakeError.None) @nogc nothrow
{
    serverSession.random = cryptoRandomValue!(ubyte[32])();
    serverSession.privateKey = cryptoRandomValue!(ubyte[32])();
    crypto_x25519_public_key(serverSession.publicKey.ptr, serverSession.privateKey.ptr);

    response.status = status;
    response.error = error;
    
    if (response.status == STPHandshakeStatus.Accepted)
    {
        response.serverEphemeralPublicKey = serverSession.publicKey;
        response.serverRandom = serverSession.random;
        
        // Concatenate a message to be signed with server's private key:
        // version || clientEphemeralPublicKey || clientRandom || serverEphemeralPublicKey || serverRandom
        ubyte[4 + 32 * 4] signedMessage;
        uint* v = cast(uint*)&signedMessage[0];
        *v = serverSession.stpVersion;
        for (size_t i = 0; i < 32; i++)
            signedMessage[4 + i] = serverSession.peerPublicKey[i];
        for (size_t i = 0; i < 32; i++)
            signedMessage[4 + 32 + i] = serverSession.peerRandom[i];
        for (size_t i = 0; i < 32; i++)
            signedMessage[4 + 32 * 2 + i] = serverSession.publicKey[i];
        for (size_t i = 0; i < 32; i++)
            signedMessage[4 + 32 * 3 + i] = serverSession.random[i];
        
        crypto_eddsa_sign(
            response.serverEdDSASignature.ptr,
            server.privateKey.ptr,
            cast(const(ubyte)*)signedMessage.ptr,
            signedMessage.length);
    }
    
    return true;
}

bool stpClientCheckServerSignature(
    STPClient* client,
    STPSession* clientSession,
    STPHandshakeResponse* response) @nogc nothrow
{
    // Concatenate a message to be signed with server's private key:
    // version + clientPublicKey + clientRandom + serverPublicKey + serverRandom
    ubyte[4 + 32 * 4] signedMessage;
    uint* v = cast(uint*)&signedMessage[0];
    *v = clientSession.stpVersion;
    for (size_t i = 0; i < 32; i++)
        signedMessage[4 + i] = clientSession.publicKey[i];
    for (size_t i = 0; i < 32; i++)
        signedMessage[4 + 32 + i] = clientSession.random[i];
    for (size_t i = 0; i < 32; i++)
        signedMessage[4 + 32 * 2 + i] = clientSession.peerPublicKey[i];
    for (size_t i = 0; i < 32; i++)
        signedMessage[4 + 32 * 3 + i] = clientSession.peerRandom[i];
    
    int verified = crypto_eddsa_check(
        response.serverEdDSASignature.ptr,
        client.serverPublicKey.ptr,
        cast(const(ubyte)*)signedMessage.ptr,
        signedMessage.length);
    
    return (verified == 0);
}
