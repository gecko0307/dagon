enum int ENET_VERSION_PATCH = 18;

pragma(inline, true)
int ENET_VERSION_CREATE(int major, int minor, int patch) 
{
    return (major << 16) | (minor <<8 ) | patch;
}

int ENET_VERSION_GET_MAJOR(int v) { return (v >> 16) & 0xFF; }
int ENET_VERSION_GET_MINOR(int v) { return (v >> 8) & 0xFF; }
int ENET_VERSION_GET_PATCH(int v) { return v & 0xFF; }

