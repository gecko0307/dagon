    /**
     * Initializes ENet globally.
     * Must be called prior to using any functions in ENet.
     * Returns 0 on success, < 0 on failure.
     */
    int enet_initialize();

    /**
     * Initializes ENet globally and supplies user-overridden callbacks.
     * Must be called prior to using any functions in ENet.
     * Do not use enet_initialize() if you use this variant.
     * Make sure the ENetCallbacks structure is zeroed out so that any additional callbacks
     * added in future versions will be properly ignored.
     *
     * Params:
     *  ver   = The constant ENET_VERSION should be supplied so ENet knows which version of ENetCallbacks struct to use.
     *  inits = User-overridden callbacks where any NULL callbacks will use ENet's defaults.
     *
     * Returns:
     *  0 on success, < 0 on failure.
     */
    int enet_initialize_with_callbacks(ENetVersion ver, const(ENetCallbacks)* inits);

