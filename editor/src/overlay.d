/*
 * Interaction overlay for 3D gizmos. 
 */
module overlay;

import core.stdc.stdio: snprintf;

import std.algorithm;

import dlib.core.memory;
import dlib.core.ownership;
import dlib.container.array;
import dlib.math.base;
import dlib.math.vector;
import dlib.math.quaternion;
import dlib.math.matrix;
import dlib.math.transformation;
import dlib.math.utils;

import dagon.core.bindings;
import dagon.core.time;
import dagon.core.event;
import dagon.graphics.drawable;
import dagon.graphics.entity;
import dagon.graphics.camera;
import dagon.graphics.light;
import dagon.graphics.mesh;
import dagon.graphics.state;
import dagon.render.framebuffer;
import dagon.render.view;
import dagon.ui.axes;
import dagon.ui.shaders.gizmo;
import dagon.ext.imgui;

import ui;
import history;

enum GizmoMode
{
    Disabled,
    Translation,
    Rotation,
    Scale,
    SunDirection
}

class InteractionOverlay: EventListener
{
    enum float defaultTranslationSnapIncrement = 1.0f;
    enum float defaultRotationSnapIncrementDegrees = 15.0f;
    enum float defaultScaleSnapIncrement = 0.1f;

    float translationSnapIncrement = defaultTranslationSnapIncrement;
    float rotationSnapIncrementDegrees = defaultRotationSnapIncrementDegrees;
    float scaleSnapIncrement = defaultScaleSnapIncrement;

    EditorUI ui;
    GraphicsState state;
    RenderView view;
    ShapeBoundingBox selectionBoundingBox;
    TranslationAxes translationAxes;
    GizmoLines sunDirectionLines;
    GizmoShader gizmoShader;
    GizmoMode gizmoMode = GizmoMode.Disabled;
    Vector3f gizmoPosition;
    Quaternionf gizmoOrientation;
    Matrix4x4f gizmoTransformation;
    Vector3f selectionBoundingBoxScale;
    Vector3f selectionBoundingBoxBaseScale;
    GizmoLines rotationLines;
    GizmoLines scaleLines;
    FloorGridLines floorGridLines;
    bool visible = true;

    bool draggingGizmo;
    int draggedAxis = -1;
    float dragStartX;
    float dragStartY;
    float dragAxisX;
    float dragAxisY;
    float dragAxisLength;
    float dragStartRotationAngle;
    float previousRotationAngle;
    float accumulatedRotationAngle;
    Vector3f previousRotationVector;
    float previousMouseX;
    float previousMouseY;

    Quaternionf dragStartGizmoOrientation;
    Vector3f dragStartPosition;
    Quaternionf dragStartRotation;
    Vector3f dragStartScale;
    Entity dragEntity;                    // entity being manipulated by the current drag
    TransformSnapshot dragStartSnapshot;  // its transformation before the drag, for undo

    Vector3f dragStartGizmoPosition;
    Vector3f dragAxisDirection;
    float dragStartAxisParam;
    float dragDistance;     // snapped world distance (translation)
    float dragStartAxisOffset; // click offset along the screen axis (scale)

    static immutable ImU32[3] axisLineColors = [0xFF4B4BFF, 0xFF6EE06E, 0xFFFF8B4B];
    
    struct GizmoPoint
    {
        float x;
        float y;
    }

    static immutable Vector3f[3] axes = [
        Vector3f(1.0f, 0.0f, 0.0f),
        Vector3f(0.0f, 1.0f, 0.0f),
        Vector3f(0.0f, 0.0f, 1.0f)
    ];

    this(EventManager eventManager, Owner owner)
    {
        super(eventManager, owner);
        
        state.reset();
        
        view = New!RenderView(0, 0, eventManager.drawableWidth, eventManager.drawableHeight, this);
        
        selectionBoundingBox = New!ShapeBoundingBox(this);
        
        translationAxes = New!TranslationAxes(this);
        sunDirectionLines = New!GizmoLines(GizmoMode.SunDirection, this);
        rotationLines = New!GizmoLines(GizmoMode.Rotation, this);
        scaleLines = New!GizmoLines(GizmoMode.Scale, this);
        floorGridLines = New!FloorGridLines(this);
        
        gizmoShader = New!GizmoShader(this);
        gizmoPosition = Vector3f(0.0f, 0.0f, 0.0f);
        gizmoOrientation = Quaternionf.identity;
        gizmoTransformation = Matrix4x4f.identity;
        
        selectionBoundingBoxScale = Vector3f(1.0f, 1.0f, 1.0f);
        selectionBoundingBoxBaseScale = Vector3f(1.0f, 1.0f, 1.0f);
    }
    
    void activeCamera(Camera camera) @property
    {
        view.camera = camera;
    }

    float pixelRatio() @property
    {
        if (ui && ui.app && ui.app.pixelRatio > 0.0f)
            return ui.app.pixelRatio;
        return 1.0f;
    }

    float gizmoWorldSize()
    {
        if (!view.camera || view.height == 0)
            return 1.0f;

        float cameraDistance = distance(view.camera.positionAbsolute, gizmoPosition);
        float halfFov = degtorad(view.camera.fov * 0.5f);
        return max(cameraDistance * tan(halfFov) * 2.0f * 90.0f * pixelRatio / view.height, 0.01f);
    }

    void updateViewport()
    {
        if (!ui)
            return;

        int w = cast(int)ui.editorViewport.size.x;
        int h = cast(int)ui.editorViewport.size.y;
        int x = cast(int)ui.editorViewport.position.x;
        int y = eventManager.drawableHeight - cast(int)ui.editorViewport.position.y - h;
        if (w > 0 && h > 0)
        {
            view.resize(w, h);
            view.setPosition(x, y);
        }
    }

    bool project(Vector3f point, out GizmoPoint screenPoint)
    {
        if (!view.width || !view.height)
            return false;

        Vector4f clip = Vector4f(point.x, point.y, point.z, 1.0f) *
            view.viewMatrix * view.projectionMatrix;
        if (clip.w <= 0.0f)
            return false;
        
        float pr = pixelRatio;
        float ndcX = clip.x / clip.w;
        float ndcY = clip.y / clip.w;
        screenPoint.x = (view.x + (ndcX + 1.0f) * 0.5f * view.width) / pr;
        screenPoint.y = (eventManager.drawableHeight - (view.y + (ndcY + 1.0f) * 0.5f * view.height)) / pr;
        return true;
    }

    Vector3f worldAxis(int axis)
    {
        return gizmoOrientation.toMatrix4x4.rotate(axes[axis]).normalized;
    }

    bool rotationPlaneVector(int axis, GizmoPoint mouse, out Vector3f radial)
    {
        if (!view.width || !view.height)
            return false;
        
        Vector3f nearPoint, rayDirection;
        if (!mouseRay(mouse, nearPoint, rayDirection))
            return false;
        
        Vector3f normal = worldAxis(axis);
        float denominator = dot(rayDirection, normal);
        if (abs(denominator) < 0.05f)
            return false;

        float distanceAlongRay = dot(gizmoPosition - nearPoint, normal) / denominator;
        if (distanceAlongRay < 0.0f)
            return false;

        Vector3f hit = nearPoint + rayDirection * distanceAlongRay;
        Vector3f offset = hit - gizmoPosition;
        if (offset.length < 0.0001f)
            return false;
        radial = offset.normalized;
        return true;
    }

    bool rotationPlaneAngle(int axis, GizmoPoint mouse, out float angle)
    {
        Vector3f radial;
        if (!rotationPlaneVector(axis, mouse, radial))
            return false;

        Matrix4x4f orientation = gizmoOrientation.toMatrix4x4;
        Vector3f u = orientation.rotate(axes[(axis + 1) % 3]).normalized;
        Vector3f v = orientation.rotate(axes[(axis + 2) % 3]).normalized;
        angle = atan2(dot(radial, v), dot(radial, u));
        return true;
    }

    bool projectedRotationAngle(int axis, GizmoPoint mouse, out float angle)
    {
        float size = gizmoWorldSize();
        Matrix4x4f orientation = gizmoOrientation.toMatrix4x4;
        Vector3f u = orientation.rotate(axes[(axis + 1) % 3]);
        Vector3f v = orientation.rotate(axes[(axis + 2) % 3]);
        float bestDistanceSquared = float.max;
        bool found = false;

        foreach (step; 0 .. 361)
        {
            float candidate = 2.0f * PI * cast(float)step / 360.0f;
            Vector3f offset = (u * cos(candidate) + v * sin(candidate)) * size;
            GizmoPoint point;
            if (!project(gizmoPosition + offset, point))
                continue;
            float dx = point.x - mouse.x;
            float dy = point.y - mouse.y;
            float distanceSquared = dx * dx + dy * dy;
            if (distanceSquared < bestDistanceSquared)
            {
                bestDistanceSquared = distanceSquared;
                angle = candidate;
                found = true;
            }
        }
        return found;
    }

    bool projectedRotationDelta(int axis, float angle, float mouseDeltaX, float mouseDeltaY, out float angleDelta)
    {
        float size = gizmoWorldSize();
        Matrix4x4f orientation = gizmoOrientation.toMatrix4x4;
        Vector3f u = orientation.rotate(axes[(axis + 1) % 3]);
        Vector3f v = orientation.rotate(axes[(axis + 2) % 3]);
        float epsilon = 0.001f;
        Vector3f pointBefore = gizmoPosition +
            (u * cos(angle - epsilon) + v * sin(angle - epsilon)) * size;
        Vector3f pointAfter = gizmoPosition +
            (u * cos(angle + epsilon) + v * sin(angle + epsilon)) * size;
        GizmoPoint screenBefore, screenAfter;
        if (!project(pointBefore, screenBefore) || !project(pointAfter, screenAfter))
            return false;

        float tangentX = (screenAfter.x - screenBefore.x) / (2.0f * epsilon);
        float tangentY = (screenAfter.y - screenBefore.y) / (2.0f * epsilon);
        float tangentLengthSquared = tangentX * tangentX + tangentY * tangentY;
        if (tangentLengthSquared < 0.25f)
            return false;

        angleDelta = clamp(
            (mouseDeltaX * tangentX + mouseDeltaY * tangentY) / tangentLengthSquared,
            -0.5f,
            0.5f);
        return true;
    }

    bool axisScreenPoints(int axis, out GizmoPoint center, out GizmoPoint end)
    {
        float size = gizmoWorldSize();
        return project(gizmoPosition, center) &&
            project(gizmoPosition + worldAxis(axis) * size, end);
    }

    float segmentDistance(GizmoPoint p, GizmoPoint a, GizmoPoint b)
    {
        float dx = b.x - a.x;
        float dy = b.y - a.y;
        float lengthSquared = dx * dx + dy * dy;
        if (lengthSquared <= 0.0001f)
            return sqrt((p.x - a.x) * (p.x - a.x) + (p.y - a.y) * (p.y - a.y));

        float t = ((p.x - a.x) * dx + (p.y - a.y) * dy) / lengthSquared;
        t = clamp(t, 0.0f, 1.0f);
        float px = a.x + t * dx;
        float py = a.y + t * dy;
        return sqrt((p.x - px) * (p.x - px) + (p.y - py) * (p.y - py));
    }

    float snappedValue(float value, float increment)
    {
        if (!ui.io.KeyCtrl)
            return value;
        return round(value / max(increment, 0.0001f)) * max(increment, 0.0001f);
    }

    // `label` must be a zero-terminated string
    void drawHelperLabel(ImDrawList* drawList, GizmoPoint position, const(char)* label)
    {
        ImVec2 textPosition = ImVec2(position.x + 14.0f, position.y + 10.0f);
        ImDrawList_AddText(
            drawList,
            ImVec2(textPosition.x + 1.0f, textPosition.y + 1.0f),
            0xFF000000,
            label);
        ImDrawList_AddText(drawList, textPosition, 0xFFF0F0F0, label);
    }

    void drawHelperArrow(ImDrawList* drawList, GizmoPoint start, GizmoPoint end, ImU32 color)
    {
        float dx = end.x - start.x;
        float dy = end.y - start.y;
        float length = sqrt(dx * dx + dy * dy);
        if (length < 0.001f)
            return;

        float directionX = dx / length;
        float directionY = dy / length;
        float baseX = end.x - directionX * 10.0f;
        float baseY = end.y - directionY * 10.0f;
        float perpendicularX = -directionY * 4.0f;
        float perpendicularY = directionX * 4.0f;

        ImVec2 lineStart = ImVec2(start.x, start.y);
        ImVec2 lineEnd = ImVec2(end.x, end.y);
        ImDrawList_AddLine(drawList, lineStart, lineEnd, 0xCC000000, 4.0f);
        ImDrawList_AddLine(drawList, lineStart, lineEnd, color, 2.0f);
        ImDrawList_AddTriangleFilled(
            drawList,
            lineEnd,
            ImVec2(baseX + perpendicularX, baseY + perpendicularY),
            ImVec2(baseX - perpendicularX, baseY - perpendicularY),
            color);
    }

    void drawDragHelper()
    {
        if (!draggingGizmo || !ui)
            return;

        ImDrawList* drawList = igGetForegroundDrawList();
        
        float pr = pixelRatio;
        ImVec2 clipMin = ImVec2(
            ui.editorViewport.position.x / pr,
            ui.editorViewport.position.y / pr);
        ImVec2 clipMax = ImVec2(
            clipMin.x + ui.editorViewport.size.x / pr,
            clipMin.y + ui.editorViewport.size.y / pr);
        
        ImDrawList_PushClipRect(drawList, clipMin, clipMax, true);

        if (gizmoMode == GizmoMode.Translation || gizmoMode == GizmoMode.Scale)
        {
            GizmoPoint mouse = GizmoPoint(ui.io.MousePos.x, ui.io.MousePos.y);
            GizmoPoint dot;
            bool hasDot = false;
            char[32] label = 0; // stack buffer, no GC allocations

            if (gizmoMode == GizmoMode.Translation)
            {
                drawAxisLine(drawList, dragStartGizmoPosition, dragAxisDirection, axisLineColors[draggedAxis]);
                hasDot = project(dragStartGizmoPosition + dragAxisDirection * dragDistance, dot);
                snprintf(label.ptr, label.length, "%.2f", cast(double)dragDistance);
            }
            else
            {
                GizmoPoint center;
                if (project(gizmoPosition, center))
                {
                    drawAxisLine(drawList, gizmoPosition, dragAxisDirection, axisLineColors[draggedAxis]);

                    float dirX = dragAxisX / dragAxisLength;
                    float dirY = dragAxisY / dragAxisLength;
                    float rawDelta = (ui.io.MousePos.x - dragStartX) * dirX + (ui.io.MousePos.y - dragStartY) * dirY;
                    float scaleDelta = snappedValue(rawDelta / 100.0f, scaleSnapIncrement);
                    float value = max(0.001f, dragStartScale[draggedAxis] + scaleDelta);
                    float along = dragStartAxisOffset + (value - dragStartScale[draggedAxis]) * 100.0f;
                    dot = GizmoPoint(center.x + dirX * along, center.y + dirY * along);
                    hasDot = true;
                    snprintf(label.ptr, label.length, "%.2f", cast(double)value);
                }
            }

            if (hasDot)
                ImDrawList_AddCircleFilled(drawList, ImVec2(dot.x, dot.y), 5.0f, 0xFFF0F0F0, 16);
            drawHelperLabel(drawList, mouse, label.ptr);
        }
        else if (gizmoMode == GizmoMode.Rotation)
        {
            float angleDelta = snappedValue(
                accumulatedRotationAngle,
                degtorad(rotationSnapIncrementDegrees));
            angleDelta = clamp(angleDelta, -2.0f * PI, 2.0f * PI);
            float currentAngle = dragStartRotationAngle + angleDelta;
            float size = gizmoWorldSize();
            Matrix4x4f orientation = dragStartGizmoOrientation.toMatrix4x4;
            Vector3f u = orientation.rotate(axes[(draggedAxis + 1) % 3]);
            Vector3f v = orientation.rotate(axes[(draggedAxis + 2) % 3]);
            int segments = max(1, cast(int)(abs(angleDelta) * 24.0f / PI));
            GizmoPoint previous;
            bool hasPrevious = false;

            foreach (step; 0 .. segments + 1)
            {
                float angle = dragStartRotationAngle +
                    angleDelta * cast(float)step / cast(float)segments;
                Vector3f ringPoint = gizmoPosition +
                    (u * cos(angle) + v * sin(angle)) * size;
                GizmoPoint current;
                if (project(ringPoint, current))
                {
                    if (hasPrevious)
                        ImDrawList_AddLine(
                            drawList,
                            ImVec2(previous.x, previous.y),
                            ImVec2(current.x, current.y),
                            0xFF55DDFF,
                            2.0f);
                    previous = current;
                    hasPrevious = true;
                }
                else
                {
                    hasPrevious = false;
                }
            }

            GizmoPoint center, tangentPoint;
            float direction = angleDelta < 0.0f ? -1.0f : 1.0f;
            Vector3f tangentPosition = gizmoPosition +
                (u * cos(currentAngle + direction * 0.05f) +
                v * sin(currentAngle + direction * 0.05f)) * size;
            if (project(gizmoPosition, center) && project(tangentPosition, tangentPoint))
            {
                float tangentX = tangentPoint.x - center.x;
                float tangentY = tangentPoint.y - center.y;
                float tangentLength = sqrt(tangentX * tangentX + tangentY * tangentY);
                if (tangentLength > 0.001f)
                {
                    GizmoPoint cursor = GizmoPoint(ui.io.MousePos.x, ui.io.MousePos.y);
                    GizmoPoint arrowStart = GizmoPoint(
                        cursor.x - tangentX / tangentLength * 24.0f,
                        cursor.y - tangentY / tangentLength * 24.0f);
                    ImDrawList_AddLine(
                        drawList,
                        ImVec2(center.x, center.y),
                        ImVec2(cursor.x, cursor.y),
                        0x99F0F0F0,
                        1.0f);
                    drawHelperArrow(drawList, arrowStart, cursor, 0xFFF0F0F0);
                    char[32] angleLabel = 0; // stack buffer, no GC allocations
                    snprintf(angleLabel.ptr, angleLabel.length, "%.1f deg",
                        cast(double)(angleDelta * 180.0f / PI));
                    drawHelperLabel(drawList, cursor, angleLabel.ptr);
                }
            }
        }

        ImDrawList_PopClipRect(drawList);
    }

    int pickAxis(GizmoPoint mouse, out GizmoPoint center, out GizmoPoint axisEnd)
    {
        if (!project(gizmoPosition, center))
            return -1;

        int picked = -1;
        float bestDistance = 11.0f;
        if (gizmoMode == GizmoMode.Rotation)
        {
            float size = gizmoWorldSize();
            foreach (axis; 0 .. 3)
            {
                Vector3f u = axes[(axis + 1) % 3];
                Vector3f v = axes[(axis + 2) % 3];
                GizmoPoint previous;
                bool hasPrevious = false;
                foreach (step; 0 .. 49)
                {
                    float angle = 2.0f * PI * cast(float)step / 48.0f;
                    Vector3f localPoint = (u * cos(angle) + v * sin(angle)) * size;
                    GizmoPoint current;
                    if (project(gizmoPosition + gizmoOrientation.toMatrix4x4.rotate(localPoint), current))
                    {
                        if (hasPrevious)
                        {
                            float d = segmentDistance(mouse, previous, current);
                            if (d < bestDistance)
                            {
                                bestDistance = d;
                                picked = cast(int)axis;
                            }
                        }
                        previous = current;
                        hasPrevious = true;
                    }
                    else
                    {
                        hasPrevious = false;
                    }
                }
            }
            axisEnd = center;
            return picked;
        }

        foreach (axis; 0 .. 3)
        {
            GizmoPoint axisCenter, end;
            if (!axisScreenPoints(cast(int)axis, axisCenter, end))
                continue;
            float d = segmentDistance(mouse, axisCenter, end);
            if (d < bestDistance)
            {
                bestDistance = d;
                picked = cast(int)axis;
                axisEnd = end;
            }
        }
        return picked;
    }

    void setDraggingGizmo(bool dragging)
    {
        draggingGizmo = dragging;
        if (ui && ui.scene.freeview)
            ui.scene.freeview.active = ui.scene.focused && !dragging;
    }

    // Ends the current drag (if any) and records it in the undo history
    void finishGizmoDrag()
    {
        if (draggingGizmo && dragEntity && ui)
        {
            string commandName = "Transform";
            if (gizmoMode == GizmoMode.Translation)
                commandName = "Move";
            else if (gizmoMode == GizmoMode.Rotation)
                commandName = "Rotate";
            else if (gizmoMode == GizmoMode.Scale)
                commandName = "Scale";
            ui.editor.history.pushTransform(commandName, dragEntity, dragStartSnapshot);
        }
        dragEntity = null;
        setDraggingGizmo(false);
        draggedAxis = -1;
    }

    void handleGizmoInput()
    {
        updateViewport();
        if (!ui || !ui.editor.selectedEntity || gizmoMode == GizmoMode.Disabled)
        {
            finishGizmoDrag();
            return;
        }

        if (igIsMouseClicked(ImGuiMouseButton.Left) && !ui.io.WantCaptureMouse)
        {
            GizmoPoint mouse = GizmoPoint(ui.io.MousePos.x, ui.io.MousePos.y);
            
            float pr = pixelRatio;
            float viewportLeft = ui.editorViewport.position.x / pr;
            float viewportTop = ui.editorViewport.position.y / pr;
            float viewportRight = viewportLeft + ui.editorViewport.size.x / pr;
            float viewportBottom = viewportTop + ui.editorViewport.size.y / pr;
            if (mouse.x >= viewportLeft && mouse.x <= viewportRight &&
                mouse.y >= viewportTop && mouse.y <= viewportBottom)
            {
                GizmoPoint center, axisEnd;
                draggedAxis = pickAxis(mouse, center, axisEnd);
                bool hasRotationStart = false;
                if (draggedAxis >= 0 && gizmoMode == GizmoMode.Rotation)
                {
                    hasRotationStart = rotationPlaneVector(
                        draggedAxis, mouse, previousRotationVector);
                    if (hasRotationStart)
                        rotationPlaneAngle(draggedAxis, mouse, dragStartRotationAngle);
                    else
                        hasRotationStart = projectedRotationAngle(
                            draggedAxis, mouse, dragStartRotationAngle);
                    if (hasRotationStart && !rotationPlaneVector(
                        draggedAxis, mouse, previousRotationVector))
                    {
                        Matrix4x4f orientation = gizmoOrientation.toMatrix4x4;
                        Vector3f u = orientation.rotate(axes[(draggedAxis + 1) % 3]);
                        Vector3f v = orientation.rotate(axes[(draggedAxis + 2) % 3]);
                        previousRotationVector =
                            u * cos(dragStartRotationAngle) + v * sin(dragStartRotationAngle);
                    }
                    if (!hasRotationStart)
                        draggedAxis = -1;
                }

                if (draggedAxis >= 0 && gizmoMode == GizmoMode.Translation &&
                    !axisParameter(mouse, gizmoPosition, worldAxis(draggedAxis), dragStartAxisParam))
                    draggedAxis = -1;
                
                if (draggedAxis >= 0)
                {
                    setDraggingGizmo(true);
                    dragStartX = mouse.x;
                    dragStartY = mouse.y;
                    dragStartPosition = ui.editor.selectedEntity.position;
                    dragStartRotation = ui.editor.selectedEntity.rotation;
                    dragStartScale = ui.editor.selectedEntity.scaling;
                    dragEntity = ui.editor.selectedEntity;
                    dragStartSnapshot = TransformSnapshot.capture(dragEntity);
                    dragStartGizmoOrientation = gizmoOrientation;
                    previousRotationAngle = dragStartRotationAngle;
                    accumulatedRotationAngle = 0.0f;
                    previousMouseX = mouse.x;
                    previousMouseY = mouse.y;
                    dragAxisX = axisEnd.x - center.x;
                    dragAxisY = axisEnd.y - center.y;
                    dragAxisLength = sqrt(dragAxisX * dragAxisX + dragAxisY * dragAxisY);
                    if (dragAxisLength < 1.0f)
                        dragAxisLength = 1.0f;
                    dragStartGizmoPosition = gizmoPosition;
                    dragAxisDirection = worldAxis(draggedAxis);
                    dragDistance = 0.0f;
                    dragStartAxisOffset = ((mouse.x - center.x) * dragAxisX + (mouse.y - center.y) * dragAxisY) / dragAxisLength;
                }
            }
        }

        if (!draggingGizmo)
            return;

        if (!igIsMouseDown(ImGuiMouseButton.Left))
        {
            finishGizmoDrag();
            return;
        }

        GizmoPoint mouse = GizmoPoint(ui.io.MousePos.x, ui.io.MousePos.y);
        float dx = mouse.x - dragStartX;
        float dy = mouse.y - dragStartY;
        Entity entity = ui.editor.selectedEntity;

        if (gizmoMode == GizmoMode.Translation)
        {
            float t;
            if (axisParameter(mouse, dragStartGizmoPosition, dragAxisDirection, t))
                dragDistance = snappedValue(t - dragStartAxisParam, translationSnapIncrement);

            Vector3f worldDelta = dragAxisDirection * dragDistance;
            Matrix4x4f parentInverse = Matrix4x4f.identity;
            if (entity.parent)
                parentInverse = entity.parent.invAbsoluteTransformation;
            else if (entity.world)
                parentInverse = entity.world.rootInvTransformation;
            entity.position = dragStartPosition + parentInverse.rotate(worldDelta);
        }
        else if (gizmoMode == GizmoMode.Scale)
        {
            float projectedDelta = (dx * dragAxisX + dy * dragAxisY) / dragAxisLength;
            float scaleDelta = snappedValue(projectedDelta / 100.0f, scaleSnapIncrement);
            float value = max(0.001f, dragStartScale[draggedAxis] + scaleDelta);
            entity.scaling[draggedAxis] = value;
            selectionBoundingBoxScale[draggedAxis] =
                selectionBoundingBoxBaseScale[draggedAxis] * abs(value);
        }
        else if (gizmoMode == GizmoMode.Rotation)
        {
            gizmoOrientation = dragStartGizmoOrientation;
            float angleDelta = 0.0f;
            Vector3f currentRotationVector;
            if (rotationPlaneVector(draggedAxis, mouse, currentRotationVector))
            {
                Vector3f axis = worldAxis(draggedAxis);
                angleDelta = atan2(
                    dot(axis, cross(previousRotationVector, currentRotationVector)),
                    dot(previousRotationVector, currentRotationVector));
                previousRotationVector = currentRotationVector;
                previousRotationAngle += angleDelta;
                accumulatedRotationAngle += angleDelta;
            }
            else if (projectedRotationDelta(
                draggedAxis,
                previousRotationAngle,
                mouse.x - previousMouseX,
                mouse.y - previousMouseY,
                angleDelta))
            {
                previousRotationAngle += angleDelta;
                accumulatedRotationAngle += angleDelta;
                Matrix4x4f orientation = dragStartGizmoOrientation.toMatrix4x4;
                Vector3f u = orientation.rotate(axes[(draggedAxis + 1) % 3]);
                Vector3f v = orientation.rotate(axes[(draggedAxis + 2) % 3]);
                previousRotationVector =
                    u * cos(previousRotationAngle) + v * sin(previousRotationAngle);
            }
            previousMouseX = mouse.x;
            previousMouseY = mouse.y;
            float rotationDelta = snappedValue(
                accumulatedRotationAngle,
                degtorad(rotationSnapIncrementDegrees));
            entity.rotation = dragStartRotation *
                rotationQuaternion!float(axes[draggedAxis], rotationDelta);
        }

        gizmoPosition = entity.positionAbsolute;
        gizmoOrientation = entity.rotationAbsolute;
        drawDragHelper();
    }
    
    void update(Time t)
    {
        processEvents();
    }
    
    void render()
    {
        if (!visible)
            return;
        
        if (gizmoMode == GizmoMode.Disabled)
            return;
        
        updateViewport();
        
        glScissor(view.x, view.y, view.width, view.height);
        glViewport(view.x, view.y, view.width, view.height);
        
        Matrix4x4f viewMatrix = view.viewMatrix;
        
        glDisable(GL_DEPTH_TEST);
        glDisable(GL_CULL_FACE);
        glEnable(GL_BLEND);
        glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
        
        gizmoShader.bind();
        
        float size = gizmoWorldSize();
        Matrix4x4f orientationMatrix = gizmoOrientation.toMatrix4x4;
        gizmoTransformation = translationMatrix(gizmoPosition) *
            orientationMatrix * scaleMatrix(Vector3f(size, size, size));

        Light selectedLight = ui && ui.editor.selectedEntity
            ? cast(Light)ui.editor.selectedEntity
            : null;
        bool selectedSun = selectedLight && selectedLight.type == LightType.Sun;
        if (selectedSun)
        {
            state.modelViewMatrix = viewMatrix * gizmoTransformation;
            state.projectionMatrix = view.projectionMatrix;
            gizmoShader.bindParameters(&state);
            sunDirectionLines.render(&state);
            gizmoShader.unbindParameters(&state);
        }
        else if (ui.scene.showSelectedEntityBoundingBox)
        {
            state.modelViewMatrix = viewMatrix *
                (translationMatrix(gizmoPosition) * orientationMatrix * scaleMatrix(selectionBoundingBoxScale));
            state.projectionMatrix = view.projectionMatrix;
            gizmoShader.bindParameters(&state);
            selectionBoundingBox.render(&state);
            gizmoShader.unbindParameters(&state);
        }
        
        state.modelViewMatrix = viewMatrix * gizmoTransformation;
        state.projectionMatrix = view.projectionMatrix;
        gizmoShader.bindParameters(&state);
        if (gizmoMode == GizmoMode.Translation)
            translationAxes.render(&state);
        else if (gizmoMode == GizmoMode.Rotation)
            rotationLines.render(&state);
        else if (gizmoMode == GizmoMode.Scale)
            scaleLines.render(&state);
        gizmoShader.unbindParameters(&state);
        
        gizmoShader.unbind();
        
        glDisable(GL_BLEND);
        glEnable(GL_DEPTH_TEST);
        glEnable(GL_CULL_FACE);
    }

    void renderFloorGrid()
    {
        if (!ui || !ui.scene.floorGridEnabled ||
            !ui.scene.app.renderer.outputBuffer)
            return;

        updateViewport();
        if (view.width <= 0 || view.height <= 0)
            return;

        Framebuffer outputBuffer = ui.scene.app.renderer.outputBuffer;
        GLint previousFramebuffer;
        GLint previousProgram;
        GLint previousVertexArray;
        GLint[4] previousScissorBox;
        GLint[4] previousViewport;
        GLint previousBlendSrcRgb;
        GLint previousBlendDstRgb;
        GLint previousBlendSrcAlpha;
        GLint previousBlendDstAlpha;
        GLboolean previousDepthTest = glIsEnabled(GL_DEPTH_TEST);
        GLboolean previousCullFace = glIsEnabled(GL_CULL_FACE);
        GLboolean previousBlend = glIsEnabled(GL_BLEND);
        GLboolean previousScissor = glIsEnabled(GL_SCISSOR_TEST);
        GLboolean previousDepthMask;

        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &previousFramebuffer);
        glGetIntegerv(GL_CURRENT_PROGRAM, &previousProgram);
        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &previousVertexArray);
        glGetIntegerv(GL_SCISSOR_BOX, previousScissorBox.ptr);
        glGetIntegerv(GL_VIEWPORT, previousViewport.ptr);
        glGetIntegerv(GL_BLEND_SRC_RGB, &previousBlendSrcRgb);
        glGetIntegerv(GL_BLEND_DST_RGB, &previousBlendDstRgb);
        glGetIntegerv(GL_BLEND_SRC_ALPHA, &previousBlendSrcAlpha);
        glGetIntegerv(GL_BLEND_DST_ALPHA, &previousBlendDstAlpha);
        glGetBooleanv(GL_DEPTH_WRITEMASK, &previousDepthMask);

        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, outputBuffer.framebuffer);
        glViewport(0, 0, outputBuffer.width, outputBuffer.height);
        glScissor(0, 0, outputBuffer.width, outputBuffer.height);
        glEnable(GL_SCISSOR_TEST);
        glEnable(GL_DEPTH_TEST);
        glDepthMask(GL_FALSE);
        glDisable(GL_CULL_FACE);
        glEnable(GL_BLEND);
        glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA,
            GL_ONE, GL_ONE_MINUS_SRC_ALPHA);

        floorGridLines.update(
            ui.scene.floorGridSpacing,
            ui.scene.floorGridExtent);
        state.modelViewMatrix = view.viewMatrix;
        state.projectionMatrix = view.projectionMatrix;
        gizmoShader.bind();
        gizmoShader.bindParameters(&state);
        floorGridLines.render(&state);
        gizmoShader.unbindParameters(&state);
        gizmoShader.unbind();

        glBindVertexArray(previousVertexArray);
        glUseProgram(previousProgram);
        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, previousFramebuffer);
        glViewport(previousViewport[0], previousViewport[1],
            previousViewport[2], previousViewport[3]);
        glScissor(previousScissorBox[0], previousScissorBox[1],
            previousScissorBox[2], previousScissorBox[3]);
        if (previousDepthTest) glEnable(GL_DEPTH_TEST);
        else glDisable(GL_DEPTH_TEST);
        if (previousCullFace) glEnable(GL_CULL_FACE);
        else glDisable(GL_CULL_FACE);
        if (previousBlend) glEnable(GL_BLEND);
        else glDisable(GL_BLEND);
        if (previousScissor) glEnable(GL_SCISSOR_TEST);
        else glDisable(GL_SCISSOR_TEST);
        glDepthMask(previousDepthMask);
        glBlendFuncSeparate(previousBlendSrcRgb, previousBlendDstRgb,
            previousBlendSrcAlpha, previousBlendDstAlpha);
    }

    bool mouseRay(GizmoPoint mouse, out Vector3f origin, out Vector3f direction)
    {
        if (!view.width || !view.height)
            return false;

        float pr = pixelRatio;
        float mouseX = mouse.x * pr;
        float mouseY = mouse.y * pr;
        float ndcX = 2.0f * (mouseX - view.x) / view.width - 1.0f;
        float viewportTop = eventManager.drawableHeight - view.y - view.height;
        float ndcY = 1.0f - 2.0f * (mouseY - viewportTop) / view.height;
        
        Matrix4x4f inv = (view.projectionMatrix * view.viewMatrix).inverse;
        Vector4f n = Vector4f(ndcX, ndcY, -1.0f, 1.0f) * inv;
        Vector4f f = Vector4f(ndcX, ndcY,  1.0f, 1.0f) * inv;
        if (abs(n.w) < 0.000001f || abs(f.w) < 0.000001f)
            return false;

        origin = Vector3f(n.x / n.w, n.y / n.w, n.z / n.w);
        Vector3f farPoint = Vector3f(f.x / f.w, f.y / f.w, f.z / f.w);
        direction = (farPoint - origin).normalized;
        return true;
    }

    // Parameter t of the point on line (axisPoint + axisDir * t) closest to the mouse ray
    bool axisParameter(GizmoPoint mouse, Vector3f axisPoint, Vector3f axisDir, out float t)
    {
        Vector3f origin, ray;
        if (!mouseRay(mouse, origin, ray))
            return false;

        float b = dot(axisDir, ray);
        float denom = 1.0f - b * b;
        if (denom < 0.001f) // axis nearly parallel to the view ray
            return false;

        Vector3f w = axisPoint - origin;
        t = (b * dot(ray, w) - dot(axisDir, w)) / denom;
        return true;
    }

    // Projects a world segment, clipping it against the camera near plane
    bool projectSegmentClipped(Vector3f a, Vector3f b, out GizmoPoint sa, out GizmoPoint sb)
    {
        if (!view.width || !view.height)
            return false;

        Vector4f ca = Vector4f(a.x, a.y, a.z, 1.0f) * view.viewMatrix * view.projectionMatrix;
        Vector4f cb = Vector4f(b.x, b.y, b.z, 1.0f) * view.viewMatrix * view.projectionMatrix;
        enum float nearW = 0.01f;
        if (ca.w < nearW && cb.w < nearW)
            return false;

        if (ca.w < nearW)
        {
            float k = (nearW - ca.w) / (cb.w - ca.w);
            ca = Vector4f(ca.x + (cb.x - ca.x) * k, ca.y + (cb.y - ca.y) * k,
                        ca.z + (cb.z - ca.z) * k, nearW);
        }
        else if (cb.w < nearW)
        {
            float k = (nearW - cb.w) / (ca.w - cb.w);
            cb = Vector4f(cb.x + (ca.x - cb.x) * k, cb.y + (ca.y - cb.y) * k,
                        cb.z + (ca.z - cb.z) * k, nearW);
        }
        
        float pr = pixelRatio;
        sa.x = (view.x + (ca.x / ca.w + 1.0f) * 0.5f * view.width) / pr;
        sa.y = (eventManager.drawableHeight - (view.y + (ca.y / ca.w + 1.0f) * 0.5f * view.height)) / pr;
        sb.x = (view.x + (cb.x / cb.w + 1.0f) * 0.5f * view.width) / pr;
        sb.y = (eventManager.drawableHeight - (view.y + (cb.y / cb.w + 1.0f) * 0.5f * view.height)) / pr;
        return true;
    }

    void drawAxisLine(ImDrawList* drawList, Vector3f point, Vector3f direction, ImU32 color)
    {
        enum float extent = 10000.0f;
        GizmoPoint a, b;
        if (!projectSegmentClipped(point - direction * extent, point + direction * extent, a, b))
            return;
        ImDrawList_AddLine(drawList, ImVec2(a.x, a.y), ImVec2(b.x, b.y), 0xCC000000, 3.0f);
        ImDrawList_AddLine(drawList, ImVec2(a.x, a.y), ImVec2(b.x, b.y), color, 1.5f);
    }
}

class GizmoLines: Owner, Drawable
{
    Array!Vector3f vertices;
    Array!Vector4f colors;
    GLuint vertexBuffer;
    GLuint colorBuffer;
    GLuint vertexArray;
    bool dataReady;

    this(GizmoMode mode, Owner owner)
    {
        super(owner);

        immutable Vector4f[3] axisColors = [
            Vector4f(1.0f, 0.0f, 0.0f, 1.0f),
            Vector4f(0.0f, 1.0f, 0.0f, 1.0f),
            Vector4f(0.0f, 0.0f, 1.0f, 1.0f)
        ];

        if (mode == GizmoMode.Rotation)
        {
            foreach (axis; 0 .. 3)
            {
                Vector3f u = InteractionOverlay.axes[(axis + 1) % 3];
                Vector3f v = InteractionOverlay.axes[(axis + 2) % 3];
                foreach (step; 0 .. 48)
                {
                    float angle0 = 2.0f * PI * cast(float)step / 48.0f;
                    float angle1 = 2.0f * PI * cast(float)(step + 1) / 48.0f;
                    appendLine(
                        u * cos(angle0) + v * sin(angle0),
                        u * cos(angle1) + v * sin(angle1),
                        axisColors[axis]);
                }
            }
        }
        else if (mode == GizmoMode.SunDirection)
        {
            Vector4f color = Vector4f(1.0f, 0.85f, 0.2f, 1.0f);
            appendLine(
                Vector3f(0.0f, 0.0f, 0.0f),
                Vector3f(0.0f, 0.0f, -1.0f),
                color);
            appendLine(
                Vector3f(0.0f, 0.0f, -1.0f),
                Vector3f(0.12f, 0.0f, -0.78f),
                color);
            appendLine(
                Vector3f(0.0f, 0.0f, -1.0f),
                Vector3f(-0.12f, 0.0f, -0.78f),
                color);
            appendLine(
                Vector3f(0.0f, 0.0f, -1.0f),
                Vector3f(0.0f, 0.12f, -0.78f),
                color);
            appendLine(
                Vector3f(0.0f, 0.0f, -1.0f),
                Vector3f(0.0f, -0.12f, -0.78f),
                color);
        }
        else
        {
            foreach (axis; 0 .. 3)
            {
                Vector3f direction = InteractionOverlay.axes[axis];
                appendLine(Vector3f(0.0f, 0.0f, 0.0f), direction, axisColors[axis]);
                Vector3f crossAxis = InteractionOverlay.axes[(axis + 1) % 3] * 0.08f;
                appendLine(direction - crossAxis, direction + crossAxis, axisColors[axis]);
            }
        }
    }

    ~this()
    {
        vertices.free();
        colors.free();
        // TODO: release OpenGL buffers
    }

    void appendLine(Vector3f a, Vector3f b, Vector4f color)
    {
        vertices.append(a);
        vertices.append(b);
        colors.append(color);
        colors.append(color);
    }

    void render(GraphicsState* state)
    {
        if (!dataReady)
        {
            glGenBuffers(1, &vertexBuffer);
            glBindBuffer(GL_ARRAY_BUFFER, vertexBuffer);
            glBufferData(GL_ARRAY_BUFFER, vertices.length * float.sizeof * 3, vertices.data.ptr, GL_STATIC_DRAW);

            glGenBuffers(1, &colorBuffer);
            glBindBuffer(GL_ARRAY_BUFFER, colorBuffer);
            glBufferData(GL_ARRAY_BUFFER, colors.length * float.sizeof * 4, colors.data.ptr, GL_STATIC_DRAW);

            glGenVertexArrays(1, &vertexArray);
            glBindVertexArray(vertexArray);
            glEnableVertexAttribArray(VertexAttrib.Vertices);
            glBindBuffer(GL_ARRAY_BUFFER, vertexBuffer);
            glVertexAttribPointer(VertexAttrib.Vertices, 3, GL_FLOAT, GL_FALSE, 0, null);
            glEnableVertexAttribArray(VertexAttrib.Colors);
            glBindBuffer(GL_ARRAY_BUFFER, colorBuffer);
            glVertexAttribPointer(VertexAttrib.Colors, 4, GL_FLOAT, GL_FALSE, 0, null);
            glBindVertexArray(0);
            dataReady = true;
        }

        glBindVertexArray(vertexArray);
        glDrawArrays(GL_LINES, 0, cast(int)vertices.length);
        glBindVertexArray(0);
    }
}

private class FloorGridLines: Owner, Drawable
{
    Vector3f[] vertices;
    Vector4f[] colors;
    GLuint vertexBuffer;
    GLuint colorBuffer;
    GLuint vertexArray;
    float currentSpacing = -1.0f;
    float currentExtent = -1.0f;

    this(Owner owner)
    {
        super(owner);
        GLint previousArrayBuffer;
        GLint previousVertexArray;
        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &previousArrayBuffer);
        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &previousVertexArray);
        glGenBuffers(1, &vertexBuffer);
        glGenBuffers(1, &colorBuffer);
        glGenVertexArrays(1, &vertexArray);
        glBindVertexArray(vertexArray);

        glEnableVertexAttribArray(VertexAttrib.Vertices);
        glBindBuffer(GL_ARRAY_BUFFER, vertexBuffer);
        glVertexAttribPointer(VertexAttrib.Vertices, 3, GL_FLOAT, GL_FALSE, 0, null);

        glEnableVertexAttribArray(VertexAttrib.Colors);
        glBindBuffer(GL_ARRAY_BUFFER, colorBuffer);
        glVertexAttribPointer(VertexAttrib.Colors, 4, GL_FLOAT, GL_FALSE, 0, null);
        glBindVertexArray(previousVertexArray);
        glBindBuffer(GL_ARRAY_BUFFER, previousArrayBuffer);
    }

    ~this()
    {
        if (glIsVertexArray(vertexArray))
            glDeleteVertexArrays(1, &vertexArray);
        if (glIsBuffer(vertexBuffer))
            glDeleteBuffers(1, &vertexBuffer);
        if (glIsBuffer(colorBuffer))
            glDeleteBuffers(1, &colorBuffer);
    }

    void update(float spacing, float extent)
    {
        if (spacing == currentSpacing && extent == currentExtent)
            return;

        GLint previousArrayBuffer;
        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &previousArrayBuffer);
        currentSpacing = spacing;
        currentExtent = extent;
        vertices.length = 0;
        colors.length = 0;
        int count = cast(int)(extent / spacing);
        foreach (i; -count .. count + 1)
        {
            float offset = i * spacing;
            Vector4f color = i == 0
                ? Vector4f(0.75f, 0.25f, 0.25f, 0.65f)
                : Vector4f(0.42f, 0.45f, 0.49f, 0.38f);
            appendLine(
                Vector3f(-extent, 0.0f, offset),
                Vector3f(extent, 0.0f, offset),
                color);

            color = i == 0
                ? Vector4f(0.25f, 0.35f, 0.8f, 0.65f)
                : Vector4f(0.42f, 0.45f, 0.49f, 0.38f);
            appendLine(
                Vector3f(offset, 0.0f, -extent),
                Vector3f(offset, 0.0f, extent),
                color);
        }

        glBindBuffer(GL_ARRAY_BUFFER, vertexBuffer);
        glBufferData(GL_ARRAY_BUFFER, vertices.length * Vector3f.sizeof,
            vertices.ptr, GL_DYNAMIC_DRAW);
        glBindBuffer(GL_ARRAY_BUFFER, colorBuffer);
        glBufferData(GL_ARRAY_BUFFER, colors.length * Vector4f.sizeof,
            colors.ptr, GL_DYNAMIC_DRAW);
        glBindBuffer(GL_ARRAY_BUFFER, previousArrayBuffer);
    }

    private void appendLine(Vector3f a, Vector3f b, Vector4f color)
    {
        vertices ~= a;
        vertices ~= b;
        colors ~= color;
        colors ~= color;
    }

    void render(GraphicsState*)
    {
        glBindVertexArray(vertexArray);
        glDrawArrays(GL_LINES, 0, cast(int)vertices.length);
        glBindVertexArray(0);
    }
}

