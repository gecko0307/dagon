module assetbrowser2;

import core.stdc.string: strlen;

import std.file;
import std.path;
import std.process;

import dlib.core.memory;
import dlib.core.ownership;
import dlib.text.str;

import dagon.core.logger;
import dagon.graphics.texture;
import dagon.ext.imgui;

import ui;
import assetdir;
import textbuffer;

struct BrowseContext
{
    AssetEntry openedEntry;
    AssetEntry renamedEntry;
    AssetEntry deletedEntry;
}

class AssetBrowser: Owner
{
    bool active = false;
    EditorUI ui;
    AssetDirectory dir;
    AssetEntry selectedEntry;
    AssetEntry renamedEntry;
    AssetEntry deletedEntry;
    bool tableView = true;
    char[256] assetNameBuffer;
    TextBuffer!512 assetBrowserMessage;
    
    this(EditorUI ui)
    {
        super(ui);
        this.ui = ui;
        dir = New!AssetDirectory(ui.app.vfs.stdfs, ui.app.path, this);
        if (active)
            dir.scan();
    }
    
    ~this()
    {
    }
    
    // Set a new absolute root directory and return the browser to its root.
    // Relative paths inside the browser are always kept separate from this path.
    void reset(string assetRootDir, bool activate)
    {
        dir.resetDir(assetRootDir);
        active = activate;
        if (active)
            dir.scan();
        selectedEntry = null;
        assetNameBuffer[] = 0;
        assetBrowserMessage.clear();
    }
    
    void openFolder(AssetEntry folder)
    {
        dir.open(folder.name.toString);
        selectedEntry = null;
        assetBrowserMessage.clear();
    }
    
    void openFile(AssetEntry file)
    {
        openWithDefaultApp(file.absPath.toString);
    }
    
    bool isValidAssetName(string name)
    {
        if (name.length == 0 || name == "." || name == "..")
            return false;
        foreach (c; name)
        {
            if (c < 32 || c == '/' || c == '\\' || c == ':' ||
                c == '<' || c == '>' || c == '"' || c == '|' ||
                c == '?' || c == '*' || c == '\0')
                return false;
        }
        return name[$ - 1] != ' ' && name[$ - 1] != '.';
    }
    
    void setAssetNameBuffer(string name)
    {
        assetNameBuffer[] = 0;
        size_t length = name.length < assetNameBuffer.length - 1
            ? name.length
            : assetNameBuffer.length - 1;
        assetNameBuffer[0..length] = name[0..length];
    }

    /// Slice into assetNameBuffer, valid until the buffer is edited.
    string assetNameInput()
    {
        return cast(string)assetNameBuffer[0..strlen(assetNameBuffer.ptr)];
    }

    void createFolder()
    {
        string name = assetNameInput();
        if (!isValidAssetName(name))
        {
            assetBrowserMessage.set("Enter a valid folder name.");
            return;
        }
        
        String path = dir.getPath(name);
        string pathStr = path.toString;
        if (exists(pathStr))
        {
            path.free();
            assetBrowserMessage.set("An item with that name already exists.");
            return;
        }
        try
        {
            mkdir(pathStr);
            path.free();
            dir.scan();
            assetBrowserMessage.set("Created folder: ");
            assetBrowserMessage.append(name);
        }
        catch(Exception e)
        {
            path.free();
            assetBrowserMessage.set("Unable to create folder: ");
            assetBrowserMessage.append(e.msg);
        }
    }
    
    void renameEntry(AssetEntry renameTarget)
    {
        string newName = assetNameInput();
        if (!isValidAssetName(newName))
        {
            assetBrowserMessage.set("Enter a valid name.");
            return;
        }
        
        String destination = dir.getPath(newName);
        string destinationStr = destination.toString;

        String source = renameTarget.absPath.toString;
        string sourceStr = source.toString;

        if (exists(destinationStr))
        {
            destination.free();
            assetBrowserMessage.set("An item with that name already exists.");
            return;
        }
        try
        {
            .rename(sourceStr, destinationStr);
            destination.free();
            dir.scan();
            assetBrowserMessage.set("Renamed to: ");
            assetBrowserMessage.append(newName);
        }
        catch(Exception e)
        {
            destination.free();
            assetBrowserMessage.set("Unable to rename item: ");
            assetBrowserMessage.append(e.msg);
        }
    }
    
    void deleteEntry(AssetEntry deleteTarget)
    {
        auto path = deleteTarget.absPath.toString;
        try
        {
            if (deleteTarget.isDirectory)
                .rmdir(path);
            else
                .remove(path);
            assetBrowserMessage.set("Deleted: ");
            assetBrowserMessage.append(deleteTarget.name.toString);
            dir.scan();
        }
        catch(Exception e)
        {
            assetBrowserMessage.set("Unable to delete item: ");
            assetBrowserMessage.append(e.msg);
        }
    }
    
    void render()
    {
        if (igBegin("Asset Browser", null, ImGuiWindowFlags.NoCollapse))
        {
            if (!active)
            {
                igEnd();
                return;
            }
            
            if (igButton("Up", ImVec2(0, 0)))
            {
                selectedEntry = null;
                dir.up();
            }
            
            igSameLine();
            
            if (igButton("Refresh"))
            {
                selectedEntry = null;
                dir.scan();
            }
            
            igSameLine();
            
            if (igButton("New Folder"))
            {
                setAssetNameBuffer("");
                igOpenPopup("Create asset folder");
            }
            
            /*
            // TODO
            igSameLine();
            igSetNextItemWidth(200.0f);
            igInputText("Filter##AssetSearch", assetSearchBuffer.ptr, assetSearchBuffer.length);
            */
            
            igSameLine();
            if (igRadioButton("Grid", !tableView))
                tableView = false;
            igSameLine();
            if (igRadioButton("Table", tableView))
                tableView = true;
            
            BrowseContext ctx;
            
            if (tableView)
                renderTable(ctx);
            else
                renderGrid(ctx);
            
            if (ctx.openedEntry)
            {
                if (ctx.openedEntry.isDirectory)
                    openFolder(ctx.openedEntry);
                else
                    openFile(ctx.openedEntry);
            }
            
            if (ctx.renamedEntry)
            {
                renamedEntry = ctx.renamedEntry;
                igOpenPopup("Rename asset");
            }
            
            if (ctx.deletedEntry)
            {
                deletedEntry = ctx.deletedEntry;
                igOpenPopup("Confirm asset delete");
            }
            
            if (assetBrowserMessage.length != 0)
                igTextWrapped("%s", assetBrowserMessage.cstr);
            
            if (igBeginPopup("Create asset folder", ImGuiWindowFlags.AlwaysAutoResize))
            {
                igInputText("Folder name", assetNameBuffer.ptr, assetNameBuffer.length);
                if (igButton("Create"))
                {
                    createFolder();
                    igCloseCurrentPopup();
                }
                igSameLine();
                if (igButton("Cancel"))
                    igCloseCurrentPopup();
                igEndPopup();
            }
            
            if (igBeginPopup("Rename asset", ImGuiWindowFlags.AlwaysAutoResize))
            {
                igInputText("New name", assetNameBuffer.ptr, assetNameBuffer.length);
                if (igButton("Rename"))
                {
                    renameEntry(renamedEntry);
                    igCloseCurrentPopup();
                }
                igSameLine();
                if (igButton("Cancel"))
                {
                    renamedEntry = null;
                    igCloseCurrentPopup();
                }
                igEndPopup();
            }
            
            if (igBeginPopupModal("Confirm asset delete", null, ImGuiWindowFlags.AlwaysAutoResize))
            {
                igText("Delete \"%s\"?", deletedEntry.name.ptr);
                if (deletedEntry.isDirectory)
                    igTextDisabled("Only empty folders can be deleted.");
                if (igButton("Delete"))
                {
                    deleteEntry(deletedEntry);
                    igCloseCurrentPopup();
                }
                igSameLine();
                if (igButton("Cancel"))
                {
                    deletedEntry = null;
                    igCloseCurrentPopup();
                }
                igEndPopup();
            }
            
            igEnd();
        }
    }
    
    protected size_t renderTable(ref BrowseContext ctx)
    {
        size_t visibleEntries;
        if (!igBeginTable("Asset entries", 3,
            ImGuiTableFlags.Borders | ImGuiTableFlags.RowBg |
            ImGuiTableFlags.Resizable | ImGuiTableFlags.SizingStretchProp))
            return visibleEntries;
        
        igTableSetupColumn("Name", ImGuiTableColumnFlags.WidthStretch);
        igTableSetupColumn("Type", ImGuiTableColumnFlags.WidthFixed, 110.0f);
        igTableSetupColumn("Size", ImGuiTableColumnFlags.WidthFixed, 100.0f);
        igTableHeadersRow();
        
        ctx.openedEntry = null;
        ctx.renamedEntry = null;
        
        foreach(size_t i, AssetEntry entry; dir.contentsSorted)
        {
            visibleEntries++;
            
            igPushID_Int(cast(uint)i);
            bool selected = entry is selectedEntry;
            Texture entryIcon = getEntryIcon(entry);
            igTableNextRow();
            
            igTableSetColumnIndex(0);
            
            if (entryIcon)
            {
                igImage(cast(void*)entryIcon.texture, ImVec2(18.0f, 18.0f));
                igSameLine();
            }
            
            bool pressed = igSelectable(
                entry.name.ptr,
                selected,
                ImGuiSelectableFlags.SpanAllColumns);
            if (pressed)
            {
                selectedEntry = entry;
                selected = true;
            }
            
            if (selected && igIsItemHovered() &&
                igIsMouseDoubleClicked(ImGuiMouseButton.Left))
            {
                ctx.openedEntry = entry;
            }
            
            if (igBeginDragDropSource())
            {
                igSetDragDropPayload("ASSET", entry.absPath.ptr, entry.absPath.length);
                igText("%s", entry.localPath.ptr);
                igEndDragDropSource();
            }
            
            if (igBeginPopupContextItem("Asset item context"))
            {
                if (igMenuItem("Open"))
                {
                    ctx.openedEntry = entry;
                }
                if (igMenuItem("Rename"))
                {
                    ctx.renamedEntry = entry;
                }
                if (igMenuItem("Delete"))
                {
                    ctx.deletedEntry = entry;
                }
                igEndPopup();
            }
            
            igTableSetColumnIndex(1);
            if (entry.isDirectory)
                igTextUnformatted("Folder");
            else
            {
                const(char)[] ext = extension(entry.name.toString);
                if (ext.length != 0)
                    igText("%.*s", cast(int)ext.length, ext.ptr);
                else
                    igTextUnformatted("File");
            }
            
            igTableSetColumnIndex(2);
            //if (entry.isDirectory)
                igTextUnformatted("-");
            //else
            //    igText("%s", entry.sizeLabel.ptr);

            igPopID();
        }
        
        igEndTable();
        return visibleEntries;
    }
    
    protected void renderGrid(ref BrowseContext ctx)
    {
        // TODO
    }
    
    static char asciiLower(char c)
    {
        return (c >= 'A' && c <= 'Z') ? cast(char)(c + 32) : c;
    }
    
    static bool hasExtension(const(char)[] filename, const(char)[][] extensions)
    {
        const(char)[] ext = extension(filename);
        foreach (candidate; extensions)
        {
            if (ext.length != candidate.length)
                continue;
            bool matches = true;
            foreach (i, c; ext)
            {
                if (asciiLower(c) != candidate[i])
                {
                    matches = false;
                    break;
                }
            }
            if (matches)
                return true;
        }
        return false;
    }
    
    static const(char)[][] extImages = [
        ".bmp", ".gif", ".jpg", ".jpeg", ".lbm", ".pcx", ".png",
        ".pnm", ".ppm", ".pgm", ".pbm", ".qoi", ".tga", ".xcf", ".xpm",
        ".tif", ".tiff", ".webp", ".avif", ".jxl", ".svg", ".ico",
        ".dds", ".hdr", ".ktx", ".ktx2"
    ];
    static const(char)[][] extModels = [
        ".obj", ".3ds", ".gltf", ".glb", ".dae", ".fbx",
        ".stl", ".ply", ".iqm", ".3mf", ".bvh", ".md2", ".md3",
        ".md5mesh", ".ms3d", ".off", ".x3d"
    ];
    static const(char)[][] extArchives = [
        ".zip", ".7z", ".rar", ".tar", ".gz", ".bz2", ".xz",
        ".tgz", ".tbz", ".tbz2", ".txz", ".zst", ".lz", ".lz4",
        ".cab", ".iso"
    ];
    static const(char)[][] extAudio = [
        ".wav", ".mp3", ".ogg", ".oga", ".flac", ".opus", ".aiff",
        ".aif", ".aifc", ".mid", ".midi", ".mod", ".xm", ".it",
        ".s3m", ".wma", ".m4a", ".aac", ".weba"
    ];
    static const(char)[][] extBlender = [".blend", ".blend1"];
    static const(char)[][] extJson = [".json"];
    static const(char)[][] extPython = [
        ".py", ".pyc", ".pyw", ".pyd", ".pyo"
    ];
    static const(char)[][] extBinary = [
        ".exe", ".dll", ".bin", ".o"
    ];
    static const(char)[][] extAPK = [".apk"];
    static const(char)[][] extBash = [".sh"];
    static const(char)[][] extTorrent = [".torrent"];

    Texture getEntryIcon(AssetEntry entry)
    {
        if (entry.isDirectory)
            return ui.iconFolder;
        
        if (hasExtension(entry.name, extImages))
        {
            if (!entry.thumbnailValid)
            {
                /*
                // TODO
                if (ui.thumbnailGenerator)
                    entry.thumbnail = ui.thumbnailGenerator.getThumbnail(entry.absPath.toString);
                entry.thumbnailValid = true;
                */
            }
            return entry.thumbnail ? entry.thumbnail : ui.iconImage;
        }
        
        if (hasExtension(entry.name, extModels))
            return ui.iconModel;
        if (hasExtension(entry.name, extArchives))
            return ui.iconArchive;
        if (hasExtension(entry.name, extAudio))
            return ui.iconAudio;
        if (hasExtension(entry.name, extBlender))
            return ui.iconBlend;
        if (hasExtension(entry.name, extJson))
            return ui.iconJson;
        if (hasExtension(entry.name, extPython))
            return ui.iconPython;
        if (hasExtension(entry.name, extBinary))
            return ui.iconBinary;
        if (hasExtension(entry.name, extAPK))
            return ui.iconAPK;
        if (hasExtension(entry.name, extBash))
            return ui.iconBash;
        if (hasExtension(entry.name, extTorrent))
            return ui.iconTorrent;
        
        return ui.iconFile;
    }
}

void openWithDefaultApp(const(char)[] filePath)
{
    version(Windows)
    {
        // On Windows, 'start' is a shell built-in, so we need to route it through cmd.exe
        const(char)[][] command = ["cmd.exe", "/c", "start", "", filePath];
    }
    version(OSX)
    {
        const(char)[][] command = ["open", filePath];
    }
    version(linux)
    {
        const(char)[][] command = ["xdg-open", filePath];
    }

    try
    {
        logInfo("Opening \"", filePath, "\"...");
        auto pid = spawnProcess(command);
    }
    catch(Exception e)
    {
        logError("Failed to open \"", filePath, "\": ", e.msg);
    }
}

