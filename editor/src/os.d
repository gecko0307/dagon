module os;

import std.process;

version(Windows)
{
    import core.sys.windows.windows: SW_SHOWNORMAL;
    import core.sys.windows.shellapi: ShellExecuteW;
    import std.utf: toUTF16z;
}

import dagon.core.logger;
import dagon.core.dialogs;

void openWithDefaultApp(const(char)[] filePath)
{
    version(Windows)
    {
        // On Windows, 'start' is a shell built-in, so we need to route it through cmd.exe
        const(char)[][] command = ["cmd.exe", "/c", "start", "", filePath];
    }
    version(OSX)
    {
        const(char)[][] command = ["open", filePath];
    }
    version(linux)
    {
        const(char)[][] command = ["xdg-open", filePath];
    }

    try
    {
        logInfo("Opening \"", filePath, "\"...");
        auto pid = spawnProcess(command);
    }
    catch(Exception e)
    {
        logError("Failed to open \"", filePath, "\": ", e.msg);
    }
}

void browse(string url)
{
    // TODO: don't use GC
    
    version(Windows)
    {
        auto result = ShellExecuteW(null, "open".toUTF16z, url.toUTF16z, null, null, SW_SHOWNORMAL);
        if (cast(size_t)result <= 32)
            showMessage("Unable to open website", "Could not open " ~ url ~ " in the default browser.");
    }
    else version(linux)
    {
        try
        {
            auto result = execute(["xdg-open", url]);
            if (result.status != 0)
                showMessage("Unable to open website", "Could not open " ~ url ~ " in the default browser.");
        }
        catch(ProcessException e)
        {
            showMessage("Unable to open website", e.msg);
        }
    }
    else version(OSX)
    {
        try
        {
            auto result = execute(["open", url]);
            if (result.status != 0)
                showMessage("Unable to open website", "Could not open " ~ url ~ " in the default browser.");
        }
        catch(ProcessException e)
        {
            showMessage("Unable to open website", e.msg);
        }
    }
    else
    {
        showMessage("Unable to open website", "Opening links is not supported on this platform.");
    }
}
