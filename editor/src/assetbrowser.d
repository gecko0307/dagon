void openWithDefaultApp(const(char)[] filePath)
{
    version(Windows)
    {
        // On Windows, 'start' is a shell built-in, so we need to route it through cmd.exe
        const(char)[][] command = ["cmd.exe", "/c", "start", "", filePath];
    }
    version(OSX)
    {
        const(char)[][] command = ["open", filePath];
    }
    version(linux)
    {
        const(char)[][] command = ["xdg-open", filePath];
    }

    try
    {
        logInfo("Opening \"", filePath, "\"...");
        auto pid = spawnProcess(command);
    }
    catch(Exception e)
    {
        logError("Failed to open \"", filePath, "\": ", e.msg);
    }
}

// Fixed-capacity, always zero-terminated text buffer.
struct TextBuffer(size_t capacity)
{
    char[capacity] data = 0;
    size_t length;

    void clear()
    {
        length = 0;
        data[0] = 0;
    }

    void set(const(char)[] text)
    {
        clear();
        append(text);
    }

    void append(const(char)[] text)
    {
        size_t count = min(text.length, capacity - 1 - length);
        data[length .. length + count] = text[0 .. count];
        length += count;
        data[length] = 0;
    }

    void truncate(size_t newLength)
    {
        if (newLength < length)
        {
            length = newLength;
            data[length] = 0;
        }
    }

    const(char)[] slice() const { return data[0 .. length]; }
    const(char)* cstr() const { return data.ptr; }
}

struct AssetEntry
{
    char[] nameZ; // "name\0", manually allocated
    char[] pathZ; // "assets/dir/name\0", manually allocated
    bool isDirectory;
    ulong size;
    char[32] sizeLabel = 0;
    Texture thumbnail;
    bool thumbnailChecked;

    @property const(char)[] name() { return nameZ[0..$ - 1]; }
    @property const(char)[] path() { return pathZ[0..$ - 1]; }
}

class AssetBrowser: Owner
{
    bool active = false;
    
    EditorUI ui;

    TextBuffer!2048 assetRoot; // absolute filesystem path
    TextBuffer!512 assetDirectory; // relative to assetRoot, always '/' separated
    TextBuffer!4096 selectedAssetPath;
    TextBuffer!512 assetBrowserMessage;
    TextBuffer!256 assetRenameTarget;
    TextBuffer!256 assetDeleteTarget;
    bool assetDeleteTargetIsDirectory;
    Array!AssetEntry assetEntries;
    char[256] assetSearchBuffer;
    char[256] assetNameBuffer;
    bool tableView;

    this(EditorUI ui)
    {
        super(ui);
        this.ui = ui;
        reset(ui.app.directory, false);
    }

    ~this()
    {
        freeAssetEntries();
        assetEntries.free();
    }

    // Set a new absolute root directory and return the browser to its root.
    // Relative paths inside the browser are always kept separate from this path.
    void reset(string assetRootDir, bool activate)
    {
        assetSearchBuffer[] = 0;
        assetNameBuffer[] = 0;
        assetDirectory.clear();
        selectedAssetPath.clear();
        assetRenameTarget.clear();
        assetDeleteTarget.clear();
        assetBrowserMessage.clear();

        try
        {
            assetRoot.set(absolutePath(assetRootDir));
        }
        catch (Exception e)
        {
            assetRoot.clear();
            assetBrowserMessage.set("Invalid asset root: ");
            assetBrowserMessage.append(e.msg);
            freeAssetEntries();
            assetEntries.resize(0, AssetEntry.init);
            return;
        }

        active = activate;

        refreshAssetEntries();
    }

    static char[] allocZ(const(char)[] text)
    {
        auto result = New!(char[])(text.length + 1);
        result[0..text.length] = text[];
        result[text.length] = 0;
        return result;
    }

    static void put(char[] dest, ref size_t pos, const(char)[] text)
    {
        dest[pos..pos + text.length] = text[];
        pos += text.length;
    }

    static bool hasPathSeparator(const(char)[] path)
    {
        if (path.length == 0)
            return false;
        char c = path[$ - 1];
        return c == '/' || c == '\\';
    }

    // Build an absolute filesystem path from the root, current directory
    // and optional item name.
    TextBuffer!4096 filesystemPath(const(char)[] name = null)
    {
        TextBuffer!4096 path;
        path.set(assetRoot.slice);

        if (assetDirectory.length != 0)
        {
            if (!hasPathSeparator(path.slice))
                path.append("/");
            path.append(assetDirectory.slice);
        }

        if (name.length != 0)
        {
            if (!hasPathSeparator(path.slice))
                path.append("/");
            path.append(name);
        }

        return path;
    }

    // Entry paths are absolute, just like filesystemPath() results.
    char[] allocEntryPath(const(char)[] name)
    {
        auto path = filesystemPath(name);
        return allocZ(path.slice);
    }

    void freeAssetEntries()
    {
        foreach (entry; assetEntries)
        {
            auto nameZ = entry.nameZ;
            auto pathZ = entry.pathZ;
            Delete(nameZ);
            Delete(pathZ);
        }
    }

    void selectAssetByName(const(char)[] name)
    {
        auto path = filesystemPath(name);
        selectedAssetPath.set(path.slice);
    }

    void refreshAssetEntries()
    {
        if (!active)
            return;
        
        freeAssetEntries();
        assetEntries.resize(0, AssetEntry.init);
        assetBrowserMessage.clear();

        auto directory = filesystemPath();
        if (!exists(directory.slice))
        {
            assetBrowserMessage.set("Asset folder not found: ");
            assetBrowserMessage.append(directory.slice);
            return;
        }

        try
        {
            foreach (dirEntry; dirEntries(cast(string)directory.slice, SpanMode.shallow))
            {
                if (dirEntry.isSymlink)
                    continue;

                const(char)[] name = baseName(stripRight(dirEntry.name, "\\/"));
                AssetEntry entry;
                entry.nameZ = allocZ(name);
                entry.pathZ = allocEntryPath(name);
                entry.isDirectory = dirEntry.isDir;
                entry.size = dirEntry.size;
                snprintf(entry.sizeLabel.ptr, entry.sizeLabel.length, "%llu bytes", entry.size);
                assetEntries.append(entry);
            }
            sort!((a, b) {
                if (a.isDirectory != b.isDirectory)
                    return a.isDirectory;
                return a.name < b.name;
            })(assetEntries.data);
        }
        catch (Exception e)
        {
            assetBrowserMessage.set("Unable to read folder: ");
            assetBrowserMessage.append(e.msg);
        }
    }

    bool isValidAssetName(const(char)[] name)
    {
        if (name.length == 0 || name == "." || name == "..")
            return false;
        foreach (c; name)
        {
            if (c < 32 || c == '/' || c == '\\' || c == ':' ||
                c == '<' || c == '>' || c == '"' || c == '|' ||
                c == '?' || c == '*' || c == '\0')
                return false;
        }
        return name[$ - 1] != ' ' && name[$ - 1] != '.';
    }

    void setAssetNameBuffer(const(char)[] name)
    {
        assetNameBuffer[] = 0;
        size_t length = name.length < assetNameBuffer.length - 1
            ? name.length
            : assetNameBuffer.length - 1;
        assetNameBuffer[0..length] = name[0 .. length];
    }

    // Slice into assetNameBuffer, valid until the buffer is edited
    const(char)[] assetNameInput()
    {
        return assetNameBuffer[0 .. strlen(assetNameBuffer.ptr)];
    }

    void createAssetFolder()
    {
        const(char)[] name = assetNameInput();
        if (!isValidAssetName(name))
        {
            assetBrowserMessage.set("Enter a valid folder name.");
            return;
        }

        auto path = filesystemPath(name);
        if (exists(path.slice))
        {
            assetBrowserMessage.set("An item with that name already exists.");
            return;
        }
        try
        {
            mkdir(path.slice);
            refreshAssetEntries();
            if (assetBrowserMessage.length == 0)
            {
                assetBrowserMessage.set("Created folder: ");
                assetBrowserMessage.append(name);
            }
        }
        catch (Exception e)
        {
            assetBrowserMessage.set("Unable to create folder: ");
            assetBrowserMessage.append(e.msg);
        }
    }

    void renameAsset()
    {
        const(char)[] name = assetNameInput();
        if (!isValidAssetName(name))
        {
            assetBrowserMessage.set("Enter a valid name.");
            return;
        }

        auto destination = filesystemPath(name);
        auto source = filesystemPath(assetRenameTarget.slice);
        if (exists(destination.slice))
        {
            assetBrowserMessage.set("An item with that name already exists.");
            return;
        }
        try
        {
            rename(source.slice, destination.slice);
            selectAssetByName(name);
            refreshAssetEntries();
            if (assetBrowserMessage.length == 0)
            {
                assetBrowserMessage.set("Renamed to: ");
                assetBrowserMessage.append(name);
            }
        }
        catch (Exception e)
        {
            assetBrowserMessage.set("Unable to rename item: ");
            assetBrowserMessage.append(e.msg);
        }
    }

    void deleteAsset()
    {
        auto path = filesystemPath(assetDeleteTarget.slice);
        try
        {
            if (assetDeleteTargetIsDirectory)
                rmdir(path.slice);
            else
                remove(path.slice);
            selectedAssetPath.clear();
            TextBuffer!256 deletedName;
            deletedName.set(assetDeleteTarget.slice);
            assetDeleteTarget.clear();
            refreshAssetEntries();
            if (assetBrowserMessage.length == 0)
            {
                assetBrowserMessage.set("Deleted: ");
                assetBrowserMessage.append(deletedName.slice);
            }
        }
        catch (Exception e)
        {
            assetDeleteTarget.clear();
            assetBrowserMessage.set("Unable to delete item (folders must be empty): ");
            assetBrowserMessage.append(e.msg);
        }
    }

    static char asciiLower(char c)
    {
        return (c >= 'A' && c <= 'Z') ? cast(char)(c + 32) : c;
    }

    static bool containsIgnoreCase(const(char)[] haystack, const(char)[] needle)
    {
        if (needle.length == 0)
            return true;
        if (needle.length > haystack.length)
            return false;
        foreach (i; 0..haystack.length - needle.length + 1)
        {
            size_t j = 0;
            while (j < needle.length && asciiLower(haystack[i + j]) == asciiLower(needle[j]))
                j++;
            if (j == needle.length)
                return true;
        }
        return false;
    }

    static bool hasExtension(const(char)[] filename, const(char)[][] extensions)
    {
        const(char)[] ext = extension(filename);
        foreach (candidate; extensions)
        {
            if (ext.length != candidate.length)
                continue;
            bool matches = true;
            foreach (i, c; ext)
            {
                if (asciiLower(c) != candidate[i])
                {
                    matches = false;
                    break;
                }
            }
            if (matches)
                return true;
        }
        return false;
    }

    static const(char)[][] extModels = [
        ".obj", ".3ds", ".gltf", ".glb", ".dae", ".fbx",
        ".stl", ".ply", ".iqm", ".3mf", ".bvh", ".md2", ".md3",
        ".md5mesh", ".ms3d", ".off", ".x3d"
    ];
    static const(char)[][] extArchives = [
        ".zip", ".7z", ".rar", ".tar", ".gz", ".bz2", ".xz",
        ".tgz", ".tbz", ".tbz2", ".txz", ".zst", ".lz", ".lz4",
        ".cab", ".iso"
    ];
    static const(char)[][] extAudio = [
        ".wav", ".mp3", ".ogg", ".oga", ".flac", ".opus", ".aiff",
        ".aif", ".aifc", ".mid", ".midi", ".mod", ".xm", ".it",
        ".s3m", ".wma", ".m4a", ".aac", ".weba"
    ];
    static const(char)[][] extBlender = [".blend", ".blend1"];
    static const(char)[][] extJson = [".json"];
    static const(char)[][] extPython = [
        ".py", ".pyc", ".pyw", ".pyd", ".pyo"
    ];
    static const(char)[][] extBinary = [
        ".exe", ".dll", ".bin", ".o"
    ];

    Texture getEntryIcon(ref AssetEntry entry)
    {
        if (entry.isDirectory)
            return ui.iconFolder;
        if (hasExtension(entry.name, extModels))
            return ui.iconModel;
        if (hasExtension(entry.name, extArchives))
            return ui.iconArchive;
        if (hasExtension(entry.name, extAudio))
            return ui.iconAudio;
        if (hasExtension(entry.name, extBlender))
            return ui.iconBlend;
        if (hasExtension(entry.name, extJson))
            return ui.iconJson;
        if (hasExtension(entry.name, extPython))
            return ui.iconPython;
        if (hasExtension(entry.name, extBinary))
            return ui.iconBinary;

        if (!entry.thumbnailChecked)
        {
            if (ui.thumbnailGenerator)
                entry.thumbnail = ui.thumbnailGenerator.getThumbnail(entry.path);
            entry.thumbnailChecked = true;
        }
        return entry.thumbnail ? entry.thumbnail : ui.iconFile;
    }

    size_t renderTableEntries(
        const(char)[] search,
        ref bool openRenamePopup,
        ref bool openDeletePopup,
        ref bool navigateToDirectory,
        ref size_t requestedDirectoryIndex)
    {
        size_t visibleEntries;
        if (!igBeginTable("Asset entries", 3,
            ImGuiTableFlags.Borders | ImGuiTableFlags.RowBg |
            ImGuiTableFlags.Resizable | ImGuiTableFlags.SizingStretchProp))
            return visibleEntries;

        igTableSetupColumn("Name", ImGuiTableColumnFlags.WidthStretch);
        igTableSetupColumn("Type", ImGuiTableColumnFlags.WidthFixed, 110.0f);
        igTableSetupColumn("Size", ImGuiTableColumnFlags.WidthFixed, 100.0f);
        igTableHeadersRow();

        foreach (i, ref entry; assetEntries)
        {
            if (!containsIgnoreCase(entry.name, search))
                continue;
            visibleEntries++;

            igPushID_Int(cast(uint)i);
            bool selected = selectedAssetPath.slice == entry.path;
            Texture entryIcon = getEntryIcon(entry);
            igTableNextRow();

            igTableSetColumnIndex(0);
            if (entryIcon)
            {
                igImage(cast(void*)entryIcon.texture, ImVec2(18.0f, 18.0f));
                igSameLine();
            }
            bool pressed = igSelectable(
                entry.nameZ.ptr,
                selected,
                ImGuiSelectableFlags.SpanAllColumns);
            if (pressed)
            {
                selectedAssetPath.set(entry.path);
                selected = true;
            }

            if (selected && igIsItemHovered() &&
                igIsMouseDoubleClicked(ImGuiMouseButton.Left))
            {
                if (entry.isDirectory)
                {
                    requestedDirectoryIndex = i;
                    navigateToDirectory = true;
                }
                else
                {
                    openWithDefaultApp(entry.path);
                }
            }

            if (igBeginDragDropSource())
            {
                igSetDragDropPayload("ASSET", entry.pathZ.ptr, entry.pathZ.length);
                igText("%s", entry.pathZ.ptr);
                igEndDragDropSource();
            }

            if (igBeginPopupContextItem("Asset item context"))
            {
                if (!entry.isDirectory)
                if (igMenuItem("Open"))
                {
                    openWithDefaultApp(entry.path);
                }
                if (igMenuItem("Rename"))
                {
                    assetRenameTarget.set(entry.name);
                    setAssetNameBuffer(entry.name);
                    openRenamePopup = true;
                }
                if (igMenuItem("Delete"))
                {
                    assetDeleteTarget.set(entry.name);
                    assetDeleteTargetIsDirectory = entry.isDirectory;
                    openDeletePopup = true;
                }
                igEndPopup();
            }

            igTableSetColumnIndex(1);
            if (entry.isDirectory)
                igTextUnformatted("Folder");
            else
            {
                const(char)[] ext = extension(entry.name);
                if (ext.length != 0)
                    igText("%.*s", cast(int)ext.length, ext.ptr);
                else
                    igTextUnformatted("File");
            }

            igTableSetColumnIndex(2);
            if (entry.isDirectory)
                igTextUnformatted("-");
            else
                igText("%s", entry.sizeLabel.ptr);

            igPopID();
        }

        igEndTable();
        return visibleEntries;
    }

    void render()
    {
        if (igBegin("Asset Browser", null, ImGuiWindowFlags.NoCollapse))
        {
            if (!active)
            {
                igEnd();
                return;
            }
            
            if (igButton("Up", ImVec2(0, 0)) && assetDirectory.length != 0)
            {
                ptrdiff_t slash = lastIndexOf(assetDirectory.slice, '/');
                assetDirectory.truncate(slash < 0 ? 0 : cast(size_t)slash);
                selectedAssetPath.clear();
                refreshAssetEntries();
            }
            igSameLine();
            if (igButton("Refresh"))
                refreshAssetEntries();
            igSameLine();
            if (igButton("New Folder"))
            {
                setAssetNameBuffer("");
                igOpenPopup("Create asset folder");
            }
            igSameLine();
            igSetNextItemWidth(200.0f);
            igInputText("Filter##AssetSearch", assetSearchBuffer.ptr, assetSearchBuffer.length);
            igSameLine();
            if (igRadioButton("Grid", !tableView))
                tableView = false;
            igSameLine();
            if (igRadioButton("Table", tableView))
                tableView = true;

            if (assetDirectory.length != 0)
                igText("%s/%s", assetRoot.cstr, assetDirectory.cstr);
            else
                igText("assets");

            if (igBeginPopup("Create asset folder", ImGuiWindowFlags.AlwaysAutoResize))
            {
                igInputText("Folder name", assetNameBuffer.ptr, assetNameBuffer.length);
                if (igButton("Create"))
                {
                    createAssetFolder();
                    igCloseCurrentPopup();
                }
                igSameLine();
                if (igButton("Cancel"))
                    igCloseCurrentPopup();
                igEndPopup();
            }

            const(char)[] search = assetSearchBuffer[0 .. strlen(assetSearchBuffer.ptr)];
            bool openRenamePopup;
            bool openDeletePopup;
            bool navigateToDirectory;
            size_t requestedDirectoryIndex;
            size_t visibleEntries;
            if (tableView)
            {
                visibleEntries = renderTableEntries(
                    search,
                    openRenamePopup,
                    openDeletePopup,
                    navigateToDirectory,
                    requestedDirectoryIndex);
            }
            else
            {
                ImVec2 size;
                igGetWindowSize(&size);
                float winWidth = size.x;
                int columns = cast(int)(winWidth / 128.0f);
                columns = columns < 1 ? 1 : columns;
                igColumns(columns, null, false);

                foreach (i, ref entry; assetEntries)
                {
                    if (!containsIgnoreCase(entry.name, search))
                        continue;
                    visibleEntries++;

                    igPushID_Int(cast(uint)i);

                    igBeginGroup();
                    bool selected = selectedAssetPath.slice == entry.path;
                    Texture entryIcon = getEntryIcon(entry);
                    if (entryIcon)
                    {
                        ImVec2 thumbnailSize = ImVec2(100, 100);
                        if (entryIcon.width > 0 && entryIcon.height > 0)
                        {
                            float aspectRatio = cast(float)entryIcon.width /
                                cast(float)entryIcon.height;
                            if (aspectRatio > 1.0f)
                                thumbnailSize.y = 100.0f / aspectRatio;
                            else
                                thumbnailSize.x = 100.0f * aspectRatio;
                        }
                        ImVec4 buttonBackground = ImVec4(0.10f, 0.10f, 0.10f, 1.0f);
                        ImGuiID btnId = igGetID_Str(entry.nameZ.ptr);
                        bool pressed = igImageButtonEx(btnId, cast(void*)entryIcon.texture,
                            thumbnailSize, ImVec2(0, 0), ImVec2(1, 1),
                            ImVec2(0, 0), buttonBackground,
                            ImVec4(1, 1, 1, 1));
                        if (pressed)
                            selectedAssetPath.set(entry.path);
                        if (selected || pressed)
                        {
                            ImVec2 rectMin;
                            ImVec2 rectMax;
                            igGetItemRectMin(&rectMin);
                            igGetItemRectMax(&rectMax);
                            ImDrawList_AddRect(
                                igGetWindowDrawList(),
                                rectMin,
                                rectMax,
                                igGetColorU32(ImVec4(0.90f, 0.45f, 0.00f, 1.0f)),
                                0.0f,
                                ImDrawFlags.None,
                                2.0f);
                        }
                    }
                    else
                    {
                        ImVec4 buttonColor = selected
                            ? ImVec4(0.20f, 0.42f, 0.68f, 1.0f)
                            : ImVec4(0.26f, 0.59f, 0.98f, 0.40f);
                        igPushStyleColor(ImGuiCol.Button, buttonColor);
                        if (igButton(entry.isDirectory ? "[DIR]" : "[FILE]",
                            ImVec2(100, 100)))
                            selectedAssetPath.set(entry.path);
                        igPopStyleColor();
                    }

                    if (selected && igIsItemHovered() &&
                        igIsMouseDoubleClicked(ImGuiMouseButton.Left))
                    {
                        if (entry.isDirectory)
                        {
                            requestedDirectoryIndex = i;
                            navigateToDirectory = true;
                        }
                        else
                        {
                            selectedAssetPath.set(entry.path);
                            openWithDefaultApp(entry.path);
                        }
                    }

                    if (igBeginDragDropSource())
                    {
                        // pathZ includes the terminating zero
                        igSetDragDropPayload("ASSET", entry.pathZ.ptr, entry.pathZ.length);
                        igText("%s", entry.pathZ.ptr);
                        igEndDragDropSource();
                    }

                    if (igBeginPopupContextItem("Asset item context"))
                    {
                        if (!entry.isDirectory)
                        if (igMenuItem("Open"))
                        {
                            openWithDefaultApp(entry.path);
                        }
                        if (igMenuItem("Rename"))
                        {
                            assetRenameTarget.set(entry.name);
                            setAssetNameBuffer(entry.name);
                            openRenamePopup = true;
                        }
                        if (igMenuItem("Delete"))
                        {
                            assetDeleteTarget.set(entry.name);
                            assetDeleteTargetIsDirectory = entry.isDirectory;
                            openDeletePopup = true;
                        }
                        igEndPopup();
                    }

                    igTextWrapped("%s", entry.nameZ.ptr);

                    igEndGroup();

                    igPopID();
                    igNextColumn();
                }
                igColumns(1);
            }
            if (navigateToDirectory)
            {
                TextBuffer!512 requestedDirectory;
                requestedDirectory.append(assetDirectory.slice);
                if (requestedDirectory.length != 0)
                    requestedDirectory.append("/");
                requestedDirectory.append(assetEntries.data[requestedDirectoryIndex].name);
                assetDirectory.clear();
                assetDirectory.append(requestedDirectory.slice);
                selectedAssetPath.clear();
                refreshAssetEntries();
            }

            if (openRenamePopup)
                igOpenPopup("Rename asset");
            if (assetRenameTarget.length != 0 &&
                igBeginPopup("Rename asset", ImGuiWindowFlags.AlwaysAutoResize))
            {
                igInputText("New name", assetNameBuffer.ptr, assetNameBuffer.length);
                if (igButton("Rename"))
                {
                    renameAsset();
                    assetRenameTarget.clear();
                    igCloseCurrentPopup();
                }
                igSameLine();
                if (igButton("Cancel"))
                {
                    assetRenameTarget.clear();
                    igCloseCurrentPopup();
                }
                igEndPopup();
            }

            if (openDeletePopup)
                igOpenPopup("Confirm asset delete");
            if (assetDeleteTarget.length != 0 &&
                igBeginPopupModal("Confirm asset delete", null, ImGuiWindowFlags.AlwaysAutoResize))
            {
                igText("Delete '%s'?", assetDeleteTarget.cstr);
                if (assetDeleteTargetIsDirectory)
                    igTextDisabled("Only empty folders can be deleted.");
                if (igButton("Delete"))
                {
                    deleteAsset();
                    igCloseCurrentPopup();
                }
                igSameLine();
                if (igButton("Cancel"))
                {
                    assetDeleteTarget.clear();
                    igCloseCurrentPopup();
                }
                igEndPopup();
            }

            if (assetBrowserMessage.length != 0)
                igTextWrapped("%s", assetBrowserMessage.cstr);
            else if (selectedAssetPath.length != 0)
                igTextWrapped("%s", selectedAssetPath.cstr);
            else if (visibleEntries == 0 && !navigateToDirectory)
                igTextDisabled(assetEntries.length == 0
                    ? "This folder is empty."
                    : "No matching assets.");

            igEnd();
        }
    }
}
