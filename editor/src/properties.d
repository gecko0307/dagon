/*
 * Properties panel.
 */
module properties;

import std.stdio;

import dlib.core.ownership;

import dagon.graphics.entity;
import dagon.graphics.material;
import dagon.render.postproc;
import dagon.ext.imgui;

import editor;
import history;
import materialpreview;
import overlay;
import ui;

// Tracks one continuous edit of a transformation field, so that
// typing or dragging produces a single undo step
struct TransformEditTracker
{
    bool active;
    Entity entity;
    TransformSnapshot start;
}

class PropertiesPanel: Owner
{
    EditorUI ui;
    
    char[256] sceneNameBuffer;
    
    static immutable string[3] transformEditNames = [
        "Edit position",
        "Edit rotation",
        "Edit scaling"
    ];
    TransformEditTracker[3] transformEditTrackers;

    this(EditorUI ui)
    {
        super(ui);
        this.ui = ui;
        
        sceneNameBuffer[] = 0;
        sceneNameBuffer[0..scene.name.length] = scene.name;
    }

    @property EditorScene scene()
    {
        return ui.scene;
    }

    static extern(C) int nameInputCallback(ImGuiInputTextCallbackData* data)
    {
        EditorUI ui = cast(EditorUI)data.UserData;
        if (ui is null)
            return 0;
        
        ui.scene.name = cast(string)data.Buf[0..data.BufTextLen];
        
        return 0;
    }

    void commitTransformEdit(size_t index)
    {
        auto tracker = &transformEditTrackers[index];
        if (!tracker.active)
            return;
        tracker.active = false;
        if (tracker.entity)
            scene.history.pushTransform(transformEditNames[index], tracker.entity, tracker.start);
        tracker.entity = null;
    }

    // Call right after an input widget; `before` is the entity's transformation
    // captured before the widget was drawn, `changed` is the widget's return value
    void trackTransformEdit(size_t index, Entity entity, TransformSnapshot before, bool changed)
    {
        auto tracker = &transformEditTrackers[index];
        if (changed && !tracker.active)
        {
            tracker.active = true;
            tracker.entity = entity;
            tracker.start = before;
        }
        if (tracker.active && !igIsItemActive())
            commitTransformEdit(index);
    }

    void render()
    {
        // Selection changed (or was cleared) in the middle of an edit: close it
        foreach (i; 0 .. transformEditTrackers.length)
        {
            if (transformEditTrackers[i].active &&
                transformEditTrackers[i].entity !is scene.selectedEntity)
                commitTransformEdit(i);
        }

        if (igBegin("Scene", null, ImGuiWindowFlags.NoCollapse))
        {
            if (igCollapsingHeader("Main"))
            {
                if (igInputText("Name",
                        sceneNameBuffer.ptr,
                        sceneNameBuffer.length,
                        ImGuiInputTextFlags.CallbackEdit,
                        &nameInputCallback,
                        cast(void*)this))
                {
                    //
                }
            }

            if (igCollapsingHeader("Viewport"))
            {
                auto freeview = scene.freeview;
                if (igButton("Forward", ImVec2(0, 0)))
                    freeview.setRotationSmooth(0.0f, 180.0f, 0.0f);
                igSameLine();
                if (igButton("Back", ImVec2(0, 0)))
                    freeview.setRotationSmooth(0.0f, 0.0f, 0.0f);
                igSameLine();
                if (igButton("Left", ImVec2(0, 0)))
                    freeview.setRotationSmooth(0.0f, -90.0f, 0.0f);
                igSameLine();
                if (igButton("Right", ImVec2(0, 0)))
                    freeview.setRotationSmooth(0.0f, 90.0f, 0.0f);
                igSameLine();
                if (igButton("Top", ImVec2(0, 0)))
                    freeview.setRotationSmooth(90.0f, 0.0f, 0.0f);
                igSameLine();
                if (igButton("Bottom", ImVec2(0, 0)))
                    freeview.setRotationSmooth(-90.0f, 0.0f, 0.0f);

                igCheckbox("Floor grid", &scene.floorGridEnabled);
                if (scene.floorGridEnabled)
                {
                    if (igSliderFloat("Grid spacing", &scene.floorGridSpacing, 0.1f, 5.0f, "%.1f"))
                        scene.floorGridSpacing = cast(float)(cast(int)(scene.floorGridSpacing * 10.0f + 0.5f)) / 10.0f;
                    if (igSliderFloat("Grid extent", &scene.floorGridExtent, 5.0f, 100.0f, "%.0f"))
                        scene.floorGridExtent = cast(float)(cast(int)(scene.floorGridExtent + 0.5f));
                }
                if (igTreeNode("Freeview"))
                {
                    igCheckbox("Mouse orbit", &freeview.enableMouseRotation);
                    igSliderFloat("Orbit sensitivity", &freeview.mouseRotationSensibility, 0.1f, 5.0f, "%.2f");
                    igCheckbox("Mouse pan", &freeview.enableMouseTranslation);
                    igSliderFloat("Pan sensitivity", &freeview.mouseTranslationSensibility, 0.01f, 1.0f, "%.2f");
                    igCheckbox("Mouse zoom", &freeview.enableMouseZoom);
                    igSliderFloat("Zoom sensitivity", &freeview.mouseZoomSensibility, 0.01f, 1.0f, "%.2f");
                    igSliderFloat("Pan stiffness", &freeview.translationStiffness, 0.0f, 1.0f, "%.2f");
                    igSliderFloat("Orbit stiffness", &freeview.rotationStiffness, 0.0f, 1.0f, "%.2f");
                    igSliderFloat("Zoom stiffness", &freeview.zoomStiffness, 0.0f, 1.0f, "%.2f");
                    igTreePop();
                }
            }
            
            if (igCollapsingHeader("Post-processing"))
            {
                if (igCheckbox("SSAO", &scene.ssaoEnabled))
                    scene.app.deferredRenderer.ssaoEnabled = scene.ssaoEnabled;
                if (scene.ssaoEnabled)
                {
                    igSliderFloat("SSAO radius", &scene.app.deferredRenderer.ssaoRadius, 0.01f, 1.0f, "%.2f");
                    igSliderInt("SSAO samples", &scene.app.deferredRenderer.ssaoSamples, 1, 30);
                    igSliderFloat("SSAO power", &scene.app.deferredRenderer.ssaoPower, 0.0f, 10.0f, "%.1f");
                    igSliderFloat("SSAO denoise", &scene.app.deferredRenderer.ssaoDenoise, 0.0f, 1.0f, "%.2f");
                }
                
                if (igCheckbox("DoF", &scene.depthOfFieldEnabled))
                    scene.app.postProcessingRenderer.depthOfFieldEnabled = scene.depthOfFieldEnabled;
                if (scene.depthOfFieldEnabled)
                {
                    if (!igCheckbox("Autofocus", &scene.app.postProcessingRenderer.autofocus))
                        igSliderFloat("Focal depth", &scene.app.postProcessingRenderer.focalDepth, 0.0f, 2.0f, "%.2f");
                    igSliderFloat("Focal length", &scene.app.postProcessingRenderer.focalLength, 0.0f, 10.0f, "%.2f");
                    igSliderFloat("F-Stop", &scene.app.postProcessingRenderer.fStop, 0.0f, 32.0f, "%.2f");
                }
                
                if (igCheckbox("Lens distortion", &scene.lensDistortionEnabled))
                    scene.app.postProcessingRenderer.lensDistortionEnabled = scene.lensDistortionEnabled;
                if (scene.lensDistortionEnabled)
                {
                    igSliderFloat("Dispersion", &scene.app.postProcessingRenderer.lensDistortionDispersion, 0.0f, 1.0f, "%.2f");
                    igSliderFloat("Scale", &scene.app.postProcessingRenderer.lensDistortionScale, 0.0f, 2.0f, "%.2f");
                }
                
                if (igCheckbox("Glow", &scene.glowEnabled))
                    scene.app.postProcessingRenderer.glowEnabled = scene.glowEnabled;
                if (scene.glowEnabled)
                {
                    if (igSliderInt("Glow radius", &scene.glowRadius, 0, 10))
                        scene.app.postProcessingRenderer.glowRadius = scene.glowRadius;
                    igSliderFloat("Glow threshold", &scene.app.postProcessingRenderer.glowThreshold, 0.0f, 2.0f, "%.2f");
                    igSliderFloat("Glow intensity", &scene.app.postProcessingRenderer.glowIntensity, 0.0f, 1.0f, "%.2f");
                }

                if (igCheckbox("Motion blur", &scene.motionBlurEnabled))
                    scene.app.postProcessingRenderer.motionBlurEnabled = scene.motionBlurEnabled;
                if (scene.motionBlurEnabled)
                {
                    uint samplesMin = 1;
                    uint samplesMax = 30;
                    igSliderScalar("Blur samples", ImGuiDataType.U32, &scene.app.postProcessingRenderer.motionBlurSamples, &samplesMin, &samplesMax);
                    uint framerateMin = 1;
                    uint framerateMax = 60;
                    igSliderScalar("Framerate", ImGuiDataType.U32, &scene.app.postProcessingRenderer.motionBlurFramerate, &framerateMin, &framerateMax);
                    igSliderFloat("Randomness", &scene.app.postProcessingRenderer.motionBlurRandomness, 0.0f, 1.0f, "%.2f");
                    igSliderFloat("Min distance", &scene.app.postProcessingRenderer.motionBlurMinDistance, 0.0f, 1.0f, "%.2f");
                    igSliderFloat("Max distance", &scene.app.postProcessingRenderer.motionBlurMaxDistance, 0.0f, 1.0f, "%.2f");
                    igSliderFloat("Radial blur", &scene.app.postProcessingRenderer.radialBlurAmount, 0.0f, 1.0f, "%.2f");
                }
                
                if (igCombo_Str("Tonemapper", &scene.tonemapper,
                    "None\0Reinhard\0Uncharted\0ACES\0Filmic\0Reinhard2\0Unreal\0AgX Base\0AgX Punchy\0Khronos PBR Neutral\0Uchimura\0Lottes\0"))
                    scene.app.postProcessingRenderer.tonemapper = cast(Tonemapper)scene.tonemapper;
                igSliderFloat("Exposure", &scene.app.postProcessingRenderer.exposure, 0.0f, 2.0f, "%.1f");

                if (igCheckbox("FXAA antialiasing", &scene.fxaaEnabled))
                    scene.app.postProcessingRenderer.fxaaEnabled = scene.fxaaEnabled;
            }
            
            igEnd();
        }
        
        if (igBegin("Entity", null, ImGuiWindowFlags.NoCollapse))
        {
            if (igCollapsingHeader("Options"))
            {
                if (scene.selectedEntity)
                {
                    igCheckbox("Visible", &scene.selectedEntity.visible);
                    igCheckbox("Casts shadow", &scene.selectedEntity.castShadow);
                    igCheckbox("Solid", &scene.selectedEntity.solid);
                    igCheckbox("Dynamic", &scene.selectedEntity.dynamic);
                    igCheckbox("Decal", &scene.selectedEntity.decal);
                    igCheckbox("Transparent", &scene.selectedEntity.transparent);
                    igSliderFloat("Entity opacity", &scene.selectedEntity.opacity, 0.0f, 1.0f, "%.3f");
                    igCheckbox("Show bounding box", &scene.showSelectedEntityBoundingBox);
                }
            }

            if (igCollapsingHeader("Transformation", ImGuiTreeNodeFlags.DefaultOpen))
            {
                if (scene.selectedEntity)
                {
                    if (igButton("Move", ImVec2(60, 0)))
                        scene.overlay.gizmoMode = GizmoMode.Translation;
                    igSameLine();
                    if (igButton("Rotate", ImVec2(60, 0)))
                        scene.overlay.gizmoMode = GizmoMode.Rotation;
                    igSameLine();
                    if (igButton("Scale", ImVec2(60, 0)))
                        scene.overlay.gizmoMode = GizmoMode.Scale;

                    Entity entity = scene.selectedEntity;
                    TransformSnapshot before;
                    bool changed;

                    before = TransformSnapshot.capture(entity);
                    changed = igInputFloat3("Position XYZ", &entity.position.arrayof);
                    trackTransformEdit(0, entity, before, changed);

                    before = TransformSnapshot.capture(entity);
                    changed = igInputFloat4("Rotation XYZW", &entity.rotation.arrayof);
                    trackTransformEdit(1, entity, before, changed);

                    before = TransformSnapshot.capture(entity);
                    changed = igInputFloat3("Scaling XYZ", &entity.scaling.arrayof);
                    trackTransformEdit(2, entity, before, changed);
                }
            }

            if (igCollapsingHeader("Material"))
            {
                uint previewTexture = scene.materialPreviewRenderer.renderThumbnail(
                    scene.selectedEntity ? scene.selectedEntity.material : null);
                igImage(cast(void*)cast(size_t)previewTexture,
                    ImVec2(
                        cast(float)MaterialPreviewRenderer.thumbnailSize,
                        cast(float)MaterialPreviewRenderer.thumbnailSize),
                    ImVec2(0.0f, 1.0f),
                    ImVec2(1.0f, 0.0f));
                if (igIsItemClicked(ImGuiMouseButton.Left))
                    igOpenPopup("Materials");

                if (igBeginDragDropTarget())
                {
                    const(ImGuiPayload)* payload = igAcceptDragDropPayload("ASSET");
                    if (payload !is null && payload.Delivery && payload.DataSize > 0)
                    {
                        auto data = cast(const(char)*)payload.Data;
                        size_t dataLength = cast(size_t)payload.DataSize;
                        if (data[dataLength - 1] == '\0')
                            dataLength--;
                        scene.applyMaterialAsset(data[0 .. dataLength].idup, scene.selectedEntity);
                    }
                    igEndDragDropTarget();
                }
                
                /*
                // TODO: implement a proper material browser popup
                if (igBeginPopup("Materials", ImGuiWindowFlags.AlwaysAutoResize))
                {
                    igSetCursorPosX(400);
                    igSetCursorPosX(0.0f);
                    renderMaterialBrowser();
                    igEndPopup();
                }
                */

                if (scene.selectedEntity && scene.selectedEntity.material)
                {
                    Material material = scene.selectedEntity.material;
                    bool materialChanged = false;
                    materialChanged |= igColorEdit4("Base color", &material.baseColorFactor.arrayof, ImGuiColorEditFlags.Float);
                    materialChanged |= igSliderFloat("Roughness", &material.roughnessFactor, 0.0f, 1.0f, "%.3f");
                    materialChanged |= igSliderFloat("Metallic", &material.metallicFactor, 0.0f, 1.0f, "%.3f");
                    //igSliderFloat("Specularity", &material.specularity, 0.0f, 1.0f, "%.3f");
                    materialChanged |= igColorEdit4("Emission", &material.emissionFactor.arrayof, ImGuiColorEditFlags.Float);
                    materialChanged |= igInputFloat("Emission energy", &material.emissionEnergy);
                    materialChanged |= igCombo_Str("BlendMode", &material.blendMode, "Opaque\0Transparent\0Additive\0");
                    materialChanged |= igSliderFloat("Opacity", &material.opacity, 0.0f, 1.0f, "%.3f");
                    materialChanged |= igSliderFloat("Alpha test threshold", &material.alphaTestThreshold, 0.0f, 1.0f, "%.3f");
                    materialChanged |= igCheckbox("Shadeless", &material.shadeless);
                    if (igCheckbox("Use shadows", &material.useShadows))
                    {
                        materialChanged = true;
                        materialChanged |= igCombo_Str("Shadow filter", &material.shadowFilter, "None\0PCF\0");
                    }
                    materialChanged |= igCheckbox("Use fog", &material.useFog);
                    materialChanged |= igCheckbox("Use culling", &material.useCulling);
                    materialChanged |= igCheckbox("Color write", &material.colorWrite);
                    materialChanged |= igCheckbox("Depth write", &material.depthWrite);
                    if (materialChanged)
                        scene.materialPreviewRenderer.invalidate(material);
                    /*
                    igCheckbox("Output color", &material.outputColor);
                    igCheckbox("Output normals", &material.outputNormal);
                    igCheckbox("Output PBR", &material.outputPBR);
                    igCheckbox("Output emission", &material.outputEmission);
                    */
                    // TODO: parallax mapping settings
                    // TODO: textures
                }
            }

            igEnd();
        }
    }

