/*
 * GC-free JSON output and tolerant readers on top of dlib.serialization.json.
 *
 * Notes on compatibility with dlib's JSON lexer:
 *  - The lexer finds the end of a string by looking for the next '"' and does not
 *    understand '\"'. The writer therefore escapes '"' as " (valid JSON).
 *  - dlib does not unescape strings, so `jsonString` does it.
 */
module jsonio;

import core.stdc.stdio: snprintf;
import core.stdc.stdlib: strtof, strtod;
import std.stdio: File;
import std.traits;

import dlib.core.memory;
import dlib.container.array;
import dlib.math.vector;
import dlib.math.quaternion;
import dlib.image.color;
import dlib.serialization.json;

/// Streaming pretty-printing JSON writer. Output goes to a GC-free buffer.
struct JSONWriter
{
    enum maxDepth = 32;
    enum indentWidth = 4;

    Array!char buffer;
    private uint depth = 0;
    private bool[maxDepth + 1] hasItems;
    private bool afterKey = false;

    void free()
    {
        buffer.free();
    }

    /// Written text. Valid until the next write.
    const(char)[] text()
    {
        return buffer.data;
    }

    /// Terminates the document with a newline.
    void finish()
    {
        put('\n');
    }

    void beginObject()
    {
        beginItem();
        put('{');
        enter();
    }

    void endObject()
    {
        leave();
        put('}');
    }

    void beginArray()
    {
        beginItem();
        put('[');
        enter();
    }

    void endArray()
    {
        leave();
        put(']');
    }

    /**
     * Starts an object member. Must be followed by exactly one value
     * (a scalar, beginObject or beginArray).
     */
    void key(const(char)[] name)
    {
        assert(depth > 0);
        if (hasItems[depth])
            put(',');
        hasItems[depth] = true;
        newline();
        writeEscaped(name);
        put(": ");
        afterKey = true;
    }

    void valueString(const(char)[] s)
    {
        beginItem();
        writeEscaped(s);
    }

    void valueBool(bool v)
    {
        beginItem();
        put(v ? "true" : "false");
    }

    void valueInt(long v)
    {
        beginItem();
        char[24] tmp;
        int n = snprintf(tmp.ptr, tmp.length, "%lld", v);
        put(tmp[0..n]);
    }

    void valueFloat(float v)
    {
        beginItem();
        putFloating(v, true);
    }

    void valueDouble(double v)
    {
        beginItem();
        putFloating(v, false);
    }

    /// Member with a scalar value: bool, integer, enum, float, double or string.
    void add(T)(const(char)[] name, T v)
    {
        key(name);
        static if (is(T == bool))
            valueBool(v);
        else static if (is(T == enum))
            valueInt(cast(long)v);
        else static if (isIntegral!T)
            valueInt(cast(long)v);
        else static if (is(T == float))
            valueFloat(v);
        else static if (isFloatingPoint!T)
            valueDouble(cast(double)v);
        else static if (isSomeString!T)
            valueString(v);
        else
            static assert(false, "JSONWriter.add: unsupported type " ~ T.stringof);
    }

    /// Member with a short numeric array, written on one line: [1, 2, 3]
    void addFloats(size_t N)(const(char)[] name, const float[N] values)
    {
        key(name);
        beginItem();
        put('[');
        foreach (i; 0..N)
        {
            if (i > 0)
                put(", ");
            putFloating(values[i], true);
        }
        put(']');
    }

  private:

    void put(char c)
    {
        buffer.append(c);
    }

    void put(const(char)[] s)
    {
        foreach (c; s)
            buffer.append(c);
    }

    void newline()
    {
        put('\n');
        foreach (i; 0..depth * indentWidth)
            put(' ');
    }

    // Comma and line break before a value that is an array element or the root
    void beginItem()
    {
        if (afterKey)
        {
            afterKey = false;
            return;
        }
        if (depth > 0)
        {
            if (hasItems[depth])
                put(',');
            hasItems[depth] = true;
            newline();
        }
    }

    void enter()
    {
        assert(depth < maxDepth);
        depth++;
        hasItems[depth] = false;
    }

    void leave()
    {
        assert(depth > 0);
        bool hadItems = hasItems[depth];
        depth--;
        if (hadItems)
            newline();
    }

    // Shortest representation that reads back to exactly the same value
    void putFloating(double v, bool single)
    {
        if (!(v == v) || (v - v) != 0.0) // NaN or Inf: not representable in JSON
        {
            put('0');
            return;
        }

        char[40] tmp;
        int n = 0;
        int first = single ? 6 : 15;
        int last = single ? 10 : 18;
        foreach (precision; first..last)
        {
            n = snprintf(tmp.ptr, tmp.length, "%.*g", precision, v);
            bool exact = single?
                (strtof(tmp.ptr, null) == cast(float)v) :
                (strtod(tmp.ptr, null) == v);
            if (exact)
                break;
        }

        // Guard against locales with a decimal comma
        foreach (i; 0..n)
        {
            if (tmp[i] == ',')
                tmp[i] = '.';
        }
        put(tmp[0..n]);
    }

    void writeEscaped(const(char)[] s)
    {
        static immutable string hex = "0123456789abcdef";
        put('"');
        foreach (char c; s)
        {
            switch (c)
            {
                case '"':  put("\\u0022"); break; // dlib's lexer cannot handle \"
                case '\\': put("\\\\"); break;
                case '\n': put("\\n"); break;
                case '\r': put("\\r"); break;
                case '\t': put("\\t"); break;
                default:
                    if (c < 0x20)
                    {
                        put("\\u00");
                        put(hex[c >> 4]);
                        put(hex[c & 15]);
                    }
                    else
                        put(c);
                    break;
            }
        }
        put('"');
    }
}

/**
 * Reads a whole file into a dlib-allocated buffer. The caller must Delete it.
 * Throws on I/O errors.
 */
ubyte[] readFileBytes(string filename)
{
    auto f = File(filename, "rb");
    size_t size = cast(size_t)f.size;
    if (size == 0)
        throw new Exception("file is empty");
    ubyte[] buffer = New!(ubyte[])(size);
    scope(failure) Delete(buffer);
    auto got = f.rawRead(buffer);
    if (got.length != size)
        throw new Exception("cannot read the whole file");
    return buffer;
}

/// Writes data to a file, overwriting it. Throws on I/O errors.
void writeFileBytes(string filename, const(char)[] data)
{
    auto f = File(filename, "wb");
    f.rawWrite(data);
}

// Tolerant readers. Missing or mistyped keys fall back to a default.

/// Returns an object member, or null if `obj` is not an object or has no such key.
JSONValue jsonField(JSONValue obj, string key)
{
    if (obj is null || obj.type != JSONType.Object || obj.asObject is null)
        return null;
    auto p = key in obj.asObject;
    return (p is null)? null : *p;
}

float jsonNum(JSONValue v, float def = 0.0f)
{
    if (v !is null && v.type == JSONType.Number)
        return cast(float)v.asNumber;
    return def;
}

private bool hex4(string s, size_t at, out uint value)
{
    value = 0;
    if (at + 4 > s.length)
        return false;
    foreach (i; 0..4)
    {
        char c = s[at + i];
        uint d;
        if (c >= '0' && c <= '9') d = c - '0';
        else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
        else return false;
        value = value * 16 + d;
    }
    return true;
}

private void putUtf8(uint cp, char[] dst, ref size_t n)
{
    if (cp < 0x80)
        dst[n++] = cast(char)cp;
    else if (cp < 0x800)
    {
        dst[n++] = cast(char)(0xC0 | (cp >> 6));
        dst[n++] = cast(char)(0x80 | (cp & 0x3F));
    }
    else if (cp < 0x10000)
    {
        dst[n++] = cast(char)(0xE0 | (cp >> 12));
        dst[n++] = cast(char)(0x80 | ((cp >> 6) & 0x3F));
        dst[n++] = cast(char)(0x80 | (cp & 0x3F));
    }
    else
    {
        dst[n++] = cast(char)(0xF0 | (cp >> 18));
        dst[n++] = cast(char)(0x80 | ((cp >> 12) & 0x3F));
        dst[n++] = cast(char)(0x80 | ((cp >> 6) & 0x3F));
        dst[n++] = cast(char)(0x80 | (cp & 0x3F));
    }
}

/**
 * String value. Without escape sequences this is a slice of the parsed document
 * (valid while the document is alive; `.idup` it to keep). With escapes, dlib leaves
 * them untouched, so a decoded copy is returned (this one is GC-allocated).
 */
string jsonString(JSONValue v, string def = "")
{
    if (v is null || v.type != JSONType.String)
        return def;

    string raw = v.asString;
    bool escaped = false;
    foreach (c; raw)
    {
        if (c == '\\')
        {
            escaped = true;
            break;
        }
    }
    if (!escaped)
        return raw;

    // Decoded text is never longer than the escaped one
    char[] result = new char[raw.length];
    size_t n = 0;
    size_t i = 0;
    while (i < raw.length)
    {
        char c = raw[i++];
        if (c != '\\' || i >= raw.length)
        {
            result[n++] = c;
            continue;
        }

        char e = raw[i++];
        switch (e)
        {
            case 'n': result[n++] = '\n'; break;
            case 'r': result[n++] = '\r'; break;
            case 't': result[n++] = '\t'; break;
            case 'b': result[n++] = '\b'; break;
            case 'f': result[n++] = '\f'; break;
            case 'u':
            {
                uint cp;
                if (!hex4(raw, i, cp))
                {
                    result[n++] = 'u';
                    break;
                }
                i += 4;
                if (cp >= 0xD800 && cp <= 0xDBFF)
                {
                    uint low;
                    if (i + 1 < raw.length && raw[i] == '\\' && raw[i + 1] == 'u' &&
                        hex4(raw, i + 2, low) && low >= 0xDC00 && low <= 0xDFFF)
                    {
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
                        i += 6;
                    }
                    else
                        cp = 0xFFFD;
                }
                else if (cp >= 0xDC00 && cp <= 0xDFFF)
                    cp = 0xFFFD;
                putUtf8(cp, result, n);
                break;
            }
            default: result[n++] = e; break; // \" \\ \/ and anything unknown
        }
    }
    return cast(string)result[0..n];
}

T jsonGet(T)(JSONValue j, string key, T def)
{
    JSONValue p = jsonField(j, key);
    if (p is null)
        return def;

    static if (is(T == bool))
    {
        return (p.type == JSONType.Boolean)? p.asBoolean : def;
    }
    else static if (is(T == string))
    {
        return jsonString(p, def);
    }
    else static if (is(T == long))
    {
        return (p.type == JSONType.Number)? cast(long)p.asNumber : def;
    }
    else static if (is(T == uint))
    {
        return (p.type == JSONType.Number)? cast(uint)cast(long)p.asNumber : def;
    }
    else static if (is(T == int))
    {
        return (p.type == JSONType.Number)? cast(int)cast(long)p.asNumber : def;
    }
    else static if (is(T == float))
    {
        return jsonNum(p, def);
    }
    else static assert(false, "jsonGet: unsupported type " ~ T.stringof);
}

// Numeric array of at least `count` elements, or null
private JSONValue[] jsonNumbers(JSONValue j, string key, size_t count)
{
    JSONValue p = jsonField(j, key);
    if (p is null || p.type != JSONType.Array || p.asArray.length < count)
        return null;
    return p.asArray.data;
}

Vector3f jsonVec3(JSONValue j, string key, Vector3f def)
{
    auto a = jsonNumbers(j, key, 3);
    if (a is null)
        return def;
    return Vector3f(jsonNum(a[0]), jsonNum(a[1]), jsonNum(a[2]));
}

Quaternionf jsonQuat(JSONValue j, string key, Quaternionf def)
{
    auto a = jsonNumbers(j, key, 4);
    if (a is null)
        return def;
    return Quaternionf(jsonNum(a[0]), jsonNum(a[1]), jsonNum(a[2]), jsonNum(a[3]));
}

Color4f jsonColor(JSONValue j, string key, Color4f def)
{
    auto a = jsonNumbers(j, key, 4);
    if (a is null)
        return def;
    return Color4f(jsonNum(a[0]), jsonNum(a[1]), jsonNum(a[2]), jsonNum(a[3]));
}
