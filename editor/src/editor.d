// Light (de)serialization. Readers (jsonio.d) are tolerant: missing keys keep defaults.
void writeLight(ref JSONWriter w, Light l)
{
    w.beginObject();
    w.add("type", cast(uint)l.type);
    w.add("shining", l.shining);
    w.addFloats("color", l.color.arrayof);
    w.add("energy", l.energy);
    w.add("angularRadius", l.angularRadius);
    w.add("volumeRadius", l.volumeRadius);
    w.add("radius", l.radius);
    w.add("length", l.length);
    w.add("spotOuterCutoff", l.spotOuterCutoff);
    w.add("spotInnerCutoff", l.spotInnerCutoff);
    w.add("shadowEnabled", l.shadowEnabled);
    w.add("scatteringEnabled", l.scatteringEnabled);
    w.add("scattering", l.scattering);
    w.add("mediumDensity", l.mediumDensity);
    w.add("scatteringSamples", l.scatteringSamples);
    w.add("scatteringMaxRandomStepOffset", l.scatteringMaxRandomStepOffset);
    w.add("scatteringUseShadow", l.scatteringUseShadow);
    w.add("diffuse", l.diffuse);
    w.add("specular", l.specular);
    w.endObject();
}

void readLight(Light l, JSONValue j)
{
    l.shining = jsonGet(j, "shining", l.shining);
    l.color = jsonColor(j, "color", l.color);
    l.energy = jsonGet(j, "energy", l.energy);
    l.angularRadius = jsonGet(j, "angularRadius", l.angularRadius);
    l.volumeRadius = jsonGet(j, "volumeRadius", l.volumeRadius);
    l.radius = jsonGet(j, "radius", l.radius);
    l.length = jsonGet(j, "length", l.length);
    l.spotOuterCutoff = jsonGet(j, "spotOuterCutoff", l.spotOuterCutoff);
    l.spotInnerCutoff = jsonGet(j, "spotInnerCutoff", l.spotInnerCutoff);
    l.shadowEnabled = jsonGet(j, "shadowEnabled", l.shadowEnabled);
    l.scatteringEnabled = jsonGet(j, "scatteringEnabled", l.scatteringEnabled);
    l.scattering = jsonGet(j, "scattering", l.scattering);
    l.mediumDensity = jsonGet(j, "mediumDensity", l.mediumDensity);
    l.scatteringSamples = cast(uint)jsonGet(j, "scatteringSamples", cast(long)l.scatteringSamples);
    l.scatteringMaxRandomStepOffset = jsonGet(j, "scatteringMaxRandomStepOffset", l.scatteringMaxRandomStepOffset);
    l.scatteringUseShadow = jsonGet(j, "scatteringUseShadow", l.scatteringUseShadow);
    l.diffuse = jsonGet(j, "diffuse", l.diffuse);
    l.specular = jsonGet(j, "specular", l.specular);
}

/**
 * Where a material comes from: its *.material file and the texture paths
 * exactly as they appear in that file (relative paths are relative to the
 * directory of the material file). Edited materials are marked dirty and
 * written back when the scene is saved. GC-free: all strings are dlib Strings.
 */
class MaterialSource
{
    String path; // absolute
    String[textureSlotCount] textures; // as written in the file, empty if none
    String[textureSlotCount] texturePaths; // absolute, for thumbnails
    int[textureSlotCount] thumbnailIds = [-1, -1, -1, -1];
    bool dirty;

    ~this()
    {
        path.free();
        foreach (ref t; textures)
            t.free();
        foreach (ref t; texturePaths)
            t.free();
    }

    void setPath(const(char)[] newPath)
    {
        path.free();
        path = String(cast(string)newPath);
    }

    // `filePath` is the texture path as written in the material file. MaterialAsset
    // always resolves it relative to the material's directory.
    void setTexture(size_t slot, const(char)[] filePath)
    {
        textures[slot].free();
        texturePaths[slot].free();
        thumbnailIds[slot] = -1;
        if (filePath.length == 0)
            return;
        textures[slot] = String(cast(string)filePath);
        texturePaths[slot] = joinNormalized(dirName(path.toString), filePath);
    }

    string texture(size_t slot) const
    {
        return textures[slot].toString;
    }

    string texturePath(size_t slot) const
    {
        return texturePaths[slot].toString;
    }
}

/**
 * Implements scene editing and serialization.
 */
class Editor: EventListener
{
    string name = "DagonEditor";
    
    bool active = true;
    bool capturesMouse = false;
    
    EditorApp app;
    EditorScene scene;
    uint numEntities = 0;
    
    InteractionOverlay overlay;
    CommandHistory history;
    Entity selectedEntity;

    // Absolute source paths are kept in memory; scene files store paths relative
    // to assetRoot.
    //
    // Editor is allocated with New!, so the GC does not scan it: it must not hold
    // the only reference to any GC-allocated data. Paths live in fixed buffers or
    // dlib Strings; Dict values are owned by the map (see clearPathMaps).
    TextBuffer!2048 assetRootBuffer;
    TextBuffer!2048 sceneFilenameBuffer;
    TextBuffer!2048 pendingOpenBuffer;

    // Slices of the buffers above: valid until the buffer is modified
    string assetRoot() const @property
    {
        return cast(string)assetRootBuffer.slice;
    }

    // File the current scene was last opened from or saved to (empty if none)
    string sceneFilename() const @property
    {
        return cast(string)sceneFilenameBuffer.slice;
    }

    string pendingOpen() const @property
    {
        return cast(string)pendingOpenBuffer.slice;
    }

    Dict!(String, Entity) meshPaths;
    Dict!(MaterialSource, Material) materialSources;

    // Roots of soft-deleted subtrees (see EntityLifetimeCommand in history.d).
    // Deleted entities stay in the scene, hidden, until the scene is replaced.
    Dict!(bool, Entity) deletedEntities;

    void setMeshPath(Entity e, const(char)[] path)
    {
        if (auto old = e in meshPaths)
            old.free();
        meshPaths[e] = String(cast(string)path);
    }

    // Returns the source of a material, or null if it has none
    MaterialSource materialSource(Material m)
    {
        if (m is null)
            return null;
        if (auto source = m in materialSources)
            return *source;
        return null;
    }

    // Registers a material loaded from a file (or updates the file path)
    MaterialSource setMaterialPath(Material m, const(char)[] path)
    {
        if (auto source = m in materialSources)
        {
            source.setPath(path);
            return *source;
        }
        auto source = New!MaterialSource();
        source.setPath(path);
        materialSources[m] = source;
        return source;
    }

    void clearPathMaps()
    {
        foreach (e, ref path; meshPaths)
            path.free();
        meshPaths.clear();
        foreach (m, ref source; materialSources)
            Delete(source);
        materialSources.clear();
        deletedEntities.clear();
    }

    // Scene file that is being opened: parsed document and the text it points into.
    // Released after the new scene is populated (see populatePending).
    JSONDocument pendingDocument;
    ubyte[] pendingBuffer;

    void releasePendingDocument()
    {
        if (pendingDocument !is null)
        {
            Delete(pendingDocument);
            pendingDocument = null;
        }
        if (pendingBuffer.length)
        {
            Delete(pendingBuffer);
            pendingBuffer = null;
        }
    }

    // True if the scene was changed after it was created, opened or saved.
    // Covers everything that goes through the undo history, asset imports,
    // material assignment, entity options and the scene name. Not covered:
    // post-processing and environment settings.
    bool modified;

    void markModified()
    {
        modified = true;
    }

    // Scene files always use forward slashes, independent of the host OS.
    string portableAssetPath(string path)
    {
        char[] result = path.dup;
        foreach (ref c; result)
        {
            if (c == '\\')
                c = '/';
        }
        return cast(string)result;
    }

    string normalizeAssetPath(string path)
    {
        if (path.length == 0)
            return "";

        // Accept portable scene paths on every platform.
        path = portableAssetPath(path);

        if (isAbsolute(path))
            return buildNormalizedPath(path);
        if (assetRoot.length == 0)
            return buildNormalizedPath(absolutePath(path));
        return buildNormalizedPath(buildPath(assetRoot, path));
    }

    string makeSceneAssetPath(string path)
    {
        if (path.length == 0)
            return "";
        string absolute = normalizeAssetPath(path);
        if (assetRoot.length == 0)
            return portableAssetPath(absolute);
        return portableAssetPath(relativePath(absolute, assetRoot));
    }

    void setAssetRoot(string path, bool refreshBrowser = true)
    {
        if (path.length > 0)
            assetRootBuffer.set(buildNormalizedPath(absolutePath(path)));
        else
            assetRootBuffer.clear();
        if (refreshBrowser)
            app.ui.assetBrowser.reset(assetRoot, true);
    }

    GsVirtualMachine vm;
    Dict!(GsDynamic, string) storage;
    GsDynamic[4] scriptCallArgs;
    
    this(EditorApp application)
    {
        super(application.eventManager, application);
        app = application;
        scene = cast(EditorScene)app.currentScene;
        
        meshPaths = dict!(String, Entity);
        materialSources = dict!(MaterialSource, Material);
        deletedEntities = dict!(bool, Entity);
        
        // TODO: load editor.conf
        
        overlay = New!InteractionOverlay(eventManager, this);
        history = New!CommandHistory(this);
        history.onApplied = &onHistoryApplied;
        history.onChanged = &markModified;
        
        storage = dict!(GsDynamic, string);
        //set("addAsset", GsDynamic(&vmAddAsset));
        //set("addEntity", GsDynamic(&vmAddEntity));
        scriptCallArgs[0] = GsDynamic(this);
        
        vm = New!GsVirtualMachine(this);
        vm.set("log", GsDynamic(&vmLog));
        vm.set("logDebug", GsDynamic(&vmLogDebug));
        vm.set("logInfo", GsDynamic(&vmLogInfo));
        vm.set("logWarning", GsDynamic(&vmLogWarning));
        vm.set("logError", GsDynamic(&vmLogError));
        vm.set("logFatalError", GsDynamic(&vmLogFatalError));
        
        vm.load([
            GsInstruction(GsInstructionType.HALT)
        ]);
        
        compileScripts();
        
        vm.run();
    }

    void compileScripts()
    {
        foreach(string scriptPath; dirEntries("scripts", SpanMode.depth).filter!(f => f.name.endsWith(".gs")))
        {
            bool needToCompile = false;
            string bytecodePath = stripExtension(scriptPath) ~ ".gsc";
            
            if (exists(bytecodePath))
            {
                if (timeLastModified(scriptPath, SysTime.min) > timeLastModified(bytecodePath, SysTime.min))
                    needToCompile = true;
            }
            else
                needToCompile = true;
            
            GsInstruction[] prog;
            if (needToCompile)
            {
                logInfo("Compiling script \"", scriptPath, "\"...");
                string script = readText(scriptPath);
                prog = compile(script, scriptPath);
                auto code = saveBytecode(prog);
                std.file.write(bytecodePath, code);
            }
            else
            {
                logInfo("Loading \"", bytecodePath, "\"...");
                auto code = cast(ubyte[])std.file.read(bytecodePath);
                prog = loadBytecode(code);
            }
            
            auto lib = New!GsLibrary(bytecodePath, vm);
            //logInfo(prog);
            lib.load(prog);
            vm.spawn(lib);
        }
    }

    ~this()
    {
        releasePendingDocument();
        clearPathMaps();
        Delete(meshPaths);
        Delete(materialSources);
        Delete(deletedEntities);
        Delete(storage);
    }
    
    // GScript VM API
    
    GsDynamic vmLog(GsDynamic[] args)
    {
        auto logLevel = cast(LogLevel)cast(uint)args[1].asNumber;
        auto message = args[2].toString;
        log(logLevel, message);
        return GsDynamic();
    }
    
    GsDynamic vmLogDebug(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logDebug(message);
        return GsDynamic();
    }
    
    GsDynamic vmLogInfo(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logInfo(message);
        return GsDynamic();
    }
    
    GsDynamic vmLogWarning(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logWarning(message);
        return GsDynamic();
    }
    
    GsDynamic vmLogError(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logError(message);
        return GsDynamic();
    }
    
    GsDynamic vmLogFatalError(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logFatalError(message);
        return GsDynamic();
    }
    
    // GScript object API
    
    GsDynamic get(string key)
    {
        switch(key)
        {
            case "name":
                return GsDynamic(name);
            default:
                auto v = key in storage;
                if (v)
                    return *v;
                else
                    return GsDynamic();
        }
    }
    
    void set(string key, GsDynamic value)
    {
        storage[key] = value;
    }
    
    bool contains(string key)
    {
        switch(key)
        {
            case "name":
                return true;
            default:
                if ((key in storage) !is null)
                    return true;
                else
                    return false;
        }
    }
    
    void setPrototype(GsObject)
    {
        // No-op
    }

    // Selects the affected entity and refreshes gizmo and bounding box,
    // keeping the current gizmo mode
    void onHistoryApplied(Command command)
    {
        if (command.target is null)
            return;

        // The command removed its target (redo of a deletion, undo of a duplicate)
        if (isDeleted(command.target))
        {
            if (selectedEntity !is null && isDeleted(selectedEntity))
                clearSelection();
            return;
        }

        GizmoMode mode = overlay.gizmoMode;
        selectEntity(command.target);
        if (mode != GizmoMode.Disabled)
            overlay.gizmoMode = mode;
    }

    void clearSelection()
    {
        selectedEntity = null;
        overlay.gizmoMode = GizmoMode.Disabled;
    }

    // Callback for EntityLifetimeCommand
    void markDeleted(Entity e, bool deleted)
    {
        if (deleted)
            deletedEntities[e] = true;
        else
            deletedEntities.remove(e);
    }

    // An entity is deleted if it or any of its ancestors was deleted
    bool isDeleted(Entity e)
    {
        if (deletedEntities.length == 0)
            return false;
        for (Entity p = e; p !is null; p = p.parent)
        {
            if (p in deletedEntities)
                return true;
        }
        return false;
    }

    // Soft-deletes the entity together with its children, undoable
    void deleteEntity(Entity e)
    {
        if (overlay.draggingGizmo || e is null || !isSerializableEntity(e))
            return;

        auto command = New!EntityLifetimeCommand("Delete", e, false, &markDeleted);
        command.redo(); // performs the deletion
        history.push(command);

        if (selectedEntity !is null && isDeleted(selectedEntity))
            clearSelection();
    }

    void deleteSelected()
    {
        deleteEntity(selectedEntity);
    }

    void copyLight(Light dst, Light src)
    {
        dst.shining = src.shining;
        dst.color = src.color;
        dst.energy = src.energy;
        dst.angularRadius = src.angularRadius;
        dst.volumeRadius = src.volumeRadius;
        dst.radius = src.radius;
        dst.length = src.length;
        dst.spotOuterCutoff = src.spotOuterCutoff;
        dst.spotInnerCutoff = src.spotInnerCutoff;
        dst.shadowEnabled = src.shadowEnabled;
        dst.scatteringEnabled = src.scatteringEnabled;
        dst.scattering = src.scattering;
        dst.mediumDensity = src.mediumDensity;
        dst.scatteringSamples = src.scatteringSamples;
        dst.scatteringMaxRandomStepOffset = src.scatteringMaxRandomStepOffset;
        dst.scatteringUseShadow = src.scatteringUseShadow;
        dst.diffuse = src.diffuse;
        dst.specular = src.specular;
    }

    // Recursively copies an entity under the given parent. Meshes and
    // materials are shared with the source, not copied.
    Entity cloneEntity(Entity src, Entity parent, bool isRoot)
    {
        Entity e;
        if (auto srcLight = cast(Light)src)
        {
            auto light = scene.addLight(srcLight.type, parent);
            copyLight(light, srcLight);
            e = light;
        }
        else
        {
            e = scene.addEntity(parent);
        }

        if (isRoot)
            e.name = src.name.length > 0 ? src.name ~ " copy" : genUniqueEntitytName();
        else
            e.name = src.name;

        e.layer = src.layer;
        e.type = src.type;
        e.renderLayer = src.renderLayer;
        e.visible = src.visible;
        e.castShadow = src.castShadow;
        e.solid = src.solid;
        e.dynamic = src.dynamic;
        e.decal = src.decal;
        e.probe = src.probe;
        e.probeExtents = src.probeExtents;
        e.probeFalloffMargin = src.probeFalloffMargin;
        e.probeUseBoxProjection = src.probeUseBoxProjection;
        e.transparent = src.transparent;
        e.opacity = src.opacity;
        e.position = src.position;
        e.rotation = src.rotation;
        e.scaling = src.scaling;
        e.drawable = src.drawable;
        e.material = src.material;

        if (auto mp = src in meshPaths)
            setMeshPath(e, mp.toString);

        foreach (child; src.children)
        {
            if (!isDeleted(child))
                cloneEntity(child, e, false);
        }

        return e;
    }

    // Duplicates the entity with its children, in the same place, undoable
    Entity duplicateEntity(Entity src)
    {
        if (overlay.draggingGizmo || src is null || !isSerializableEntity(src))
            return null;

        Entity parent = src.parent !is null ? src.parent : scene.sceneRoot;
        Entity copy = cloneEntity(src, parent, true);
        selectEntity(copy);
        history.push(New!EntityLifetimeCommand("Duplicate", copy, true, &markDeleted));
        return copy;
    }

    void duplicateSelected()
    {
        duplicateEntity(selectedEntity);
    }

    void undo()
    {
        if (!overlay.draggingGizmo)
            history.undo();
    }

    void redo()
    {
        if (!overlay.draggingGizmo)
            history.redo();
    }

    void update(Time t)
    {
        if (pendingNew)
        {
            pendingNew = false;
            switchTo("Scene", &populateDefault);
        }
        else if (pendingOpen.length > 0)
        {
            // Copy (on the stack): the buffer is cleared before loading
            char[2048] pathCopy;
            size_t pathLength = pendingOpen.length;
            pathCopy[0 .. pathLength] = pendingOpen[0 .. pathLength];
            pendingOpenBuffer.clear();
            loadSceneFile(cast(string)pathCopy[0 .. pathLength]);
        }

        scene = cast(EditorScene)app.currentScene;
        if (scene is null || !scene.canRender)   // new scene is still loading
            return;

        overlay.activeCamera = app.renderer.activeCamera;
        
        processEvents();
        
        if (selectedEntity && !overlay.draggingGizmo)
        {
            overlay.gizmoPosition = selectedEntity.positionAbsolute;
            overlay.gizmoOrientation = selectedEntity.rotationAbsolute;
        }
        overlay.update(t);
        
        capturesMouse = overlay.draggingGizmo;
        scene.focused = !app.ui.capturesMouse && !capturesMouse;
        scene.freeview.active = scene.focused;
    }

    void switchTo(string name, void delegate(EditorScene) populate)
    {
        // Everything below refers to entities/materials of the scene being deleted
        selectedEntity = null;
        overlay.gizmoMode = GizmoMode.Disabled;
        history.clear();
        clearPathMaps();
        modified = false;
        numEntities = 0;
        app.materialPreviewRenderer.clear();

        // The old camera dies with the old scene (deleted at the start of the next onUpdate)
        app.renderer.activeCamera = null;
        overlay.activeCamera = null;

        auto newScene = New!EditorScene(app);
        newScene.name = name;
        newScene.onReady = populate;
        scene = newScene; // loadMaterial/loadMesh use this
        app.setCurrentScene(newScene, true);
    }

    void populateDefault(EditorScene s)
    {
        auto sun = s.addLight(LightType.Sun, s.sceneRoot);
        sun.shadowEnabled = true;
        sun.energy = 10.0f;
        sun.angularRadius = 0.01f;
        sun.pitch(-45.0f);
        sun.name = "Sun";
    }

    void render()
    {
        if (app.ui.active)
            overlay.render();
    }

    void selectEntity(Entity e)
    {
        selectedEntity = e;
        overlay.gizmoMode = GizmoMode.Translation;
        overlay.gizmoPosition = e.positionAbsolute;
        overlay.gizmoOrientation = e.rotationAbsolute;
        if (e.drawable)
        {
            Mesh mesh = cast(Mesh)e.drawable;
            if (mesh)
            {
                overlay.selectionBoundingBoxBaseScale = mesh.boundingBox.size;
                overlay.selectionBoundingBoxBaseScale.x =
                    max(overlay.selectionBoundingBoxBaseScale.x, 0.1f);
                overlay.selectionBoundingBoxBaseScale.y =
                    max(overlay.selectionBoundingBoxBaseScale.y, 0.1f);
                overlay.selectionBoundingBoxBaseScale.z =
                    max(overlay.selectionBoundingBoxBaseScale.z, 0.1f);
            }
            else
            {
                overlay.selectionBoundingBoxBaseScale = Vector3f(1.0f, 1.0f, 1.0f);
            }
        }
        else
        {
            overlay.selectionBoundingBoxBaseScale = Vector3f(1.0f, 1.0f, 1.0f);
        }
        overlay.selectionBoundingBoxScale = Vector3f(
            overlay.selectionBoundingBoxBaseScale.x * abs(e.scaling.x),
            overlay.selectionBoundingBoxBaseScale.y * abs(e.scaling.y),
            overlay.selectionBoundingBoxBaseScale.z * abs(e.scaling.z));
    }

    void onAssetDroppedOnViewport(string assetPath)
    {
        logInfo("Import asset \"", assetPath, "\"...");
        importAsset(assetPath);
    }

    Material loadMaterial(string assetPath)
    {
        assetPath = normalizeAssetPath(assetPath);
        auto matAsset = scene.addMaterialAsset(assetPath, true);
        if (!matAsset.threadSafePartLoaded ||
            !matAsset.threadUnsafePartLoaded ||
            matAsset.material is null)
        {
            logError("Cannot load material \"", assetPath, "\": asset failed to load");
            return null;
        }
        Material material = matAsset.material;
        bool isNew = (material in materialSources) is null;
        auto source = setMaterialPath(material, assetPath);
        if (isNew)
        {
            // Remember the texture paths as written in the file, so that they
            // survive a rewrite. Legacy keys (baseColor, normal, emission) are
            // texture paths only if they hold a string.
            static immutable string[2][textureSlotCount] keys = [
                ["baseColorTexture", "baseColor"],
                ["roughnessMetallicTexture", ""],
                ["emissionTexture", "emission"],
                ["normalTexture", "normal"]
            ];
            foreach (i; 0..textureSlotCount)
            {
                foreach (key; keys[i])
                {
                    if (key.length == 0 || !(key in matAsset.props))
                        continue;
                    auto prop = matAsset.props[key];
                    if (prop.type != DPropType.String)
                        continue;
                    source.setTexture(i, prop.toString);
                    break;
                }
            }
        }
        return material;
    }

    // Keeps the source paths of materials and meshes valid when a file or a
    // directory is renamed in the asset browser. The scene file itself is
    // rewritten on the next save, so the scene is marked as modified.
    void onAssetRenamed(string oldPath, string newPath)
    {
        bool changed = false;

        foreach (material, ref source; materialSources)
        {
            String remapped = remapPath(source.path.toString, oldPath, newPath);
            if (remapped.length)
            {
                source.setPath(remapped.toString);
                // Texture paths are relative to the material file: they stay valid
                // only if the textures moved together with it
                foreach (i; 0 .. textureSlotCount)
                {
                    if (source.texture(i).length == 0)
                        continue;
                    String texture = String(source.texture(i)); // setTexture frees the original
                    source.setTexture(i, texture.toString);
                    texture.free();
                }
                changed = true;
            }
            remapped.free();

            // A renamed texture file: point the slot at the new name
            foreach (i; 0 .. textureSlotCount)
            {
                if (source.texture(i).length == 0)
                    continue;
                String texturePath = remapPath(source.texturePath(i), oldPath, newPath);
                if (texturePath.length)
                {
                    String relative = relativeTo(texturePath.toString, dirName(source.path.toString));
                    if (relative.length)
                    {
                        source.setTexture(i, relative.toString);
                        source.dirty = true;
                        changed = true;
                    }
                    relative.free();
                }
                texturePath.free();
            }
        }

        foreach (e, ref path; meshPaths)
        {
            String remapped = remapPath(path.toString, oldPath, newPath);
            if (remapped.length)
            {
                path.free();
                path = remapped;
                changed = true;
            }
            else
                remapped.free();
        }

        if (changed)
            markModified();
    }

    // Renames the file of a material (the file name is the material's identity).
    // The `name` property in the file is updated on the next save.
    bool renameMaterial(Material material, const(char)[] newName)
    {
        auto source = materialSource(material);
        if (source is null)
            return false;

        string oldPath = source.path.toString;
        if (newName == baseName(stripExtension(oldPath)))
            return false;

        if (!app.ui.assetBrowser.isValidAssetName(cast(string)newName))
        {
            logWarning("Cannot rename material: \"", newName, "\" is not a valid name");
            return false;
        }

        String newPath = String(dirName(oldPath));
        scope(exit) newPath.free();
        newPath ~= nativeSeparator;
        newPath ~= cast(string)newName;
        newPath ~= ".material";
        string newPathStr = newPath.toString;

        if (exists(newPathStr))
        {
            logWarning("Cannot rename material: \"", newPathStr, "\" already exists");
            return false;
        }

        try
        {
            std.file.rename(oldPath, newPathStr);
        }
        catch (Exception e)
        {
            logError("Cannot rename material \"", oldPath, "\": ", e.msg);
            return false;
        }

        logInfo("Renamed material \"", oldPath, "\" to \"", newPathStr, "\"");
        source.setPath(newPathStr); // invalidates oldPath
        markMaterialDirty(material); // writes the new `name` on save
        app.ui.assetBrowser.dir.scan();
        return true;
    }

    void markMaterialDirty(Material material)
    {
        if (auto source = materialSource(material))
        {
            source.dirty = true;
            markModified();
        }
    }

    // Writes a material back to its *.material file
    bool saveMaterial(Material material, MaterialSource source)
    {
        string path = source.path.toString;
        string[textureSlotCount] textures;
        foreach (i; 0..textureSlotCount)
            textures[i] = source.texture(i);
        try
        {
            writeMaterialFile(path, baseName(stripExtension(path)), material, textures[]);
            source.dirty = false;
            logInfo("Saved material \"", path, "\"");
            return true;
        }
        catch (Exception e)
        {
            logError("Cannot save material \"", path, "\": ", e.msg);
            return false;
        }
    }

    // Edited materials live in their own files: written along with the scene
    void saveDirtyMaterials()
    {
        foreach (material, ref source; materialSources)
        {
            if (source.dirty)
                saveMaterial(material, source);
        }
    }

    bool isImageFile(const(char)[] path)
    {
        const(char)[] ext = extension(path);
        char[16] buffer;
        if (ext.length == 0 || ext.length > buffer.length)
            return false;
        foreach (i, c; ext)
            buffer[i] = (c >= 'A' && c <= 'Z') ? cast(char)(c + 32) : c;
        return app.assetManager.textureLoader(cast(string)buffer[0..ext.length]) !is null;
    }

    // Creates a new *.material file in the directory currently shown by the
    // asset browser and assigns it to the target entity (if any)
    Material createMaterial(Entity target)
    {
        if (!app.ui.assetBrowser.active)
        {
            logWarning("Cannot create a material: save the scene first");
            return null;
        }

        string directory = app.ui.assetBrowser.dir.currentPath;
        char[16] number;
        int numberLength;
        String path;
        scope(exit) path.free();
        uint index = 0;
        while (true)
        {
            numberLength = snprintf(number.ptr, number.length, "%u", index);
            path.free();
            path = String(directory);
            path ~= nativeSeparator;
            path ~= "material";
            path ~= cast(string)number[0 .. numberLength];
            path ~= ".material";
            if (!exists(path.toString))
                break;
            index++;
        }

        try
        {
            // A stub is enough: after loading, the file is rewritten with the
            // engine's default values filled in
            String stub = String("name: \"material");
            scope(exit) stub.free();
            stub ~= cast(string)number[0 .. numberLength];
            stub ~= "\";\n";
            writeFileBytes(path.toString, stub.toString);
        }
        catch (Exception e)
        {
            logError("Cannot create material \"", path.toString, "\": ", e.msg);
            return null;
        }

        Material material = loadMaterial(path.toString);
        if (material is null)
            return null;
        if (auto source = materialSource(material))
            saveMaterial(material, source);

        if (target !is null)
            target.material = material;
        markModified();

        app.ui.assetBrowser.dir.scan();
        logInfo("Created material \"", path.toString, "\"");
        return material;
    }

    // Puts an image from the asset browser into a texture slot of a material
    bool applyTextureAsset(string assetPath, Material material, TextureSlot slot)
    {
        auto source = materialSource(material);
        if (source is null)
        {
            logWarning("Cannot apply texture \"", assetPath, "\": the material has no source file");
            return false;
        }

        // The path comes from the asset browser: absolute and normalized
        if (!isImageFile(assetPath))
        {
            logWarning("Cannot apply \"", assetPath, "\": not a supported image format");
            return false;
        }

        auto textureAsset = scene.addTextureAsset(assetPath, true);
        if (textureAsset is null || textureAsset.texture is null || !textureAsset.texture.valid)
        {
            logError("Cannot load texture \"", assetPath, "\"");
            return false;
        }

        // MaterialAsset resolves texture paths relative to the material's directory,
        // so the path must be relative (not possible across drives on Windows)
        String relative = relativeTo(assetPath, dirName(source.path.toString));
        scope(exit) relative.free();
        if (relative.length == 0)
        {
            logWarning("Cannot apply texture \"", assetPath, "\": it must be on the same drive as the material");
            return false;
        }

        setTextureInSlot(material, slot, textureAsset.texture);
        source.setTexture(slot, relative.toString);
        app.materialPreviewRenderer.invalidate(material);
        markMaterialDirty(material);
        logInfo("Applied texture \"", assetPath, "\" to ", textureSlotLabels[slot]);
        return true;
    }

    void clearTextureSlot(Material material, TextureSlot slot)
    {
        auto source = materialSource(material);
        if (source is null)
            return;
        setTextureInSlot(material, slot, null);
        source.setTexture(slot, "");
        app.materialPreviewRenderer.invalidate(material);
        markMaterialDirty(material);
    }

    Mesh loadMesh(string assetPath)
    {
        assetPath = normalizeAssetPath(assetPath);
        auto objAsset = scene.addOBJAsset(assetPath, true);
        if (objAsset.mesh is null)
        {
            logError("Cannot load mesh \"", assetPath, "\": asset failed to load");
            return null;
        }
        return objAsset.mesh;
    }

    bool applyMaterialAsset(string assetPath, Entity target)
    {
        if (target is null)
        {
            logWarning("Cannot apply material \"", assetPath, "\": no entity is selected");
            return false;
        }

        if (extension(assetPath) != ".material")
        {
            logWarning("Cannot apply \"", assetPath, "\" as a material: not a .material file");
            return false;
        }

        Material mat = loadMaterial(assetPath);
        if (mat is null)
            return false;

        target.material = mat;
        markModified();
        logInfo("Applied material \"", assetPath, "\" to entity \"", target.name, "\"");
        return true;
    }

    bool importAsset(string assetPath)
    {
        assetPath = normalizeAssetPath(assetPath);
        string ext = assetPath.extension;
        if (ext == ".obj")
        {
            auto objAsset = scene.addOBJAsset(assetPath, true);
            auto newEntity = scene.addEntity(scene.sceneRoot);
            if (objAsset.mesh)
            {
                newEntity.drawable = objAsset.mesh;
                setMeshPath(newEntity, assetPath);
            }
            
            newEntity.position = Vector3f(0, 0, 0);
            newEntity.name = genUniqueEntitytName();
            selectEntity(newEntity);
            markModified();
            return true;
        }
        if (ext == ".material")
        {
            return applyMaterialAsset(assetPath, selectedEntity);
        }

        // TODO: glTF import

        return false;
    }

    bool isSerializableEntity(Entity e)
    {
        return !scene.isInternalEntity(e) && e !is scene.sceneRoot && !isDeleted(e);
    }

    void saveScene(string filename)
    {
        app.setCursor(SystemCursor.Wait);

        filename = buildNormalizedPath(absolutePath(filename));
        setAssetRoot(filename.dirName, false);

        saveDirtyMaterials();

        Array!Entity saved;
        auto entityIndex = dict!(size_t, Entity);
        Array!string materialList;
        auto materialIndex = dict!(long, string); // asset path -> index in materialList
        scope(exit)
        {
            saved.free();
            materialList.free();
            Delete(entityIndex);
            Delete(materialIndex);
        }

        // Index the entities that go into the file
        foreach (e; scene.world.entities)
        {
            if (isSerializableEntity(e))
            {
                entityIndex[e] = saved.length;
                saved.append(e);
            }
        }

        // Each distinct material file is written once. The strings are slices of
        // MaterialSource paths, which are not modified until the save is over.
        foreach (e; saved.data)
        {
            if (e.material is null)
                continue;
            if (auto source = e.material in materialSources)
            {
                string materialPath = source.path.toString;
                if ((materialPath in materialIndex) is null)
                {
                    materialIndex[materialPath] = cast(long)materialList.length;
                    materialList.append(materialPath);
                }
            }
        }

        JSONWriter w;
        scope(exit) w.free();

        w.beginObject();
        w.add("name", scene.name);
        w.add("version", scene.fileVersion);

        w.key("materials");
        w.beginArray();
        foreach (materialPath; materialList.data)
        {
            w.beginObject();
            w.add("path", makeSceneAssetPath(materialPath));
            w.endObject();
        }
        w.endArray();

        w.key("entities");
        w.beginArray();
        foreach (e; saved.data)
        {
            long parentIndex = -1;
            if (e.parent !is null)
            {
                if (auto p = e.parent in entityIndex)
                    parentIndex = cast(long)*p;
            }

            long materialRef = -1;
            if (e.material !is null)
            {
                bool found = false;
                if (auto source = e.material in materialSources)
                {
                    string materialPath = source.path.toString;
                    if (auto idx = materialPath in materialIndex)
                    {
                        materialRef = *idx;
                        found = true;
                    }
                }
                if (!found)
                    logWarning("Material of entity \"", e.name, "\" has no source file and will not be saved");
            }

            string meshPath = "";
            if (auto mp = e in meshPaths)
                meshPath = makeSceneAssetPath(mp.toString);
            else if (e.drawable !is null)
                logWarning("Drawable of entity \"", e.name, "\" has no source file and will not be saved");

            w.beginObject();
            w.add("name", e.name);
            w.add("parent", parentIndex);
            w.add("mesh", meshPath);
            w.add("material", materialRef);
            w.add("layer", cast(uint)e.layer);
            w.add("type", cast(uint)e.type);
            w.add("renderLayer", e.renderLayer);
            w.add("visible", e.visible);
            w.add("castShadow", e.castShadow);
            w.add("solid", e.solid);
            w.add("dynamic", e.dynamic);
            w.add("decal", e.decal);
            w.add("probe", e.probe);
            w.addFloats("probeExtents", e.probeExtents.arrayof);
            w.add("probeFalloffMargin", e.probeFalloffMargin);
            w.add("probeUseBoxProjection", e.probeUseBoxProjection);
            w.add("transparent", e.transparent);
            w.add("opacity", e.opacity);
            w.addFloats("position", e.position.arrayof);
            w.addFloats("rotation", e.rotation.arrayof);
            w.addFloats("scaling", e.scaling.arrayof);

            if (auto light = cast(Light)e)
            {
                w.key("light");
                writeLight(w, light);
            }
            w.endObject();
        }
        w.endArray();

        auto renderer = app.deferredRenderer;
        auto pp = scene.app.postProcessingRenderer;

        w.key("postprocessing");
        w.beginObject();
        w.add("ssaoEnabled", scene.ssaoEnabled);
        w.add("ssaoRadius", renderer.ssaoRadius);
        w.add("ssaoSamples", renderer.ssaoSamples);
        w.add("ssaoPower", renderer.ssaoPower);
        w.add("ssaoDenoise", renderer.ssaoDenoise);
        w.add("dofEnabled", scene.depthOfFieldEnabled);
        w.add("dofAutofocus", pp.autofocus);
        w.add("dofFocalDepth", pp.focalDepth);
        w.add("dofFocalLength", pp.focalLength);
        w.add("dofFStop", pp.fStop);
        w.add("lensDistortionEnabled", scene.lensDistortionEnabled);
        w.add("lensDistortionDispersion", pp.lensDistortionDispersion);
        w.add("lensDistortionScale", pp.lensDistortionScale);
        w.add("glowEnabled", scene.glowEnabled);
        w.add("glowRadius", pp.glowRadius);
        w.add("glowThreshold", pp.glowThreshold);
        w.add("glowIntensity", pp.glowIntensity);
        w.add("motionBlurEnabled", scene.motionBlurEnabled);
        w.add("motionBlurSamples", pp.motionBlurSamples);
        w.add("motionBlurFramerate", pp.motionBlurFramerate);
        w.add("motionBlurRandomness", pp.motionBlurRandomness);
        w.add("motionBlurMinDistance", pp.motionBlurMinDistance);
        w.add("motionBlurMaxDistance", pp.motionBlurMaxDistance);
        w.add("motionBlurRadialBlurAmount", pp.radialBlurAmount);
        w.add("vignetteEnabled", scene.vignetteEnabled);
        w.add("hdrTonemapper", pp.tonemapper);
        w.add("hdrExposure", pp.exposure);
        w.add("fxaaEnabled", scene.fxaaEnabled);
        w.add("sharpeningEnabled", scene.sharpeningEnabled);
        w.add("filmGrainEnabled", scene.filmGrainEnabled);
        w.add("filmGrainColored", scene.filmGrainColored);
        w.endObject();

        w.endObject();
        w.finish();

        logInfo("Saving scene to \"", filename, "\"...");
        try
        {
            writeFileBytes(filename, w.text);
        }
        catch (Exception ex)
        {
            logError("Cannot save scene \"", filename, "\": ", ex.msg);
            app.setCursor(SystemCursor.Default);
            return;
        }
        sceneFilenameBuffer.set(filename);
        modified = false;

        app.ui.assetBrowser.reset(assetRoot, true);

        app.setCursor(SystemCursor.Default);
    }

    bool pendingNew = true;

    void newScene()
    {
        pendingNew = true;
        pendingOpenBuffer.clear();
        sceneFilenameBuffer.clear();
        app.ui.assetBrowser.active = false;
    }
    
    void openScene(string path)
    {
        pendingOpenBuffer.set(path);
        pendingNew = false;
        app.setCursor(SystemCursor.Wait);
    }

    // Former first half of openScene: validate before touching anything
    void loadSceneFile(string filename)
    {
        filename = buildNormalizedPath(absolutePath(filename));
        if (!exists(filename))
        {
            logError("Cannot open scene \"", filename, "\": file not found");
            return;
        }

        releasePendingDocument();

        // The parsed document refers to the text, so both live until the scene is populated
        ubyte[] buffer;
        JSONDocument document;
        try
        {
            buffer = readFileBytes(filename);
            document = New!JSONDocument(cast(string)buffer);
        }
        catch (Exception ex)
        {
            logError("Cannot open scene \"", filename, "\": ", ex.msg);
            if (buffer.length)
                Delete(buffer);
            return;
        }

        JSONValue root = document.root;
        JSONValue entities = jsonField(root, "entities");
        if (!document.isValid || root.type != JSONType.Object ||
            entities is null || entities.type != JSONType.Array)
        {
            logError("Cannot open scene \"", filename, "\": invalid scene file");
            Delete(document);
            Delete(buffer);
            return;
        }

        if (jsonGet(root, "version", 0L) > scene.fileVersion)
            logWarning("Scene \"", filename, "\" was saved by a newer editor version");

        logInfo("Opening scene \"", filename, "\"...");
        sceneFilenameBuffer.set(filename);
        setAssetRoot(filename.dirName);
        pendingDocument = document;
        pendingBuffer = buffer;
        switchTo(jsonGet(root, "name", "Scene").idup, &populatePending);
    }

    // Called by the new scene when it is ready
    void populatePending(EditorScene s)
    {
        if (pendingDocument is null)
            return;
        populateFromJson(pendingDocument.root);
        releasePendingDocument();
    }

    // Former second half of openScene, minus clearScene() and scene.name
    // `scene` is already the new scene here.
    void populateFromJson(JSONValue root)
    {
        // Materials first: entities refer to them by index
        Array!Material materials;
        scope(exit) materials.free();
        JSONValue materialsNode = jsonField(root, "materials");
        if (materialsNode !is null && materialsNode.type == JSONType.Array)
        {
            foreach (m; materialsNode.asArray.data)
            {
                string path = jsonGet(m, "path", "");
                materials.append((path.length > 0)? loadMaterial(path) : null);
            }
        }

        // Entities are created parents-first through addEntity(parent), so the
        // order in the file does not matter. A parent cycle is broken by
        // attaching the entity that closes it to the scene root.
        JSONValue[] entitiesArr = jsonField(root, "entities").asArray.data;
        Entity[] created = New!(Entity[])(entitiesArr.length);
        bool[] visiting = New!(bool[])(entitiesArr.length);
        created[] = null;
        visiting[] = false;
        scope(exit)
        {
            Delete(created);
            Delete(visiting);
        }

        Entity create(size_t i)
        {
            if (created[i] !is null)
                return created[i];
            if (visiting[i])
                return null; // cycle
            visiting[i] = true;

            JSONValue j = entitiesArr[i];

            Entity parent = scene.sceneRoot;
            long pi = jsonGet(j, "parent", -1L);
            if (pi >= 0 && cast(size_t)pi < entitiesArr.length)
            {
                Entity pe = create(cast(size_t)pi);
                if (pe !is null)
                    parent = pe;
            }

            Entity e;

            JSONValue lj = jsonField(j, "light");
            if (lj !is null && lj.type == JSONType.Object)
            {
                long lt = jsonGet(lj, "type", cast(long)LightType.AreaSphere);
                if (lt < LightType.AreaSphere || lt > LightType.Spot)
                    lt = LightType.AreaSphere;
                auto light = scene.addLight(cast(LightType)lt, parent);
                readLight(light, lj);
                e = light;
            }
            else
            {
                e = scene.addEntity(parent);
            }
            
            e.name = jsonGet(j, "name", "entity").idup; // Entity.name is a GC string
            e.layer = cast(EntityLayer)jsonGet(j, "layer", cast(long)e.layer);
            e.type = cast(typeof(e.type))jsonGet(j, "type", cast(long)e.type);
            e.renderLayer = cast(typeof(e.renderLayer))jsonGet(j, "renderLayer", cast(long)e.renderLayer);
            e.visible = jsonGet(j, "visible", e.visible);
            e.castShadow = jsonGet(j, "castShadow", e.castShadow);
            e.solid = jsonGet(j, "solid", e.solid);
            e.dynamic = jsonGet(j, "dynamic", e.dynamic);
            e.decal = jsonGet(j, "decal", e.decal);
            e.probe = jsonGet(j, "probe", e.probe);
            e.probeExtents = jsonVec3(j, "probeExtents", e.probeExtents);
            e.probeFalloffMargin = jsonGet(j, "probeFalloffMargin", e.probeFalloffMargin);
            e.probeUseBoxProjection = jsonGet(j, "probeUseBoxProjection", e.probeUseBoxProjection);
            e.transparent = jsonGet(j, "transparent", e.transparent);
            e.opacity = jsonGet(j, "opacity", e.opacity);
            e.position = jsonVec3(j, "position", e.position);
            e.rotation = jsonQuat(j, "rotation", e.rotation);
            e.scaling = jsonVec3(j, "scaling", e.scaling);

            string meshPath = jsonGet(j, "mesh", "");
            if (meshPath.length > 0)
            {
                meshPath = normalizeAssetPath(meshPath);
                Mesh mesh = loadMesh(meshPath);
                if (mesh !is null)
                {
                    e.drawable = mesh;
                    setMeshPath(e, meshPath);
                }
            }

            long mi = jsonGet(j, "material", -1L);
            if (mi >= 0 && cast(size_t)mi < materials.length && materials.data[cast(size_t)mi] !is null)
                e.material = materials.data[cast(size_t)mi];

            created[i] = e;
            visiting[i] = false;
            return e;
        }

        foreach (i; 0..entitiesArr.length)
            create(i);

        // Keep generated names unique with respect to the loaded ones
        foreach (e; created)
        {
            if (e !is null && e.name.startsWith("entity"))
            {
                string suffix = e.name[6..$];
                if (suffix.length > 0 && suffix.length < 9 && suffix.all!isDigit)
                    numEntities = max(numEntities, suffix.to!uint + 1);
            }
        }

        JSONValue postproc = jsonField(root, "postprocessing");
        if (postproc !is null && postproc.type == JSONType.Object)
        {
            auto renderer = app.deferredRenderer;
            auto pp = scene.app.postProcessingRenderer;
            
            scene.ssaoEnabled = jsonGet(postproc, "ssaoEnabled", scene.ssaoEnabled);
            renderer.ssaoEnabled = scene.ssaoEnabled;
            renderer.ssaoRadius = jsonGet(postproc, "ssaoRadius", renderer.ssaoRadius);
            renderer.ssaoSamples = jsonGet(postproc, "ssaoSamples", renderer.ssaoSamples);
            renderer.ssaoPower = jsonGet(postproc, "ssaoPower", renderer.ssaoPower);
            renderer.ssaoDenoise = jsonGet(postproc, "ssaoDenoise", renderer.ssaoDenoise);
            
            scene.depthOfFieldEnabled = jsonGet(postproc, "dofEnabled", scene.depthOfFieldEnabled);
            pp.depthOfFieldEnabled = scene.depthOfFieldEnabled;
            pp.autofocus = jsonGet(postproc, "dofAutofocus", pp.autofocus);
            pp.focalDepth = jsonGet(postproc, "dofFocalDepth", pp.focalDepth);
            pp.focalLength = jsonGet(postproc, "dofFocalLength", pp.focalLength);
            pp.fStop = jsonGet(postproc, "dofFStop", pp.fStop);
            
            scene.lensDistortionEnabled = jsonGet(postproc, "lensDistortionEnabled", scene.lensDistortionEnabled);
            pp.lensDistortionEnabled = scene.lensDistortionEnabled;
            pp.lensDistortionDispersion = jsonGet(postproc, "lensDistortionDispersion", pp.lensDistortionDispersion);
            pp.lensDistortionScale = jsonGet(postproc, "lensDistortionScale", pp.lensDistortionScale);
            
            scene.glowEnabled = jsonGet(postproc, "glowEnabled", scene.glowEnabled);
            pp.glowEnabled = scene.glowEnabled;
            pp.glowRadius = jsonGet(postproc, "glowRadius", pp.glowRadius);
            pp.glowThreshold = jsonGet(postproc, "glowThreshold", pp.glowThreshold);
            pp.glowIntensity = jsonGet(postproc, "glowIntensity", pp.glowIntensity);
            
            scene.motionBlurEnabled = jsonGet(postproc, "motionBlurEnabled", scene.motionBlurEnabled);
            pp.motionBlurEnabled = scene.motionBlurEnabled;
            pp.motionBlurSamples = jsonGet(postproc, "motionBlurSamples", pp.motionBlurSamples);
            pp.motionBlurFramerate = jsonGet(postproc, "motionBlurFramerate", pp.motionBlurFramerate);
            pp.motionBlurRandomness = jsonGet(postproc, "motionBlurRandomness", pp.motionBlurRandomness);
            pp.motionBlurMinDistance = jsonGet(postproc, "motionBlurMinDistance", pp.motionBlurMinDistance);
            pp.motionBlurMaxDistance = jsonGet(postproc, "motionBlurMaxDistance", pp.motionBlurMaxDistance);
            pp.radialBlurAmount = jsonGet(postproc, "motionBlurRadialBlurAmount", pp.radialBlurAmount);
            
            scene.vignetteEnabled = jsonGet(postproc, "vignetteEnabled", scene.vignetteEnabled);
            pp.vignette = scene.vignetteEnabled;
            
            pp.tonemapper = cast(Tonemapper)jsonGet(postproc, "hdrTonemapper", cast(uint)pp.tonemapper);
            pp.exposure = jsonGet(postproc, "hdrExposure", pp.exposure);
            
            scene.fxaaEnabled = jsonGet(postproc, "fxaaEnabled", scene.fxaaEnabled);
            pp.fxaaEnabled = scene.fxaaEnabled;
            
            scene.sharpeningEnabled = jsonGet(postproc, "sharpeningEnabled", scene.sharpeningEnabled);
            pp.sharpeningEnabled = scene.sharpeningEnabled;
            
            scene.filmGrainEnabled = jsonGet(postproc, "filmGrainEnabled", scene.filmGrainEnabled);
            scene.filmGrainColored = jsonGet(postproc, "filmGrainColored", scene.filmGrainColored);
            pp.filmGrainEnabled = scene.filmGrainEnabled;
            pp.filmGrainColored = scene.filmGrainColored;
        }
        
        logInfo("Loaded ", created.length.to!string, " entities");
        
        app.setCursor(SystemCursor.Default);
    }

    string genUniqueEntitytName()
    {
        string res = "entity" ~ numEntities.to!string;
        numEntities++;
        return res;
    }
}
