class EditorScene: Scene
{
    string name = "Scene";
    uint fileVersion = 100;
    
    EditorApp app;
    LoadingScreen loadingScreen;
    
    Camera camera;
    FreeviewComponent freeview;

    Entity sceneRoot;

    bool showSelectedEntityBoundingBox = true;
    
    bool ssaoEnabled = true;
    bool depthOfFieldEnabled = false;
    bool lensDistortionEnabled = false;
    bool glowEnabled = true;
    bool motionBlurEnabled = false;
    int glowRadius = 5;
    bool vignetteEnabled = false;
    int tonemapper = Tonemapper.AgX_Punchy;
    bool fxaaEnabled = true;
    bool sharpeningEnabled = true;
    bool filmGrainEnabled = false;
    bool filmGrainColored = true;
    
    bool floorGridEnabled = true;
    float floorGridSpacing = 1.0f;
    float floorGridExtent = 20.0f;
    
    Entity eSky;
    
    void delegate(EditorScene) onReady;

    this(EditorApp app)
    {
        super(app);
        this.app = app;
        onLoad(Time(0.0, 0.0), 0.0f);
    }

    override void beforeLoad()
    {
        app.setCursor(SystemCursor.Wait);
    }
    
    override void onLoad(Time t, float progress)
    {
    }
    
    override void afterLoad()
    {
        environment.backgroundColor = Color4f(0.5f, 0.5f, 0.5f, 1.0f);
        
        // TODO: read post-processing settings from scene file
        app.deferredRenderer.ssaoEnabled = ssaoEnabled;
        app.deferredRenderer.ssaoPower = 6.0;
        app.postProcessingRenderer.depthOfFieldEnabled = depthOfFieldEnabled;
        app.postProcessingRenderer.lensDistortionEnabled = lensDistortionEnabled;
        app.postProcessingRenderer.glowEnabled = glowEnabled;
        app.postProcessingRenderer.glowRadius = glowRadius;
        app.postProcessingRenderer.motionBlurEnabled = motionBlurEnabled;
        app.postProcessingRenderer.tonemapper = cast(Tonemapper)tonemapper;
        app.postProcessingRenderer.fxaaEnabled = fxaaEnabled;
        app.postProcessingRenderer.lutEnabled = false;
        
        camera = addCamera();
        freeview = New!FreeviewComponent(eventManager, camera);
        freeview.setZoom(5);
        freeview.setRotation(30.0f, -45.0f, 0.0f);
        freeview.translationStiffness = 0.25f;
        freeview.rotationStiffness = 0.25f;
        freeview.zoomStiffness = 0.25f;
        app.renderer.activeCamera = camera;
        camera.name = "Camera";

        sceneRoot = addEntity();
        sceneRoot.name = "SceneRoot";

        if (app.cubemap)
        {
            environment.ambientMap = app.cubemap;
            environment.ambientBRDF = app.deferredRenderer.brdf;
            
            eSky = addEntity();
            eSky.layer = EntityLayer.Background;
            eSky.gbufferMask = 0.0f;
            auto psync = New!PositionSync(eventManager, eSky, camera);
            eSky.drawable = New!ShapeBox(Vector3f(1.0f, 1.0f, 1.0f), assetManager);
            eSky.scaling = Vector3f(100.0f, 100.0f, 100.0f);
            eSky.material = addMaterial();
            eSky.material.depthWrite = false;
            eSky.material.useCulling = false;
            eSky.material.baseColorTexture = app.cubemap;
            eSky.material.linearColor = true;
            eSky.name = "Sky";
        }
        
        if (onReady)
            onReady(this);
        
        app.setCursor(SystemCursor.Default);
    }
    
    bool isInternalEntity(Entity e)
    {
        if (e is camera)
            return true;
        if (eSky && e is eSky)
            return true;
        return false;
    }
    
    override void onUpdate(Time t)
    {
    }
}

// Tolerant JSON readers. std.json can hand back a whole-number float as an integer,
// so numbers are accepted in any numeric form. Missing keys fall back to a default.
float jsonNum(JSONValue v, float def = 0.0f)
{
    switch (v.type)
    {
        case JSONType.float_:   return cast(float)v.floating;
        case JSONType.integer:  return cast(float)v.integer;
        case JSONType.uinteger: return cast(float)v.uinteger;
        default:                return def;
    }
}

T jsonGet(T)(JSONValue j, string key, T def)
{
    auto p = key in j;
    if (p is null)
        return def;
    
    static if (is(T == bool))
    {
        if (p.type == JSONType.true_) return true;
        if (p.type == JSONType.false_) return false;
        return def;
    }
    else static if (is(T == string))
    {
        return (p.type == JSONType.string)? p.str : def;
    }
    else static if (is(T == long))
    {
        if (p.type == JSONType.integer) return p.integer;
        if (p.type == JSONType.uinteger) return cast(long)p.uinteger;
        return def;
    }
    else static if (is(T == float))
    {
        return jsonNum(*p, def);
    }
    else static assert(false, "jsonGet: unsupported type " ~ T.stringof);
}

Vector3f jsonVec3(JSONValue j, string key, Vector3f def)
{
    auto p = key in j;
    if (p is null || p.type != JSONType.array || p.array.length < 3)
        return def;
    return Vector3f(jsonNum(p.array[0]), jsonNum(p.array[1]), jsonNum(p.array[2]));
}

Quaternionf jsonQuat(JSONValue j, string key, Quaternionf def)
{
    auto p = key in j;
    if (p is null || p.type != JSONType.array || p.array.length < 4)
        return def;
    return Quaternionf(jsonNum(p.array[0]), jsonNum(p.array[1]), jsonNum(p.array[2]), jsonNum(p.array[3]));
}

Color4f jsonColor(JSONValue j, string key, Color4f def)
{
    auto p = key in j;
    if (p is null || p.type != JSONType.array || p.array.length < 4)
        return def;
    return Color4f(jsonNum(p.array[0]), jsonNum(p.array[1]),
                   jsonNum(p.array[2]), jsonNum(p.array[3]));
}

JSONValue lightToJson(Light l)
{
    return JSONValue([
        "type": JSONValue(cast(uint)l.type),
        "shining": JSONValue(l.shining),
        "color": JSONValue(l.color.arrayof),
        "energy": JSONValue(l.energy),
        "angularRadius": JSONValue(l.angularRadius),
        "volumeRadius": JSONValue(l.volumeRadius),
        "radius": JSONValue(l.radius),
        "length": JSONValue(l.length),
        "spotOuterCutoff": JSONValue(l.spotOuterCutoff),
        "spotInnerCutoff": JSONValue(l.spotInnerCutoff),
        "shadowEnabled": JSONValue(l.shadowEnabled),
        "scatteringEnabled": JSONValue(l.scatteringEnabled),
        "scattering": JSONValue(l.scattering),
        "mediumDensity": JSONValue(l.mediumDensity),
        "scatteringSamples": JSONValue(l.scatteringSamples),
        "scatteringMaxRandomStepOffset": JSONValue(l.scatteringMaxRandomStepOffset),
        "scatteringUseShadow": JSONValue(l.scatteringUseShadow),
        "diffuse": JSONValue(l.diffuse),
        "specular": JSONValue(l.specular)
    ]);
}

void readLight(Light l, JSONValue j)
{
    l.shining = jsonGet(j, "shining", l.shining);
    l.color = jsonColor(j, "color", l.color);
    l.energy = jsonGet(j, "energy", l.energy);
    l.angularRadius = jsonGet(j, "angularRadius", l.angularRadius);
    l.volumeRadius = jsonGet(j, "volumeRadius", l.volumeRadius);
    l.radius = jsonGet(j, "radius", l.radius);
    l.length = jsonGet(j, "length", l.length);
    l.spotOuterCutoff = jsonGet(j, "spotOuterCutoff", l.spotOuterCutoff);
    l.spotInnerCutoff = jsonGet(j, "spotInnerCutoff", l.spotInnerCutoff);
    l.shadowEnabled = jsonGet(j, "shadowEnabled", l.shadowEnabled);
    l.scatteringEnabled = jsonGet(j, "scatteringEnabled", l.scatteringEnabled);
    l.scattering = jsonGet(j, "scattering", l.scattering);
    l.mediumDensity = jsonGet(j, "mediumDensity", l.mediumDensity);
    l.scatteringSamples = cast(uint)jsonGet(j, "scatteringSamples", cast(long)l.scatteringSamples);
    l.scatteringMaxRandomStepOffset = jsonGet(j, "scatteringMaxRandomStepOffset", l.scatteringMaxRandomStepOffset);
    l.scatteringUseShadow = jsonGet(j, "scatteringUseShadow", l.scatteringUseShadow);
    l.diffuse = jsonGet(j, "diffuse", l.diffuse);
    l.specular = jsonGet(j, "specular", l.specular);
}

/**
 * Implements scene editing and serialization.
 */
class Editor: EventListener
{
    string name = "DagonEditor";
    
    bool active = true;
    bool capturesMouse = false;
    
    EditorApp app;
    EditorScene scene;
    uint numEntities = 0;
    
    InteractionOverlay overlay;
    CommandHistory history;
    Entity selectedEntity;

    // Source asset paths. Meshes and materials are saved as references to these files
    string[Entity] meshPaths;
    string[Material] materialPaths;

    GsVirtualMachine vm;
    Dict!(GsDynamic, string) storage;
    GsDynamic[4] scriptCallArgs;
    
    this(EditorApp application)
    {
        super(application.eventManager, application);
        app = application;
        scene = cast(EditorScene)app.currentScene;
        
        // TODO: load editor.conf
        
        overlay = New!InteractionOverlay(eventManager, this);
        history = New!CommandHistory(this);
        history.onApplied = &onHistoryApplied;
        
        storage = dict!(GsDynamic, string);
        //set("addAsset", GsDynamic(&vmAddAsset));
        //set("addEntity", GsDynamic(&vmAddEntity));
        scriptCallArgs[0] = GsDynamic(this);
        
        vm = New!GsVirtualMachine(this);
        vm.set("log", GsDynamic(&vmLog));
        vm.set("logDebug", GsDynamic(&vmLogDebug));
        vm.set("logInfo", GsDynamic(&vmLogInfo));
        vm.set("logWarning", GsDynamic(&vmLogWarning));
        vm.set("logError", GsDynamic(&vmLogError));
        vm.set("logFatalError", GsDynamic(&vmLogFatalError));
        
        vm.load([
            GsInstruction(GsInstructionType.HALT)
        ]);
        
        compileScripts();
        
        vm.run();
    }

    void compileScripts()
    {
        foreach(string scriptPath; dirEntries("scripts", SpanMode.depth).filter!(f => f.name.endsWith(".gs")))
        {
            bool needToCompile = false;
            string bytecodePath = stripExtension(scriptPath) ~ ".gsc";
            
            if (exists(bytecodePath))
            {
                if (timeLastModified(scriptPath, SysTime.min) > timeLastModified(bytecodePath, SysTime.min))
                    needToCompile = true;
            }
            else
                needToCompile = true;
            
            GsInstruction[] prog;
            if (needToCompile)
            {
                logInfo("Compiling script \"", scriptPath, "\"...");
                string script = readText(scriptPath);
                prog = compile(script, scriptPath);
                auto code = saveBytecode(prog);
                std.file.write(bytecodePath, code);
            }
            else
            {
                logInfo("Loading \"", bytecodePath, "\"...");
                auto code = cast(ubyte[])std.file.read(bytecodePath);
                prog = loadBytecode(code);
            }
            
            auto lib = New!GsLibrary(bytecodePath, vm);
            //logInfo(prog);
            lib.load(prog);
            vm.spawn(lib);
        }
    }

    ~this()
    {
        Delete(storage);
    }
    
    // GScript VM API
    
    GsDynamic vmLog(GsDynamic[] args)
    {
        auto logLevel = cast(LogLevel)cast(uint)args[1].asNumber;
        auto message = args[2].toString;
        log(logLevel, message);
        return GsDynamic();
    }
    
    GsDynamic vmLogDebug(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logDebug(message);
        return GsDynamic();
    }
    
    GsDynamic vmLogInfo(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logInfo(message);
        return GsDynamic();
    }
    
    GsDynamic vmLogWarning(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logWarning(message);
        return GsDynamic();
    }
    
    GsDynamic vmLogError(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logError(message);
        return GsDynamic();
    }
    
    GsDynamic vmLogFatalError(GsDynamic[] args)
    {
        auto message = args[1].toString;
        logFatalError(message);
        return GsDynamic();
    }
    
    // GScript object API
    
    GsDynamic get(string key)
    {
        switch(key)
        {
            case "name":
                return GsDynamic(name);
            default:
                auto v = key in storage;
                if (v)
                    return *v;
                else
                    return GsDynamic();
        }
    }
    
    void set(string key, GsDynamic value)
    {
        storage[key] = value;
    }
    
    bool contains(string key)
    {
        switch(key)
        {
            case "name":
                return true;
            default:
                if ((key in storage) !is null)
                    return true;
                else
                    return false;
        }
    }
    
    void setPrototype(GsObject)
    {
        // No-op
    }

    // Selects the affected entity and refreshes gizmo and bounding box,
    // keeping the current gizmo mode
    void onHistoryApplied(Command command)
    {
        if (command.target is null)
            return;
        GizmoMode mode = overlay.gizmoMode;
        selectEntity(command.target);
        if (mode != GizmoMode.Disabled)
            overlay.gizmoMode = mode;
    }

    void undo()
    {
        if (!overlay.draggingGizmo)
            history.undo();
    }

    void redo()
    {
        if (!overlay.draggingGizmo)
            history.redo();
    }

    void update(Time t)
    {
        if (pendingNew)
        {
            pendingNew = false;
            switchTo("Scene", &populateDefault);
        }
        else if (pendingOpen.length > 0)
        {
            string path = pendingOpen;
            pendingOpen = "";
            loadSceneFile(path);
        }

        scene = cast(EditorScene)app.currentScene;
        if (scene is null || !scene.canRender)   // new scene is still loading
            return;

        overlay.activeCamera = app.renderer.activeCamera;
        
        processEvents();
        
        if (selectedEntity && !overlay.draggingGizmo)
        {
            overlay.gizmoPosition = selectedEntity.positionAbsolute;
            overlay.gizmoOrientation = selectedEntity.rotationAbsolute;
        }
        overlay.update(t);
        
        capturesMouse = overlay.draggingGizmo;
        scene.focused = !app.ui.capturesMouse && !capturesMouse;
        scene.freeview.active = scene.focused;
    }

    void switchTo(string name, void delegate(EditorScene) populate)
    {
        // Everything below refers to entities/materials of the scene being deleted
        selectedEntity = null;
        overlay.gizmoMode = GizmoMode.Disabled;
        history.clear();
        meshPaths.clear();
        materialPaths.clear();
        numEntities = 0;
        app.materialPreviewRenderer.clear();

        // The old camera dies with the old scene (deleted at the start of the next onUpdate)
        app.renderer.activeCamera = null;
        overlay.activeCamera = null;

        auto newScene = New!EditorScene(app);
        newScene.name = name;
        newScene.onReady = populate;
        scene = newScene; // loadMaterial/loadMesh use this
        app.setCurrentScene(newScene, true);
    }

    void populateDefault(EditorScene s)
    {
        auto sun = s.addLight(LightType.Sun, s.sceneRoot);
        sun.shadowEnabled = true;
        sun.energy = 10.0f;
        sun.angularRadius = 0.01f;
        sun.pitch(-45.0f);
        sun.name = "Sun";
    }

    void render()
    {
        if (app.ui.active)
            overlay.render();
    }

    void selectEntity(Entity e)
    {
        selectedEntity = e;
        overlay.gizmoMode = GizmoMode.Translation;
        overlay.gizmoPosition = e.positionAbsolute;
        overlay.gizmoOrientation = e.rotationAbsolute;
        if (e.drawable)
        {
            Mesh mesh = cast(Mesh)e.drawable;
            if (mesh)
            {
                overlay.selectionBoundingBoxBaseScale = mesh.boundingBox.size;
                overlay.selectionBoundingBoxBaseScale.x =
                    max(overlay.selectionBoundingBoxBaseScale.x, 0.1f);
                overlay.selectionBoundingBoxBaseScale.y =
                    max(overlay.selectionBoundingBoxBaseScale.y, 0.1f);
                overlay.selectionBoundingBoxBaseScale.z =
                    max(overlay.selectionBoundingBoxBaseScale.z, 0.1f);
            }
            else
            {
                overlay.selectionBoundingBoxBaseScale = Vector3f(1.0f, 1.0f, 1.0f);
            }
        }
        else
        {
            overlay.selectionBoundingBoxBaseScale = Vector3f(1.0f, 1.0f, 1.0f);
        }
        overlay.selectionBoundingBoxScale = Vector3f(
            overlay.selectionBoundingBoxBaseScale.x * abs(e.scaling.x),
            overlay.selectionBoundingBoxBaseScale.y * abs(e.scaling.y),
            overlay.selectionBoundingBoxBaseScale.z * abs(e.scaling.z));
    }

    void onAssetDroppedOnViewport(string assetPath)
    {
        logInfo("Import asset \"", assetPath, "\"...");
        importAsset(assetPath);
    }

    Material loadMaterial(string assetPath)
    {
        auto matAsset = scene.addMaterialAsset(assetPath, true);
        if (!matAsset.threadSafePartLoaded ||
            !matAsset.threadUnsafePartLoaded ||
            matAsset.material is null)
        {
            logError("Cannot load material \"", assetPath, "\": asset failed to load");
            return null;
        }
        materialPaths[matAsset.material] = assetPath;
        return matAsset.material;
    }

    Mesh loadMesh(string assetPath)
    {
        auto objAsset = scene.addOBJAsset(assetPath, true);
        if (objAsset.mesh is null)
        {
            logError("Cannot load mesh \"", assetPath, "\": asset failed to load");
            return null;
        }
        return objAsset.mesh;
    }

    bool applyMaterialAsset(string assetPath, Entity target)
    {
        if (target is null)
        {
            logWarning("Cannot apply material \"", assetPath, "\": no entity is selected");
            return false;
        }

        Material mat = loadMaterial(assetPath);
        if (mat is null)
            return false;

        target.material = mat;
        logInfo("Applied material \"", assetPath, "\" to entity \"", target.name, "\"");
        return true;
    }

    bool importAsset(string assetPath)
    {
        string ext = assetPath.extension;
        if (ext == ".obj")
        {
            auto objAsset = scene.addOBJAsset(assetPath, true);
            auto newEntity = scene.addEntity(scene.sceneRoot);
            if (objAsset.mesh)
            {
                newEntity.drawable = objAsset.mesh;
                meshPaths[newEntity] = assetPath;
            }
            
            newEntity.position = Vector3f(0, 0, 0);
            newEntity.name = genUniqueEntitytName();
            selectEntity(newEntity);
            return true;
        }
        if (ext == ".material")
        {
            return applyMaterialAsset(assetPath, selectedEntity);
        }

        // TODO: glTF import

        return false;
    }

    bool isSerializableEntity(Entity e)
    {
        return !scene.isInternalEntity(e) && e !is scene.sceneRoot;
    }

    void saveScene(string filename)
    {
        // Index the entities that go into the file
        Entity[] saved;
        size_t[Entity] entityIndex;
        foreach (e; scene.world.entities)
        {
            if (isSerializableEntity(e))
            {
                entityIndex[e] = saved.length;
                saved ~= e;
            }
        }

        // Serialize, writing each distinct material once
        JSONValue[] entitiesArr;
        JSONValue[] materialsArr;
        long[string] materialIndex; // asset path -> index in materialsArr
        entitiesArr.reserve(saved.length);

        foreach (e; saved)
        {
            long parentIndex = -1;
            if (e.parent !is null)
            {
                if (auto p = e.parent in entityIndex)
                    parentIndex = cast(long)*p;
            }

            long materialRef = -1;
            if (e.material !is null)
            {
                if (auto path = e.material in materialPaths)
                {
                    if (auto idx = *path in materialIndex)
                    {
                        materialRef = *idx;
                    }
                    else
                    {
                        materialRef = cast(long)materialsArr.length;
                        materialIndex[*path] = materialRef;
                        materialsArr ~= JSONValue(["path": JSONValue(*path)]);
                    }
                }
                else
                {
                    logWarning("Material of entity \"", e.name, "\" has no source file and will not be saved");
                }
            }

            string meshPath = "";
            if (auto mp = e in meshPaths)
                meshPath = *mp;
            else if (e.drawable !is null)
                logWarning("Drawable of entity \"", e.name, "\" has no source file and will not be saved");

            JSONValue je = JSONValue([
                "name": JSONValue(e.name),
                "parent": JSONValue(parentIndex),
                "mesh": JSONValue(meshPath),
                "material": JSONValue(materialRef),
                "layer": JSONValue(cast(uint)e.layer),
                "type": JSONValue(cast(uint)e.type),
                "renderLayer": JSONValue(e.renderLayer),
                "visible": JSONValue(e.visible),
                "castShadow": JSONValue(e.castShadow),
                "solid": JSONValue(e.solid),
                "dynamic": JSONValue(e.dynamic),
                "decal": JSONValue(e.decal),
                "probe": JSONValue(e.probe),
                "probeExtents": JSONValue(e.probeExtents.arrayof),
                "probeFalloffMargin": JSONValue(e.probeFalloffMargin),
                "probeUseBoxProjection": JSONValue(e.probeUseBoxProjection),
                "transparent": JSONValue(e.transparent),
                "opacity": JSONValue(e.opacity),
                "position": JSONValue(e.position.arrayof),
                "rotation": JSONValue(e.rotation.arrayof),
                "scaling": JSONValue(e.scaling.arrayof)
            ]);
            
            if (auto light = cast(Light)e)
                je["light"] = lightToJson(light);
            
            entitiesArr ~= je;
        }

        JSONValue root = [
            "name": JSONValue(scene.name),
            "version": JSONValue(scene.fileVersion),
            "materials": JSONValue(materialsArr),
            "entities": JSONValue(entitiesArr),
        ];
        logInfo("Saving scene to \"", filename, "\"...");
        write(filename, root.toPrettyString(JSONOptions.init | JSONOptions.doNotEscapeSlashes));
    }
    
    string pendingOpen;
    bool pendingNew = true;

    void newScene()               { pendingNew = true;  pendingOpen = ""; }
    void openScene(string path)   { pendingOpen = path; pendingNew = false; }

    // Former first half of openScene: validate before touching anything
    void loadSceneFile(string filename)
    {
        if (!exists(filename))
        {
            logError("Cannot open scene \"", filename, "\": file not found");
            return;
        }

        JSONValue root;
        try
        {
            root = parseJSON(readText(filename));
        }
        catch (Exception ex)
        {
            logError("Cannot open scene \"", filename, "\": ", ex.msg);
            return;
        }

        if (root.type != JSONType.object || ("entities" in root) is null || root["entities"].type != JSONType.array)
        {
            logError("Cannot open scene \"", filename, "\": invalid scene file");
            return;
        }

        if (jsonGet(root, "version", 0L) > scene.fileVersion)
            logWarning("Scene \"", filename, "\" was saved by a newer editor version");

        logInfo("Opening scene \"", filename, "\"...");
        switchTo(jsonGet(root, "name", "Scene"), (EditorScene s) { populateFromJson(root); });
    }

    // Former second half of openScene, minus clearScene() and scene.name
    // `scene` is already the new scene here.
    void populateFromJson(JSONValue root)
    {
        // Materials first: entities refer to them by index
        Material[] materials;
        if (auto mp = "materials" in root)
        {
            foreach (m; mp.array)
            {
                string path = jsonGet(m, "path", "");
                materials ~= (path.length > 0)? loadMaterial(path) : null;
            }
        }

        // Entities are created parents-first through addEntity(parent), so the
        // order in the file does not matter. A parent cycle is broken by
        // attaching the entity that closes it to the scene root.
        JSONValue[] entitiesArr = root["entities"].array;
        Entity[] created = new Entity[entitiesArr.length];
        bool[] visiting = new bool[entitiesArr.length];

        Entity create(size_t i)
        {
            if (created[i] !is null)
                return created[i];
            if (visiting[i])
                return null; // cycle
            visiting[i] = true;

            JSONValue j = entitiesArr[i];

            Entity parent = scene.sceneRoot;
            long pi = jsonGet(j, "parent", -1L);
            if (pi >= 0 && cast(size_t)pi < entitiesArr.length)
            {
                Entity pe = create(cast(size_t)pi);
                if (pe !is null)
                    parent = pe;
            }

            Entity e;

            JSONValue* lj = "light" in j;
            if (lj !is null && lj.type == JSONType.object)
            {
                long lt = jsonGet(*lj, "type", cast(long)LightType.AreaSphere);
                if (lt < LightType.AreaSphere || lt > LightType.Spot)
                    lt = LightType.AreaSphere;
                auto light = scene.addLight(cast(LightType)lt, parent);
                readLight(light, *lj);
                e = light;
            }
            else
            {
                e = scene.addEntity(parent);
            }
            
            e.name = jsonGet(j, "name", "entity");
            e.layer = cast(EntityLayer)jsonGet(j, "layer", cast(long)e.layer);
            e.type = cast(typeof(e.type))jsonGet(j, "type", cast(long)e.type);
            e.renderLayer = cast(typeof(e.renderLayer))jsonGet(j, "renderLayer", cast(long)e.renderLayer);
            e.visible = jsonGet(j, "visible", e.visible);
            e.castShadow = jsonGet(j, "castShadow", e.castShadow);
            e.solid = jsonGet(j, "solid", e.solid);
            e.dynamic = jsonGet(j, "dynamic", e.dynamic);
            e.decal = jsonGet(j, "decal", e.decal);
            e.probe = jsonGet(j, "probe", e.probe);
            e.probeExtents = jsonVec3(j, "probeExtents", e.probeExtents);
            e.probeFalloffMargin = jsonGet(j, "probeFalloffMargin", e.probeFalloffMargin);
            e.probeUseBoxProjection = jsonGet(j, "probeUseBoxProjection", e.probeUseBoxProjection);
            e.transparent = jsonGet(j, "transparent", e.transparent);
            e.opacity = jsonGet(j, "opacity", e.opacity);
            e.position = jsonVec3(j, "position", e.position);
            e.rotation = jsonQuat(j, "rotation", e.rotation);
            e.scaling = jsonVec3(j, "scaling", e.scaling);

            string meshPath = jsonGet(j, "mesh", "");
            if (meshPath.length > 0)
            {
                Mesh mesh = loadMesh(meshPath);
                if (mesh !is null)
                {
                    e.drawable = mesh;
                    meshPaths[e] = meshPath;
                }
            }

            long mi = jsonGet(j, "material", -1L);
            if (mi >= 0 && cast(size_t)mi < materials.length && materials[cast(size_t)mi] !is null)
                e.material = materials[cast(size_t)mi];

            created[i] = e;
            visiting[i] = false;
            return e;
        }

        foreach (i; 0..entitiesArr.length)
            create(i);

        // Keep generated names unique with respect to the loaded ones
        foreach (e; created)
        {
            if (e !is null && e.name.startsWith("entity"))
            {
                string suffix = e.name[6..$];
                if (suffix.length > 0 && suffix.length < 9 && suffix.all!isDigit)
                    numEntities = max(numEntities, suffix.to!uint + 1);
            }
        }

        logInfo("Loaded ", created.length.to!string, " entities");
    }

    string genUniqueEntitytName()
    {
        string res = "entity" ~ numEntities.to!string;
        numEntities++;
        return res;
    }
}

class EditorApp: Game
{
    EditorUI ui;
    Editor editor;
    
    MaterialPreviewRenderer materialPreviewRenderer;
    
    TextureAsset aFileIcon;
    TextureAsset aFolderIcon;
    TextureAsset aArchiveIcon;
    TextureAsset aAudioIcon;
    TextureAsset aBlendIcon;
    TextureAsset aJsonIcon;
    TextureAsset aModelIcon;
    TextureAsset aTranslateIcon;
    TextureAsset aRotateIcon;
    TextureAsset aScaleIcon;
    TextureAsset aboutImage;
    
    TextureAsset aEnvmap;
    Texture cubemap;
    
    TextureAsset loadTexture(string path, bool generateMipmaps = false)
    {
        TextureAsset asset = New!TextureAsset(assetManager);
        asset.generateMipmaps = generateMipmaps;
        assetManager.preloadAsset(asset, path);
        return asset;
    }
    
    Texture prepareUiTexture(Texture tex)
    {
        tex.minFilter = GL_LINEAR;
        tex.magFilter = GL_LINEAR;
        tex.bind();
        tex.unbind();
        return tex;
    }
    
    this(uint w, uint h, bool fullscreen, string title, string[] args)
    {
        super(w, h, fullscreen, title, args);
        
        setCursor(SystemCursor.Wait);
        
        materialPreviewRenderer = New!MaterialPreviewRenderer(this);
        
        aFileIcon = loadTexture("data/icons/file.png");
        aFolderIcon = loadTexture("data/icons/folder.png");
        aArchiveIcon = loadTexture("data/icons/archive.png");
        aAudioIcon = loadTexture("data/icons/audio.png");
        aBlendIcon = loadTexture("data/icons/blend.png");
        aJsonIcon = loadTexture("data/icons/json.png");
        aModelIcon = loadTexture("data/icons/model.png");
        aTranslateIcon = loadTexture("data/icons/btn_translate.png");
        aRotateIcon = loadTexture("data/icons/btn_rotate.png");
        aScaleIcon = loadTexture("data/icons/btn_scale.png");
        aboutImage = loadTexture("data/splash.jpg");
        
        aEnvmap = loadTexture("data/envmaps/default.hdr");
        if (aEnvmap.loaded)
            cubemap = generateCubemap(1024, aEnvmap.texture, assetManager);
        else
            logWarning("Default environment map was not loaded");
        
        auto scene = New!EditorScene(this);
        currentScene = scene;
        
        editor = New!Editor(this);
        
        ui = New!EditorUI(this, editor, args);
        ui.iconFile = prepareUiTexture(aFileIcon.texture);
        ui.iconFolder = prepareUiTexture(aFolderIcon.texture);
        ui.iconArchive = prepareUiTexture(aArchiveIcon.texture);
        ui.iconAudio = prepareUiTexture(aAudioIcon.texture);
        ui.iconBlend = prepareUiTexture(aBlendIcon.texture);
        ui.iconJson = prepareUiTexture(aJsonIcon.texture);
        ui.iconModel = prepareUiTexture(aModelIcon.texture);
        ui.iconTranslate = prepareUiTexture(aTranslateIcon.texture);
        ui.iconRotate = prepareUiTexture(aRotateIcon.texture);
        ui.iconScale = prepareUiTexture(aScaleIcon.texture);
        ui.aboutImage = prepareUiTexture(aboutImage.texture);
        ui.thumbnailGenerator = New!ThumbnailGenerator(assetManager);
        eventManager.onProcessEvent = &ui.onProcessEvent;
        dynamicViewport = false; // The editor controls the viewport instead of the engine
        editor.overlay.ui = ui;
        
        ui.active = true;
    }
    
    override void onCustomResize(int x, int y, int width, int height)
    {
        if (!isWindowMinimized)
        {
            resizeRenderers(x, y, width, height);
        }
    }
    
    override void onUpdate(Time t)
    {
        editor.update(t);
        super.onUpdate(t);
        ui.update(t);
    }
    
    override void onRender()
    {
        if (!ui.active)
            return;
        
        bool isLoading = false;
        if (currentScene)
        {
            isLoading = currentScene.isLoading;
            if (currentScene.canRender && renderer)
            {
                renderer.render();
                editor.overlay.renderFloorGrid();
                postProcessingRenderer.render();
                presentRenderer.inputBuffer = postProcessingRenderer.outputBuffer;
                presentRenderer.render();
                hudRenderer.render();
                editor.render();
            }
        }

        if (!isLoading)
            ui.render();
    }
}
