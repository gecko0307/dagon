/*
 * Editor scene.
 */
module editor;

import std.algorithm;
import std.file: write;
import std.json;
import std.path;
import std.conv;

import dlib.core.memory;
import dlib.math.base;
import dlib.math.vector;
import dlib.image.color;

import dagon.core.bindings;
import dagon.core.logger;
import dagon.core.time;
import dagon.graphics.entity;
import dagon.graphics.camera;
import dagon.graphics.light;
import dagon.graphics.shapes;
import dagon.graphics.mesh;
import dagon.graphics.texture;
import dagon.resource.scene;
import dagon.resource.texture;
import dagon.resource.obj;
import dagon.game.game;
import dagon.game.loadingscreen;
import dagon.render.postproc;
import dagon.ui.freeview;
import dagon.ext.imgui;

import ui;
import overlay;
import thumbnail;
import materialpreview;
import history;

class EditorScene: Scene
{
    string name = "Scene";
    uint fileVersion = 100;
    
    EditorApp app;
    Camera camera;
    FreeviewComponent freeview;
    InteractionOverlay overlay;
    CommandHistory history;
    MaterialPreviewRenderer materialPreviewRenderer;
    
    LoadingScreen loadingScreen;

    TextureAsset aFileIcon;
    TextureAsset aFolderIcon;
    TextureAsset aArchiveIcon;
    TextureAsset aAudioIcon;
    TextureAsset aBlendIcon;
    TextureAsset aJsonIcon;
    TextureAsset aModelIcon;
    TextureAsset aTranslateIcon;
    TextureAsset aRotateIcon;
    TextureAsset aScaleIcon;
    TextureAsset aboutImage;

    TextureAsset aEnvmap;
    TextureAsset aBRDF;

    Entity sceneRoot;
    Entity selectedEntity;
    
    bool ssaoEnabled = true;
    bool depthOfFieldEnabled = false;
    bool lensDistortionEnabled = false;
    bool glowEnabled = false;
    bool motionBlurEnabled = false;
    int glowRadius = 5;
    int tonemapper = Tonemapper.AgX_Punchy;
    bool fxaaEnabled = true;

    uint numEntities = 0;

    this(EditorApp app)
    {
        super(app);
        this.app = app;
        
        overlay = New!InteractionOverlay(eventManager, this);
        
        history = New!CommandHistory(this);
        history.onApplied = &onHistoryApplied;
        
        loadingScreen = New!LoadingScreen(app, this);
        loadingScreen.progressbarCentered = true;
        onLoad(Time(0.0, 0.0), 0.0f);
    }

    override void beforeLoad()
    {
        aFileIcon = addTextureAsset("data/icons/file.png");
        aFileIcon.generateMipmaps = false;
        aFolderIcon = addTextureAsset("data/icons/folder.png");
        aFolderIcon.generateMipmaps = false;
        aArchiveIcon = addTextureAsset("data/icons/archive.png");
        aArchiveIcon.generateMipmaps = false;
        aAudioIcon = addTextureAsset("data/icons/audio.png");
        aAudioIcon.generateMipmaps = false;
        aBlendIcon = addTextureAsset("data/icons/blend.png");
        aBlendIcon.generateMipmaps = false;
        aJsonIcon = addTextureAsset("data/icons/json.png");
        aJsonIcon.generateMipmaps = false;
        aModelIcon = addTextureAsset("data/icons/model.png");
        aModelIcon.generateMipmaps = false;
        aTranslateIcon = addTextureAsset("data/icons/btn_translate.png");
        aTranslateIcon.generateMipmaps = false;
        aRotateIcon = addTextureAsset("data/icons/btn_rotate.png");
        aRotateIcon.generateMipmaps = false;
        aScaleIcon = addTextureAsset("data/icons/btn_scale.png");
        aScaleIcon.generateMipmaps = false;
        aboutImage = addTextureAsset("data/splash.jpg");
        aboutImage.generateMipmaps = false;
    }
    
    override void onLoad(Time t, float progress)
    {
        loadingScreen.update(t, progress);
        loadingScreen.render();
    }

    Texture prepareUiTexture(Texture tex)
    {
        tex.minFilter = GL_LINEAR;
        tex.magFilter = GL_LINEAR;
        tex.bind();
        tex.unbind();
        return tex;
    }
    
    override void afterLoad()
    {
        auto ui = this.app.ui;
        ui.iconFile = prepareUiTexture(aFileIcon.texture);
        ui.iconFolder = prepareUiTexture(aFolderIcon.texture);
        ui.iconArchive = prepareUiTexture(aArchiveIcon.texture);
        ui.iconAudio = prepareUiTexture(aAudioIcon.texture);
        ui.iconBlend = prepareUiTexture(aBlendIcon.texture);
        ui.iconJson = prepareUiTexture(aJsonIcon.texture);
        ui.iconModel = prepareUiTexture(aModelIcon.texture);
        ui.iconTranslate = prepareUiTexture(aTranslateIcon.texture);
        ui.iconRotate = prepareUiTexture(aRotateIcon.texture);
        ui.iconScale = prepareUiTexture(aScaleIcon.texture);
        ui.aboutImage = prepareUiTexture(aboutImage.texture);

        environment.backgroundColor = Color4f(0.5f, 0.5f, 0.5f, 1.0f);
        
        app.deferredRenderer.ssaoEnabled = ssaoEnabled;
        app.deferredRenderer.ssaoPower = 6.0;
        app.postProcessingRenderer.depthOfFieldEnabled = depthOfFieldEnabled;
        app.postProcessingRenderer.lensDistortionEnabled = lensDistortionEnabled;
        app.postProcessingRenderer.glowEnabled = glowEnabled;
        app.postProcessingRenderer.glowRadius = glowRadius;
        app.postProcessingRenderer.motionBlurEnabled = motionBlurEnabled;
        app.postProcessingRenderer.tonemapper = cast(Tonemapper)tonemapper;
        app.postProcessingRenderer.fxaaEnabled = fxaaEnabled;
        app.postProcessingRenderer.lutEnabled = false;
        
        camera = addCamera();
        freeview = New!FreeviewComponent(eventManager, camera);
        freeview.setZoom(5);
        freeview.setRotation(30.0f, -45.0f, 0.0f);
        freeview.translationStiffness = 0.25f;
        freeview.rotationStiffness = 0.25f;
        freeview.zoomStiffness = 0.25f;
        app.renderer.activeCamera = camera;
        overlay.activeCamera = camera;
        camera.name = "Camera";

        auto sun = addLight(LightType.Sun);
        sun.shadowEnabled = true;
        sun.energy = 10.0f;
        sun.angularRadius = 0.01f;
        sun.pitch(-45.0f);
        sun.name = "Sun";
        
        sceneRoot = addEntity();
        sceneRoot.name = "SceneRoot";

        materialPreviewRenderer = New!MaterialPreviewRenderer(this);

        ui.active = true;
    }
    
    override void onUpdate(Time t)
    {
        freeview.active = focused && !overlay.draggingGizmo;
        if (selectedEntity && !overlay.draggingGizmo)
        {
            overlay.gizmoPosition = selectedEntity.positionAbsolute;
            overlay.gizmoOrientation = selectedEntity.rotationAbsolute;
        }
        overlay.update(t);
    }
    
    override void afterRender()
    {
        overlay.render();
    }

    bool importAsset(string assetPath)
    {
        string ext = assetPath.extension;
        if (ext == ".obj")
        {
            auto objAsset = addOBJAsset(assetPath, true);
            auto newEntity = addEntity(sceneRoot);
            if (objAsset.mesh)
                newEntity.drawable = objAsset.mesh;
            //newEntity.material = addMaterial(); // TODO: the user should explicitly create a new material or use an existing one
            newEntity.position = Vector3f(0, 0, 0);
            newEntity.name = genUniqueEntitytName();
            selectEntity(newEntity);
            return true;
        }
        if (ext == ".material")
        {
            return applyMaterialAsset(assetPath, selectedEntity);
        }

        // TODO: glTF import

        return false;
    }

    bool applyMaterialAsset(string assetPath, Entity target)
    {
        if (target is null)
        {
            logWarning("Cannot apply material \"", assetPath, "\": no entity is selected");
            return false;
        }

        auto matAsset = addMaterialAsset(assetPath, true);
        if (!matAsset.threadSafePartLoaded ||
            !matAsset.threadUnsafePartLoaded ||
            matAsset.material is null)
        {
            logError("Cannot apply material \"", assetPath, "\": asset failed to load");
            return false;
        }

        target.material = matAsset.material;
        logInfo("Applied material \"", assetPath, "\" to entity \"", target.name, "\"");
        return true;
    }

    string genUniqueEntitytName()
    {
        string res = "entity" ~ numEntities.to!string;
        numEntities++;
        return res;
    }

    void onAssetDroppedOnViewport(string assetPath)
    {
        logInfo("Import asset \"", assetPath, "\"...");
        importAsset(assetPath);
    }
    
    void selectEntity(Entity e)
    {
        selectedEntity = e;
        overlay.gizmoMode = GizmoMode.Translation;
        overlay.gizmoPosition = e.positionAbsolute;
        overlay.gizmoOrientation = e.rotationAbsolute;
        if (e.drawable)
        {
            Mesh mesh = cast(Mesh)e.drawable;
            if (mesh)
            {
                overlay.selectionBoundingBoxBaseScale = mesh.boundingBox.size;
                overlay.selectionBoundingBoxBaseScale.x =
                    max(overlay.selectionBoundingBoxBaseScale.x, 0.1f);
                overlay.selectionBoundingBoxBaseScale.y =
                    max(overlay.selectionBoundingBoxBaseScale.y, 0.1f);
                overlay.selectionBoundingBoxBaseScale.z =
                    max(overlay.selectionBoundingBoxBaseScale.z, 0.1f);
            }
            else
            {
                overlay.selectionBoundingBoxBaseScale = Vector3f(1.0f, 1.0f, 1.0f);
            }
        }
        else
        {
            overlay.selectionBoundingBoxBaseScale = Vector3f(1.0f, 1.0f, 1.0f);
        }
        overlay.selectionBoundingBoxScale = Vector3f(
            overlay.selectionBoundingBoxBaseScale.x * abs(e.scaling.x),
            overlay.selectionBoundingBoxBaseScale.y * abs(e.scaling.y),
            overlay.selectionBoundingBoxBaseScale.z * abs(e.scaling.z));
    }
    
    // Undo/redo must not interfere with an active gizmo drag
    void undo()
    {
        if (!overlay.draggingGizmo)
            history.undo();
    }
    
    void redo()
    {
        if (!overlay.draggingGizmo)
            history.redo();
    }
    
    // Selects the affected entity and refreshes gizmo and bounding box,
    // keeping the current gizmo mode
    void onHistoryApplied(Command command)
    {
        if (command.target is null)
            return;
        GizmoMode mode = overlay.gizmoMode;
        selectEntity(command.target);
        if (mode != GizmoMode.Disabled)
            overlay.gizmoMode = mode;
    }
    
    void save(string filename)
    {
        JSONValue root = [
            "name": JSONValue(name),
            "version": JSONValue(fileVersion)
        ];
        write(filename, root.toPrettyString());
        logInfo("Scene saved to ", filename);
    }
    
    void open(string filename)
    {
        logDebug("TODO: open ", filename);
    }
    
    override void onKeyDown(int key) { }
    override void onKeyUp(int key) { }
    override void onMouseButtonDown(int button) { }
    override void onMouseButtonUp(int button) { }
}

class EditorApp: Game
{
    EditorUI ui;
    
    this(uint w, uint h, bool fullscreen, string title, string[] args)
    {
        super(w, h, fullscreen, title, args);
        auto scene = New!EditorScene(this);
        currentScene = scene;
        ui = New!EditorUI(this, scene, args);
        ui.thumbnailGenerator = New!ThumbnailGenerator(scene.assetManager);
        eventManager.onProcessEvent = &ui.onProcessEvent;
        dynamicViewport = false; // The editor controls the viewport instead of the engine
        scene.overlay.ui = ui;
    }
    
    override void onCustomResize(int x, int y, int width, int height)
    {
        if (!isWindowMinimized)
        {
            resizeRenderers(x, y, width, height);
        }
    }
    
    override void onUpdate(Time t)
    {
        super.onUpdate(t);
        ui.update(t);
        currentScene.focused = !ui.capturesMouse;
    }
    
    override void onRender()
    {
        super.onRender();
        ui.render();
    }
}
