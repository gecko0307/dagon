/*
 * GC-free path helpers: they return dlib Strings (the caller frees them)
 * or slices of their arguments, and never allocate with the GC.
 * Both '/' and '\' are accepted as separators on every platform.
 */
module pathutil;

import dlib.container.array;
import dlib.text.str;

version(Windows)
    enum char nativeSeparator = '\\';
else
    enum char nativeSeparator = '/';

bool isSeparator(char c)
{
    return c == '/' || c == '\\';
}

private bool isDriveSegment(const(char)[] s)
{
    return s.length == 2 && s[1] == ':';
}

private bool isAbsolutePath(const(char)[] p)
{
    return p.length > 0 && (isSeparator(p[0]) || (p.length >= 2 && p[1] == ':'));
}

private bool sameChar(char a, char b)
{
    if (isSeparator(a) && isSeparator(b))
        return true;
    version(Windows)
    {
        if (a >= 'A' && a <= 'Z')
            a = cast(char)(a + 32);
        if (b >= 'A' && b <= 'Z')
            b = cast(char)(b + 32);
    }
    return a == b;
}

private bool sameSegment(const(char)[] a, const(char)[] b)
{
    if (a.length != b.length)
        return false;
    foreach (i; 0 .. a.length)
    {
        if (!sameChar(a[i], b[i]))
            return false;
    }
    return true;
}

// Appends the segments of a path to `segments`, resolving "." and ".."
// (the segments are slices of `path`)
private void splitPath(ref Array!(const(char)[]) segments, const(char)[] path, bool absolute)
{
    size_t start = 0;
    foreach (i; 0 .. path.length + 1)
    {
        if (i < path.length && !isSeparator(path[i]))
            continue;

        const(char)[] segment = path[start .. i];
        start = i + 1;

        if (segment.length == 0 || segment == ".")
            continue;

        if (segment == "..")
        {
            bool canPop = segments.length > 0 &&
                segments.data[$ - 1] != ".." &&
                !(segments.length == 1 && isDriveSegment(segments.data[0]));
            if (canPop)
                segments.removeBack(1);
            else if (!absolute)
                segments.append(segment);
            continue;
        }

        segments.append(segment);
    }
}

/// Joins `base` and `relative` and resolves "." and ".." segments.
/// If `relative` is absolute, `base` is ignored. The result uses native separators.
String joinNormalized(const(char)[] base, const(char)[] relative)
{
    Array!(const(char)[]) segments;
    scope(exit) segments.free();

    bool relativeIsAbsolute = isAbsolutePath(relative);
    const(char)[] first = relativeIsAbsolute ? relative : base;
    bool absolute = isAbsolutePath(first);
    bool leadingSeparator = first.length > 0 && isSeparator(first[0]);

    if (!relativeIsAbsolute)
        splitPath(segments, base, absolute);
    splitPath(segments, relative, absolute);

    String result;
    if (leadingSeparator)
        result ~= nativeSeparator;
    foreach (i, segment; segments.data)
    {
        if (i > 0)
            result ~= nativeSeparator;
        result ~= cast(string)segment;
    }
    if (result.length == 0)
        result ~= ".";
    return result;
}

/// Path of `path` relative to the directory `baseDir`, with '/' separators.
/// Both paths must be absolute. Returns an empty String if there is no
/// relative path (different drives, relative input).
String relativeTo(const(char)[] path, const(char)[] baseDir)
{
    String result;
    if (!isAbsolutePath(path) || !isAbsolutePath(baseDir))
        return result;

    Array!(const(char)[]) target;
    Array!(const(char)[]) base;
    scope(exit)
    {
        target.free();
        base.free();
    }
    splitPath(target, path, true);
    splitPath(base, baseDir, true);

    // Different drives
    if ((target.length > 0 && isDriveSegment(target.data[0])) ||
        (base.length > 0 && isDriveSegment(base.data[0])))
    {
        if (target.length == 0 || base.length == 0 ||
            !sameSegment(target.data[0], base.data[0]))
            return result;
    }

    size_t common = 0;
    while (common < target.length && common < base.length &&
        sameSegment(target.data[common], base.data[common]))
        common++;

    bool first = true;
    foreach (i; common .. base.length)
    {
        if (!first)
            result ~= "/";
        result ~= "..";
        first = false;
    }
    foreach (i; common .. target.length)
    {
        if (!first)
            result ~= "/";
        result ~= cast(string)target.data[i];
        first = false;
    }
    if (result.length == 0)
        result ~= ".";
    return result;
}

/// If `path` is `oldPath` or lies inside the directory `oldPath`, returns
/// the corresponding path under `newPath`; otherwise returns an empty String.
String remapPath(const(char)[] path, const(char)[] oldPath, const(char)[] newPath)
{
    String result;

    while (oldPath.length > 1 && isSeparator(oldPath[$ - 1]))
        oldPath = oldPath[0 .. $ - 1];
    if (oldPath.length == 0 || path.length < oldPath.length)
        return result;

    foreach (i; 0 .. oldPath.length)
    {
        if (!sameChar(path[i], oldPath[i]))
            return result;
    }
    if (path.length > oldPath.length && !isSeparator(path[oldPath.length]) && !isSeparator(oldPath[$ - 1]))
        return result;

    result ~= cast(string)newPath;
    result ~= cast(string)path[oldPath.length .. $];
    return result;
}
