/*
 * Undo/redo command history.
 */
module history;

import dlib.core.memory;
import dlib.core.ownership;
import dlib.container.array;
import dlib.math.vector;
import dlib.math.quaternion;

import dagon.graphics.entity;
import dagon.graphics.light;

/// Local transformation of an entity at some point in time.
struct TransformSnapshot
{
    Vector3f position;
    Quaternionf rotation;
    Vector3f scaling;

    static TransformSnapshot capture(Entity entity)
    {
        TransformSnapshot s;
        s.position = entity.position;
        s.rotation = entity.rotation;
        s.scaling = entity.scaling;
        return s;
    }

    void apply(Entity entity)
    {
        entity.position = position;
        entity.rotation = rotation;
        entity.scaling = scaling;
    }

    bool sameAs(TransformSnapshot other)
    {
        return position.x == other.position.x &&
            position.y == other.position.y &&
            position.z == other.position.z &&
            rotation.x == other.rotation.x &&
            rotation.y == other.rotation.y &&
            rotation.z == other.rotation.z &&
            rotation.w == other.rotation.w &&
            scaling.x == other.scaling.x &&
            scaling.y == other.scaling.y &&
            scaling.z == other.scaling.z;
    }
}

/// A reversible editor action. The action is already applied when the
/// command is pushed to the history, so only undo/redo are needed.
abstract class Command
{
    string name;
    Entity target;

    this(string name, Entity target)
    {
        this.name = name;
        this.target = target;
    }

    abstract void undo();
    abstract void redo();
}

class TransformCommand: Command
{
    TransformSnapshot before;
    TransformSnapshot after;

    this(string name, Entity target, TransformSnapshot before, TransformSnapshot after)
    {
        super(name, target);
        this.before = before;
        this.after = after;
    }

    override void undo()
    {
        before.apply(target);
    }

    override void redo()
    {
        after.apply(target);
    }
}

/// Entity name change.
class RenameCommand: Command
{
    string before;
    string after;

    this(Entity target, string before, string after)
    {
        super("Rename", target);
        this.before = before;
        this.after = after;
    }

    override void undo()
    {
        target.name = before;
    }

    override void redo()
    {
        target.name = after;
    }
}

/// Removal or creation of an entity together with its children.
///
/// Entities are never freed while the scene is alive: removal is "soft",
/// the whole subtree is hidden (and lights switched off) and the root is
/// reported through `markDeleted`, so that the editor can skip it in the
/// inspector and the scene file. This keeps every Entity pointer held by
/// older commands valid and makes undo trivial.
///
/// `creation == false`: the command describes a deletion (use redo() to
/// perform it, then push). `creation == true`: the command describes an
/// entity that has just been created (just push; undo removes it).
class EntityLifetimeCommand: Command
{
    private Array!Entity entities;
    private Array!ubyte states; // bit 0: visible, bit 1: shining
    private bool creation;
    private void delegate(Entity, bool) markDeleted;

    this(string name, Entity target, bool creation, void delegate(Entity, bool) markDeleted)
    {
        super(name, target);
        this.creation = creation;
        this.markDeleted = markDeleted;
        collect(target);
    }

    ~this()
    {
        entities.free();
        states.free();
    }

    // Remembers the current state of the entity and all of its descendants
    private void collect(Entity e)
    {
        ubyte state = e.visible ? 1 : 0;
        if (auto light = cast(Light)e)
        {
            if (light.shining)
                state |= 2;
        }
        entities.append(e);
        states.append(state);
        foreach (child; e.children)
            collect(child);
    }

    private void hide()
    {
        foreach (e; entities.data)
        {
            e.visible = false;
            if (auto light = cast(Light)e)
                light.shining = false;
        }
        markDeleted(target, true);
    }

    private void restore()
    {
        foreach (i, e; entities.data)
        {
            ubyte state = states.data[i];
            e.visible = (state & 1) != 0;
            if (auto light = cast(Light)e)
                light.shining = (state & 2) != 0;
        }
        markDeleted(target, false);
    }

    override void undo()
    {
        if (creation)
            hide();
        else
            restore();
    }

    override void redo()
    {
        if (creation)
            restore();
        else
            hide();
    }
}

class CommandHistory: Owner
{
    enum size_t maxEntries = 256;

    // GC-free storage; the history owns the commands stored in it
    private Array!Command undoStack;
    private Array!Command redoStack;

    /// Called after a command has been undone or redone
    void delegate(Command) onApplied;

    this(Owner owner)
    {
        super(owner);
    }

    ~this()
    {
        clear();
        undoStack.free();
        redoStack.free();
    }

    bool canUndo() @property
    {
        return undoStack.length > 0;
    }

    bool canRedo() @property
    {
        return redoStack.length > 0;
    }

    string undoName() @property
    {
        return canUndo ? undoStack.data[$ - 1].name : "";
    }

    string redoName() @property
    {
        return canRedo ? redoStack.data[$ - 1].name : "";
    }

    void clear()
    {
        dropRedo();
        foreach (command; undoStack.data)
        {
            auto c = command;
            Delete(c);
        }
        undoStack.resize(0, null);
    }

    private void dropRedo()
    {
        foreach (command; redoStack.data)
        {
            auto c = command;
            Delete(c);
        }
        redoStack.resize(0, null);
    }

    /// Adds an already applied command. Takes ownership of it.
    void push(Command command)
    {
        dropRedo();
        undoStack.append(command);
        if (undoStack.length > maxEntries)
        {
            // Drop the oldest command and shift the rest down
            auto oldest = undoStack.data[0];
            Delete(oldest);
            foreach (i; 1 .. undoStack.length)
                undoStack.data[i - 1] = undoStack.data[i];
            undoStack.resize(undoStack.length - 1, null);
        }
    }

    /// Records a transformation change of an entity that has already
    /// happened. Does nothing if the transformation did not actually change.
    void pushTransform(string name, Entity entity, TransformSnapshot before)
    {
        TransformSnapshot after = TransformSnapshot.capture(entity);
        if (before.sameAs(after))
            return;
        push(New!TransformCommand(name, entity, before, after));
    }

    /// Records an entity rename that has already happened.
    /// Does nothing if the name did not actually change.
    void pushRename(Entity entity, string before)
    {
        if (before == entity.name)
            return;
        push(New!RenameCommand(entity, before, entity.name));
    }

    void undo()
    {
        if (!canUndo)
            return;
        Command command = undoStack.data[$ - 1];
        undoStack.resize(undoStack.length - 1, null);
        command.undo();
        redoStack.append(command);
        if (onApplied)
            onApplied(command);
    }

    void redo()
    {
        if (!canRedo)
            return;
        Command command = redoStack.data[$ - 1];
        redoStack.resize(redoStack.length - 1, null);
        command.redo();
        undoStack.append(command);
        if (onApplied)
            onApplied(command);
    }
}
