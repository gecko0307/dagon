module pathbuilder;

import std.stdio;
import std.algorithm;
import std.ascii;

import dlib.core.memory;
import dlib.core.ownership;
import dlib.container.array;
import dlib.text.str;

/**
 * Dynamic, GC-free path builder that allows to push/pop directory levels.
 */
class PathBuilder: Owner
{
   protected:
    version(Windows)
    {
        static immutable(char) _separator = '\\';
        static string _separatorString = "\\";
    }
    else version(Posix)
    {
        static immutable(char) _separator = '/';
        static string _separatorString = "/";
    }
    else
    {
        static immutable(char) _separator = '/'; // Fallback
        static string _separatorString = "/";
    }
    
    immutable char[] _separators = ['/', '\\'];
    String rootDir;
    Array!String _chain;
    bool _isAbsolute = false;
    uint _rootLevel = 0;
    
   public:
    
    /**
     * Constructs a PathBuilder.
     * rootDir is an immutable part of the path (cannot be removed).
     */
    this(string rootDir, Owner owner)
    {
        super(owner);
        reset(rootDir);
    }
    
    ///
    ~this()
    {
        release();
    }
    
    ///
    static string getParentDirectory(string path)
    {
        size_t pos = size_t.max;

        foreach (i, c; path)
        {
            if (c == '/' || c == '\\')
                pos = i;
        }

        if (pos == size_t.max)
            return ".";

        if (pos == 0)
            return path[0..1];

        if (pos == 2 && path.length >= 3 && path[1] == ':')
            return path[0..3];

        return path[0..pos];
    }

    /// Contructs a new `PathBuilder` for a parent directory of a given file.
    static PathBuilder fromFile(string filename, Owner owner)
    {
        return New!PathBuilder(getParentDirectory(filename), owner);
    }
    
    /// Returns true is the path is absolute.
    bool isAbsolute() const @property
    {
        return _isAbsolute;
    }
    
    /// Returns the platform-specific separator character.
    char separator() const @property
    {
        return _separator;
    }
    
    /// Returns the current directory depth.
    uint depth() const @property
    {
        return cast(uint)_chain.length;
    }
    
    /// Returns the root directory level (depends on the `rootPath`).
    uint rootLevel() const @property
    {
        return _rootLevel;
    }
    
    protected bool testIsAbsolute(string path)
    {
        version(Windows)
        {
            if (path.length >= 3)
            {
                return isAlpha(path[0]) &&
                       path[1] == ':' &&
                       (path[2] == '\\' || path[2] == '/');
            }
            else
                return false;
        }
        else version(Posix)
        {
            return path.startsWith(_separator);
        }
        else
        {
            return false;
        }
    }
    
    protected void release()
    {
        foreach(s; _chain)
            s.free();
        _chain.free();
        rootDir.free();
        _isAbsolute = false;
        _rootLevel = 0;
    }
    
    /**
     * Sets a new `rootDir`.
     */
    void reset(string rootDir)
    {
        if (rootDir == this.rootDir.toString)
            return;
        
        release();
        
        this.rootDir = String(rootDir);
        
        _isAbsolute = testIsAbsolute(rootDir);
        
        auto tokens = rootDir.splitter!(c => _separators.canFind(c));
        foreach(entry; tokens)
        {
            _chain.append(String(entry));
        }
        
        _rootLevel = depth;
    }
    
    /**
     * Sets a new `rootDir` as a parent directory of a given file.
     */
    void resetFromFile(string filename)
    {
        reset(getParentDirectory(filename));
    }
    
    /**
     * Goes one level deeper.
     */
    void push(string str)
    {
        if (_chain.length == 0)
        {
            _isAbsolute = testIsAbsolute(str);
        }
        
        auto tokens = str.splitter!(c => _separators.canFind(c));
        foreach (entry; tokens)
        {
            _chain.append(String(entry));
        }
    }
    
    /**
     * Removes a given number of directory levels
     * from the end of the path.
     */
    void pop(uint numLevels = 1)
    {
        while (numLevels && _chain.length > _rootLevel)
        {
            _chain[_chain.length - 1].free();
            _chain.removeBack(1);
            numLevels--;
        }

        if (_chain.length == 0)
            _isAbsolute = false;
    }
    
    /**
     * Constructs a platform-specific path string.
     * Postfix can be any string; it is usually a file name.
     */
    String getPath(string postfix = "")
    {
        String res = getSubPath(0);
        
        if (postfix.length)
        {
            if (res.length && res[$ - 1] != _separator)
                res ~= _separator;

            res ~= postfix;
        }
        
        return res;
    }
    
    /**
     * Constructs a platform-specific string
     * of a parent directory of the current path.
     */
    String getParentPath()
    {
        return getSubPath(1);
    }
    
    /**
     * Constructs a platform-specific subpath string
     * of a given levels higher than the current level.
     * Subpath cannot be higher level than `rootPath`.
     */
    String getSubPath(uint levelsUp)
    {
        String res;

        uint currentDepth = depth;

        // Protect the root directory.
        if (currentDepth < _rootLevel)
            currentDepth = _rootLevel;

        uint maxLevelsUp = currentDepth - _rootLevel;

        if (levelsUp > maxLevelsUp)
            levelsUp = maxLevelsUp;

        uint endLevel = currentDepth - levelsUp;

        version(Posix)
        {
            if (isAbsolute)
                res ~= _separator;
        }

        foreach(i, entry; _chain)
        {
            if (i >= endLevel)
                break;

            if (i > 0)
                res ~= _separator;

            res ~= entry.toString;
        }

        return res;
    }
    
    /**
     * Iterating over the path levels via foreach.
     */
    int opApply(scope int delegate(size_t, string) dg)
    {
        size_t offset = 0;
        int result = 0;

        version(Posix)
        {
            if (isAbsolute)
            {
                result = dg(0, _separatorString);
                if (result)
                    return result;

                offset = 1;
            }
        }

        foreach(i, ref v; _chain.data)
        {
            result = dg(i + offset, v.toString);
            if (result)
                break;
        }

        return result;
    }
}
