module assetdir;

import std.stdio;
import std.algorithm;

import dlib.core.memory;
import dlib.core.ownership;
import dlib.container.array;
import dlib.container.sorting;
import dlib.filesystem.filesystem;
import dlib.filesystem.stdfs: StdFileSystem;
import dlib.text.str;

import dagon.core.logger;
import dagon.graphics.texture;

import pathbuilder;

/**
 * Represents a local file or a folder.
 * AssetEntry references live until the next `AssetDirectory.scan` and should not be
 * permanently stored anywhere. They are only for one-time access from `AssetDirectory.contents`
 * (for enumeration, existence check, and UI rendering).
 */
class AssetEntry
{
    String name;         // Base file/folder name of the entry
    String localPath;    // Relative to the scene's asset root: "localFolder/file.png"
    String absPath;      // For example, "C:/projects/game/scenes/level0/localFolder/file.png" under Windows
    bool isDirectory;
    ulong size;
    Texture thumbnail;   // Owned by ThumbnailGenerator. Null until the thumbnail is ready (or if it failed)
    bool thumbnailValid; // true when the thumbnail request is resolved (ready or failed): stop asking the generator
    int thumbnailId = -1; // ThumbnailGenerator entry id, -1 if not requested yet
    
    ~this()
    {
        name.free();
        localPath.free();
        absPath.free();
    }
    
    override string toString()
    {
        return absPath.toString();
    }
}

/**
 * A database that mirrors contents of a directory.
 */
class AssetDirectory: Owner
{
   protected:
    StdFileSystem _stdfs;
    PathBuilder _pathBuilder;
    String _currentPath;
    Directory _currentDir;
    Array!AssetEntry _entries;
    
   public:
    this(StdFileSystem stdfs, string scenePath, Owner owner)
    {
        super(owner);
        _stdfs = stdfs;
        _pathBuilder = PathBuilder.fromFile(scenePath, this);
        _currentPath = _pathBuilder.getPath();
        _currentDir = _stdfs.openDir(currentPath);
    }
    
    void reset(string scenePath)
    {
        release();
        _pathBuilder.resetFromFile(scenePath);
        _currentPath = _pathBuilder.getPath();
        _currentDir = _stdfs.openDir(currentPath);
    }
    
    void resetDir(string rootPath)
    {
        release();
        _pathBuilder.reset(rootPath);
        _currentPath = _pathBuilder.getPath();
        _currentDir = _stdfs.openDir(currentPath);
    }
    
    ~this()
    {
        release();
    }
    
    protected void release()
    {
        _currentPath.free();
        _currentDir = null;
        clearEntries();
    }
    
    protected void clearEntries()
    {
        foreach(assetEntry; _entries)
            Delete(assetEntry);
        _entries.free();
    }
    
    string currentPath() const @property
    {
        return _currentPath.toString;
    }
    
    Directory currentDir() @property
    {
        return _currentDir;
    }
    
    String getPath(string postfix = "")
    {
        return _pathBuilder.getPath(postfix);
    }
    
    AssetEntry[] contents() @property
    {
        return _entries.data;
    }
    
    AssetEntry[] contentsSorted() @property
    {
        auto data = _entries.data;
        insertionSort!((a, b) {
            if (a.isDirectory != b.isDirectory)
                return a.isDirectory;
            return a.name.toString < b.name.toString;
        })(data);
        return data;
    }
    
    void up()
    {
        release();
        _pathBuilder.pop(1);
        _currentPath = _pathBuilder.getPath();
        _currentDir = _stdfs.openDir(currentPath);
        scan();
    }
    
    void open(string dirname)
    {
        logDebug("Opening \"", dirname, "\"");
        _pathBuilder.push(dirname);
        _currentPath.free();
        _currentPath = _pathBuilder.getPath();
        _currentDir = _stdfs.openDir(currentPath);
        scan();
    }
    
    /// Scans the current directory and rebuild the entries array.
    void scan()
    {
        clearEntries();
        
        foreach(DirEntry entry; _currentDir.contents())
        {
            string name = entry.name;
            AssetEntry assetEntry = New!AssetEntry();
            assetEntry.name = String(entry.name);
            assetEntry.localPath = _pathBuilder.getLocalPath(entry.name);
            assetEntry.absPath = _pathBuilder.getPath(entry.name);
            assetEntry.isDirectory = entry.isDirectory;
            
            FileStat stat;
            if (_stdfs.stat(assetEntry.absPath.toString, stat))
                assetEntry.size = stat.sizeInBytes;
            
            _entries.append(assetEntry);
        }
    }
}
