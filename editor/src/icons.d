class IconDatabase: Owner
{
    private AssetManager assetManager;
    private Texture[iconKindCount] textures;
    private bool[iconKindCount] attempted;

    this(AssetManager assetManager, Owner owner)
    {
        super(owner);
        this.assetManager = assetManager;
    }

    /// Loads the icons that are used in almost every folder.
    void preloadCommon()
    {
        get(IconKind.File);
        get(IconKind.Folder);
        get(IconKind.Image);
        get(IconKind.Model);
    }

    /// Determines the icon kind from a file name. Never loads anything.
    static IconKind kindForFile(const(char)[] filename)
    {
        const(char)[] ext = extension(filename);
        if (ext.length == 0 || ext.length > 16)
            return IconKind.File;

        char[16] lower;
        foreach (i, c; ext)
            lower[i] = (c >= 'A' && c <= 'Z') ? cast(char)(c + 32) : c;
        const(char)[] key = lower[0 .. ext.length];

        foreach (ref entry; extensionIcons)
        {
            if (entry.ext == key)
                return entry.kind;
        }
        return IconKind.File;
    }

    /**
     * Returns the icon texture, loading it on first use. If the icon file cannot be
     * loaded, falls back to the generic file icon (which may itself be null).
     */
    Texture get(IconKind kind)
    {
        if (!attempted[kind])
        {
            attempted[kind] = true;
            textures[kind] = load(iconPaths[kind]);
            if (textures[kind] is null)
                logWarning("Icon \"", iconPaths[kind], "\" could not be loaded, using a fallback");
        }

        if (textures[kind] !is null)
            return textures[kind];
        if (kind != IconKind.File)
            return get(IconKind.File);
        return null;
    }

    Texture forFile(const(char)[] filename, bool isDirectory)
    {
        return get(isDirectory ? IconKind.Folder : kindForFile(filename));
    }

    private Texture load(string path)
    {
        TextureAsset asset = New!TextureAsset(assetManager);
        asset.generateMipmaps = false;
        assetManager.preloadAsset(asset, path);
        if (!asset.loaded || asset.texture is null)
            return null;

        Texture tex = asset.texture;
        tex.minFilter = GL_LINEAR;
        tex.magFilter = GL_LINEAR;
        tex.bind();
        tex.unbind();
        return tex;
    }
}
