struct EditorViewport
{
    ImVec2 position;
    ImVec2 size;
}

bool viewportChanged(EditorViewport oldvp, EditorViewport newvp)
{
    return (
        newvp.position.x != oldvp.position.x ||
        newvp.position.y != oldvp.position.y ||
        newvp.size.x != oldvp.size.x ||
        newvp.size.y != oldvp.size.y
    );
}

void browse(string url)
{
    version(Windows)
    {
        auto result = ShellExecuteW(null, "open".toUTF16z, url.toUTF16z, null, null, SW_SHOWNORMAL);
        if (cast(size_t)result <= 32)
            showMessage("Unable to open website", "Could not open " ~ url ~ " in the default browser.");
    }
    else version(linux)
    {
        try
        {
            auto result = execute(["xdg-open", url]);
            if (result.status != 0)
                showMessage("Unable to open website", "Could not open " ~ url ~ " in the default browser.");
        }
        catch (ProcessException e)
        {
            showMessage("Unable to open website", e.msg);
        }
    }
    else version(OSX)
    {
        try
        {
            auto result = execute(["open", url]);
            if (result.status != 0)
                showMessage("Unable to open website", "Could not open " ~ url ~ " in the default browser.");
        }
        catch (ProcessException e)
        {
            showMessage("Unable to open website", e.msg);
        }
    }
    else
    {
        showMessage("Unable to open website", "Opening links is not supported on this platform.");
    }
}

void openHelp()
{
    string exeDir = thisExePath().dirName();
    string absolutePath = buildPath(exeDir, "doc", "index.html");
    version(Windows)
    {
        absolutePath = absolutePath.replace("\\", "/");
    }
    string helpUrl = "file:///" ~ absolutePath;
    browse(helpUrl);
}

class EditorUI: EventListener
{
    EditorApp app;
    Editor editor;

    bool active = false;
    ImGuiContext* igContext;
    ImGuiIO* io;
    ImFont* font;
    ImGuiViewport* viewport;
    
    EditorViewport editorViewport = EditorViewport(ImVec2(0, 0), ImVec2(0, 0));
    EditorViewport editorViewportPrevious = EditorViewport(ImVec2(0, 0), ImVec2(0, 0));
    
    // Icons and thumbnails are assigned from main.d and shared by the panels
    Texture iconFile;
    Texture iconFolder;
    Texture iconArchive;
    Texture iconAudio;
    Texture iconBlend;
    Texture iconJson;
    Texture iconModel;
    ThumbnailGenerator thumbnailGenerator;
    Texture iconTranslate;
    Texture iconRotate;
    Texture iconScale;
    Texture aboutImage;
    bool showAbout = true; // TODO: get from editor.conf
    
    // Panels
    Toolbar toolbar;
    Inspector inspector;
    PropertiesPanel properties;
    AssetBrowser assetBrowser;
    
    string lastSaveFilename;
    
    static ImWchar[7] glyphRanges = [
        0x0020, 0x00FF, // Basic Latin + Latin Supplement
        0x0370, 0x03FF, // Greek
        0x0400, 0x044F, // Cyrillic
        0
    ];
    
    EditorScene scene;
    
    this(EditorApp application, Editor editor, string[] args)
    {
        super(application.eventManager, application);
        this.app = application;
        this.editor = editor;
        
        this.scene = cast(EditorScene)app.currentScene;
        
        igContext = igCreateContext(null);
        igSetCurrentContext(igContext);
        io = igGetIO();
        io.ConfigFlags |= ImGuiConfigFlags.DockingEnable;
        io.ConfigWindowsMoveFromTitleBarOnly = true;
        io.FontGlobalScale = 1.0f / app.pixelRatio;
        // TODO: get path to the font from editor.conf
        font = ImFontAtlas_AddFontFromFileTTF(io.Fonts, "data/fonts/Inter_18pt-Medium.ttf", 16 * app.pixelRatio, null, glyphRanges.ptr);
        igStyleColorsDark(null);
        applyTheme();
        ImGui_ImplSDL2_InitForOpenGL(app.window, app.glcontext);
        ImGuiOpenGLBackend.init("#version 400 core");
        
        toolbar = New!Toolbar(this);
        inspector = New!Inspector(editor, this);
        properties = New!PropertiesPanel(this);
        assetBrowser = New!AssetBrowser(this);
    }
    
    void onProcessEvent(SDL_Event* event)
    {
        if (!active)
            return;
        
        ImGui_ImplSDL2_ProcessEvent(event);
        handleShortcut(event);
    }

    void handleShortcut(SDL_Event* event)
    {
        if (event.type != SDL_KEYDOWN)
            return;

        // Leave the shortcuts to text fields while one is being edited
        if (io.WantTextInput)
            return;

        uint mods = cast(uint)event.key.keysym.mod;
        if (!(mods & KMOD_CTRL))
            return;

        int key = cast(int)event.key.keysym.sym;
        if (key == SDLK_y || (key == SDLK_z && (mods & KMOD_SHIFT)))
            editor.redo();
        else if (key == SDLK_z)
            editor.undo();
    }

    bool capturesMouse() @property const
    {
        return io.WantCaptureMouse;
    }
    
    bool capturesKeyboard() @property const
    {
        return io.WantCaptureKeyboard;
    }
    
    void update(Time t)
    {
        this.scene = cast(EditorScene)app.currentScene;
        
        if (!active)
            return;

        processEvents();
        
        ImGuiOpenGLBackend.new_frame();
        ImGui_ImplSDL2_NewFrame();
        igNewFrame();
        editor.overlay.handleGizmoInput();

        viewport = cast(ImGuiViewport*)igGetMainViewport();
        
        renderMenu();
        toolbar.render();

        ImGuiID mainDockSpaceId = igDockSpaceOverViewport(viewport, ImGuiDockNodeFlags.PassthruCentralNode);
        
        // Get free space size to update the render viewport
        ImGuiDockNode* centralNode = igDockBuilderGetCentralNode(mainDockSpaceId);
        if (centralNode)
        {
            editorViewport = EditorViewport(centralNode.Pos, centralNode.Size);
            editorViewport.size.x *= app.pixelRatio;
            editorViewport.size.y *= app.pixelRatio;
            editorViewport.position.x *= app.pixelRatio;
            editorViewport.position.y *= app.pixelRatio;
            if (viewportChanged(editorViewportPrevious, editorViewport))
            {
                int newWidth = cast(int)(editorViewport.size.x);
                int newHeight = cast(int)(editorViewport.size.y);
                if (newWidth > 0 && newHeight > 0)
                {
                    Event e;
                    e.type = EventType.CustomResize;
                    e.width = newWidth;
                    e.height = newHeight;
                    e.x = cast(int)(editorViewport.position.x);
                    e.y = eventManager.drawableHeight - cast(int)(editorViewport.position.y) - e.height;
                    eventManager.queueEvent(e);
                }
                editorViewportPrevious = editorViewport;
            }
        }
        
        inspector.render();
        properties.render();
        assetBrowser.render();
        renderViewportAssetDropTarget(centralNode);
        
        renderStatusBar();
        
        igRender();
    }

    void renderViewportAssetDropTarget(ImGuiDockNode* node)
    {
        if (node is null || node.Size.x <= 0.0f || node.Size.y <= 0.0f)
            return;

        const(ImGuiPayload)* activePayload = igGetDragDropPayload();
        if (activePayload is null || activePayload.DataType[0 .. 6] != "ASSET\0")
            return;

        ImGuiWindowFlags flags =
            ImGuiWindowFlags.NoDecoration |
            ImGuiWindowFlags.NoMove |
            ImGuiWindowFlags.NoBackground |
            ImGuiWindowFlags.NoSavedSettings |
            ImGuiWindowFlags.NoFocusOnAppearing |
            ImGuiWindowFlags.NoBringToFrontOnFocus |
            ImGuiWindowFlags.NoDocking |
            ImGuiWindowFlags.NoNav;
        igSetNextWindowPos(node.Pos, ImGuiCond.Always);
        igSetNextWindowSize(node.Size, ImGuiCond.Always);
        if (igBegin("##ViewportAssetDropTarget", null, flags))
        {
            igSetCursorScreenPos(node.Pos);
            igInvisibleButton("##ViewportAssetDropArea", node.Size);
            if (igBeginDragDropTarget())
            {
                const(ImGuiPayload)* payload = igAcceptDragDropPayload("ASSET");
                if (payload !is null && payload.Delivery && payload.DataSize > 0)
                {
                    auto data = cast(const(char)*)payload.Data;
                    size_t dataLength = cast(size_t)payload.DataSize;
                    if (data[dataLength - 1] == '\0')
                        dataLength--;
                    editor.onAssetDroppedOnViewport(data[0 .. dataLength].idup);
                }
                igEndDragDropTarget();
            }
        }
        igEnd();
    }
    
    void renderMenu()
    {
        igBeginMainMenuBar();
        if (igBeginMenu("File"))
        {
            if (igMenuItem("New scene"))
            {
                editor.clearScene();
            }
            
            if (igMenuItem("Open..."))
            {
                string filename = openFileDialog(["*.json"], "Select a scene file");
                if (filename.length != 0)
                    editor.openScene(filename);
            }
            
            if (igMenuItem("Save"))
            {
                if (lastSaveFilename.length == 0)
                    lastSaveFilename = saveFileDialog(["*.json"], "Save scene to a file");
                
                if (lastSaveFilename.length != 0)
                    editor.saveScene(lastSaveFilename);
            }
            
            if (igMenuItem("Save as..."))
            {
                lastSaveFilename = saveFileDialog(["*.json"], "Save scene to a file");
                if (lastSaveFilename.length != 0)
                    editor.saveScene(lastSaveFilename);
            }
            
            if (igMenuItem("Exit"))
            {
                app.exit();
            }
            
            igEndMenu();
        }
        if (igBeginMenu("Edit"))
        {
            TextBuffer!64 undoLabel;
            undoLabel.set("Undo");
            if (editor.history.canUndo)
            {
                undoLabel.append(" ");
                undoLabel.append(editor.history.undoName);
            }
            if (igMenuItem(undoLabel.cstr, "Ctrl+Z", false, editor.history.canUndo))
                editor.undo();

            TextBuffer!64 redoLabel;
            redoLabel.set("Redo");
            if (editor.history.canRedo)
            {
                redoLabel.append(" ");
                redoLabel.append(editor.history.redoName);
            }
            if (igMenuItem(redoLabel.cstr, "Ctrl+Y", false, editor.history.canRedo))
                editor.redo();

            igEndMenu();
        }
        if (igBeginMenu("Help"))
        {
            if (igMenuItem("Contents"))
                openHelp();
            
            if (igMenuItem("Dagon Engine website"))
                browse(dagonWebsiteUrl);

            if (igMenuItem("About Dagon Editor..."))
                showAbout = true;
            
            igEndMenu();
        }
        igEndMainMenuBar();

        if (showAbout)
        {
            igSetNextWindowPos(
                ImVec2(viewport.Pos.x + viewport.Size.x * 0.5f, viewport.Pos.y + viewport.Size.y * 0.5f),
                ImGuiCond.Always,
                ImVec2(0.5f, 0.5f));
            igOpenPopup("About Dagon Editor");
        }

        if (igBeginPopupModal("About Dagon Editor", &showAbout, ImGuiWindowFlags.AlwaysAutoResize | ImGuiWindowFlags.NoSavedSettings))
        {
            if (igIsMouseClicked(ImGuiMouseButton.Left) && !igIsWindowHovered())
            {
                showAbout = false;
                igCloseCurrentPopup();
            }

            if (aboutImage && aboutImage.valid)
            {
                ImVec2 imagePosition;
                igGetCursorScreenPos(&imagePosition);
                igImage(cast(void*)aboutImage.texture, ImVec2(cast(float)aboutImage.width, cast(float)aboutImage.height));
                ImVec2 textPosition = ImVec2(
                    imagePosition.x + 8.0f,
                    imagePosition.y + cast(float)aboutImage.height - 24.0f);
                ImDrawList* drawList = igGetWindowDrawList();
                ImDrawList_AddText(
                    drawList,
                    ImVec2(textPosition.x + 1.0f, textPosition.y + 1.0f),
                    0xFF000000,
                    editorVersionString.ptr);
                ImDrawList_AddText(drawList, textPosition, 0xFFFFFFFF, editorVersionString.ptr);
            }
            else
                igText(editorVersionString.ptr);
        }
        igEndPopup();
    }
    
    void renderStatusBar()
    {
        ImGuiWindowFlags windowFlags = ImGuiWindowFlags.NoScrollbar | ImGuiWindowFlags.NoSavedSettings | ImGuiWindowFlags.MenuBar;
        float height = igGetFrameHeight();
        if (igBeginViewportSideBar("##MainStatusBar", viewport, ImGuiDir.Down, height, windowFlags))
        {
            if (igBeginMenuBar())
            {
                // TODO
                igText("Status bar");
                igEndMenuBar();
            }
            igEnd();
        }
    }
    
    void render()
    {
        if (!active)
            return;
        
        ImGuiOpenGLBackend.render_draw_data(igGetDrawData());
    }
    
    void applyTheme()
    {
        ImGuiStyle* style = igGetStyle();
        
        style.WindowRounding    = 6.0f;
        style.ChildRounding     = 4.0f;
        style.FrameRounding     = 4.0f;
        style.PopupRounding     = 4.0f;
        style.ScrollbarRounding = 9.0f;
        style.GrabRounding      = 4.0f;
        style.TabRounding       = 4.0f;

        // 3. Define our color palette
        ImVec4 color_bg_dark     = ImVec4(0.10f, 0.10f, 0.10f, 0.9f); // Deep charcoal
        ImVec4 color_bg_med      = ImVec4(0.15f, 0.15f, 0.15f, 0.9f);  // Lighter panel background
        ImVec4 color_bg_light    = ImVec4(0.22f, 0.22f, 0.22f, 1.0f);  // Interactive element background
        
        ImVec4 color_orange      = ImVec4(0.90f, 0.45f, 0.00f, 1.0f);  // Vibrant orange
        ImVec4 color_orange_hover= ImVec4(1.00f, 0.55f, 0.15f, 1.0f);  // Bright orange for hover
        ImVec4 color_orange_act  = ImVec4(0.80f, 0.35f, 0.00f, 1.0f);  // Deeper orange for clicks

        ImVec4 color_text        = ImVec4(0.95f, 0.95f, 0.95f, 1.0f);  // Off-white text
        ImVec4 color_text_disabled=ImVec4(0.50f, 0.50f, 0.50f, 1.0f); 

        style.Colors[ImGuiCol.Text]                  = color_text;
        style.Colors[ImGuiCol.TextDisabled]          = color_text_disabled;
        
        // Window Backgrounds
        style.Colors[ImGuiCol.WindowBg]              = color_bg_dark;
        style.Colors[ImGuiCol.ChildBg]               = color_bg_med;
        style.Colors[ImGuiCol.PopupBg]               = color_bg_dark;
        style.Colors[ImGuiCol.Border]                = ImVec4(0.25f, 0.25f, 0.25f, 1.0f);
        style.Colors[ImGuiCol.BorderShadow]          = ImVec4(0.00f, 0.00f, 0.00f, 0.0f);
        style.Colors[ImGuiCol.ModalWindowDimBg]      = ImVec4(0.0f, 0.0f, 0.0f, 0.5f);

        // Frame Elements (Checkboxes, Input Fields, etc.)
        style.Colors[ImGuiCol.FrameBg]               = color_bg_light;
        style.Colors[ImGuiCol.FrameBgHovered]        = ImVec4(0.28f, 0.28f, 0.28f, 1.0f);
        style.Colors[ImGuiCol.FrameBgActive]         = ImVec4(0.35f, 0.35f, 0.35f, 1.0f);

        // Headers (Collapsing Headers, Tree Nodes)
        style.Colors[ImGuiCol.Header]                = color_bg_light;
        style.Colors[ImGuiCol.HeaderHovered]         = color_orange;
        style.Colors[ImGuiCol.HeaderActive]          = color_orange_act;

        // Buttons (The main orange highlights)
        style.Colors[ImGuiCol.Button]                = color_orange;
        style.Colors[ImGuiCol.ButtonHovered]         = color_orange_hover;
        style.Colors[ImGuiCol.ButtonActive]          = color_orange_act;

        // Window Titles
        style.Colors[ImGuiCol.TitleBg]               = color_bg_med;
        style.Colors[ImGuiCol.TitleBgActive]          = color_bg_med;
        style.Colors[ImGuiCol.TitleBgCollapsed]       = color_bg_dark;

        // Tabs
        style.Colors[ImGuiCol.Tab]                   = color_bg_med;
        style.Colors[ImGuiCol.TabHovered]            = color_orange_hover;
        style.Colors[ImGuiCol.TabActive]             = color_orange;
        style.Colors[ImGuiCol.TabUnfocused]          = color_bg_med;
        style.Colors[ImGuiCol.TabUnfocusedActive]     = color_bg_light;

        // Sliders & Scrollbars
        style.Colors[ImGuiCol.ScrollbarBg]           = color_bg_dark;
        style.Colors[ImGuiCol.ScrollbarGrab]         = color_bg_light;
        style.Colors[ImGuiCol.ScrollbarGrabHovered]  = ImVec4(0.30f, 0.30f, 0.30f, 1.0f);
        style.Colors[ImGuiCol.ScrollbarGrabActive]   = color_orange;
        style.Colors[ImGuiCol.CheckMark]             = color_orange;
        style.Colors[ImGuiCol.SliderGrab]            = color_orange;
        style.Colors[ImGuiCol.SliderGrabActive]      = color_orange_act;

        // Miscellaneous
        style.Colors[ImGuiCol.ResizeGrip]            = color_bg_light;
        style.Colors[ImGuiCol.ResizeGripHovered]     = color_orange;
        style.Colors[ImGuiCol.ResizeGripActive]      = color_orange_act;
        style.Colors[ImGuiCol.Separator]             = ImVec4(0.20f, 0.20f, 0.20f, 1.0f);
        style.Colors[ImGuiCol.SeparatorHovered]      = color_orange;
        style.Colors[ImGuiCol.SeparatorActive]       = color_orange_act;
        style.Colors[ImGuiCol.TextSelectedBg]        = ImVec4(0.90f, 0.45f, 0.00f, 0.35f); // Semi-transparent orange selection
        
        // Navigation
        style.Colors[ImGuiCol.NavHighlight] = ImVec4(1.0f, 1.0f, 1.0f, 1.0f);
    }
}
