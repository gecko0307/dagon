/*
 * Serializer for *.material files.
 *
 * The format is Dagon's conf syntax (`key: value;`), read by
 * dagon.resource.material.MaterialAsset. Only canonical keys are written
 * (`baseColorFactor`, `baseColorTexture`, ...), enums are written as numbers,
 * which the loader accepts for every enum property.
 *
 * GC-free: the text is built in a dlib Array and written with writeFileBytes.
 */
module materialwriter;

import core.stdc.stdio: snprintf;

import dlib.container.array;

import dagon.graphics.material;
import dagon.graphics.texture;

import jsonio: writeFileBytes;

enum TextureSlot
{
    BaseColor,
    RoughnessMetallic,
    Emission,
    Normal
}

enum size_t textureSlotCount = 4;

/// Property names of the texture slots, in TextureSlot order
static immutable string[textureSlotCount] textureSlotKeys = [
    "baseColorTexture",
    "roughnessMetallicTexture",
    "emissionTexture",
    "normalTexture"
];

/// Labels of the texture slots for the UI, zero-terminated string literals
static immutable string[textureSlotCount] textureSlotLabels = [
    "Base color",
    "Roughness/Metallic",
    "Emission",
    "Normal"
];

Texture textureInSlot(Material material, TextureSlot slot)
{
    final switch (slot)
    {
        case TextureSlot.BaseColor: return material.baseColorTexture;
        case TextureSlot.RoughnessMetallic: return material.roughnessMetallicTexture;
        case TextureSlot.Emission: return material.emissionTexture;
        case TextureSlot.Normal: return material.normalTexture;
    }
}

void setTextureInSlot(Material material, TextureSlot slot, Texture texture)
{
    final switch (slot)
    {
        case TextureSlot.BaseColor: material.baseColorTexture = texture; break;
        case TextureSlot.RoughnessMetallic: material.roughnessMetallicTexture = texture; break;
        case TextureSlot.Emission: material.emissionTexture = texture; break;
        case TextureSlot.Normal: material.normalTexture = texture; break;
    }
}

private struct TextWriter
{
    Array!char buffer;

    void free()
    {
        buffer.free();
    }

    void put(const(char)[] s)
    {
        foreach (c; s)
            buffer.append(c);
    }

    // In conf strings "$" starts a ${property} reference, "$$" is a literal dollar
    void putQuoted(const(char)[] s)
    {
        buffer.append('"');
        foreach (c; s)
        {
            if (c == '$')
                buffer.append('$');
            buffer.append(c);
        }
        buffer.append('"');
    }

    void putFloatValue(float v)
    {
        char[48] tmp;
        int n = snprintf(tmp.ptr, tmp.length, "%.6f", cast(double)v);
        put(tmp[0..n]);
    }

    void putFloat(const(char)[] key, float v)
    {
        put(key);
        put(": ");
        putFloatValue(v);
        put(";\n");
    }

    void putInt(const(char)[] key, int v)
    {
        char[24] tmp;
        int n = snprintf(tmp.ptr, tmp.length, "%d", v);
        put(key);
        put(": ");
        put(tmp[0..n]);
        put(";\n");
    }

    void putBool(const(char)[] key, bool v)
    {
        put(key);
        put(v ? ": true;\n" : ": false;\n");
    }

    void putVector(size_t N)(const(char)[] key, const float[N] values)
    {
        put(key);
        put(": [");
        foreach (i, v; values)
        {
            if (i > 0)
                put(", ");
            putFloatValue(v);
        }
        put("];\n");
    }
}

/**
 * Writes a *.material file. Throws on I/O errors.
 * `name` is the material name; `textures` holds the texture path of each
 * slot (empty string for none), exactly as it must appear in the file.
 */
void writeMaterialFile(string path, const(char)[] name, Material material, const(string)[] textures)
{
    TextWriter w;
    scope(exit) w.free();

    w.put("// Dagon material\n");
    if (name.length)
    {
        w.put("name: ");
        w.putQuoted(name);
        w.put(";\n");
    }

    w.put("\n");
    w.putVector("baseColorFactor", material.baseColorFactor.arrayof);
    w.putFloat("roughnessFactor", material.roughnessFactor);
    w.putFloat("metallicFactor", material.metallicFactor);
    w.putVector("emissionFactor", material.emissionFactor.arrayof);
    w.putFloat("emissionEnergy", material.emissionEnergy);
    w.putVector("normalFactor", material.normalFactor.arrayof);

    w.put("\n");
    foreach (i; 0..textureSlotCount)
    {
        if (i < textures.length && textures[i].length)
        {
            w.put(textureSlotKeys[i]);
            w.put(": ");
            w.putQuoted(textures[i]);
            w.put(";\n");
        }
    }

    w.put("\n");
    w.putInt("blendMode", cast(int)material.blendMode);
    w.putFloat("opacity", material.opacity);
    w.putFloat("alphaTestThreshold", material.alphaTestThreshold);
    w.putBool("shadeless", material.shadeless);
    w.putBool("useShadows", material.useShadows);
    w.putInt("shadowFilter", cast(int)material.shadowFilter);
    w.putBool("useFog", material.useFog);
    w.putBool("useCulling", material.useCulling);
    w.putBool("colorWrite", material.colorWrite);
    w.putBool("depthWrite", material.depthWrite);
    w.putBool("linearColor", material.linearColor);
    w.putBool("invertNormalY", material.invertNormalY);

    w.put("\n");
    w.putInt("textureMappingMode", cast(int)material.textureMappingMode);
    w.putInt("parallaxMode", cast(int)material.parallaxMode);
    w.putFloat("parallaxScale", material.parallaxScale);
    w.putFloat("parallaxBias", material.parallaxBias);
    w.putFloat("heightFactor", material.heightFactor);
    w.putFloat("maskFactor", material.maskFactor);
    w.putFloat("specularity", material.specularity);
    w.putFloat("subsurfaceScattering", material.subsurfaceScattering);
    w.putBool("sphericalNormal", material.sphericalNormal);
    w.putBool("celShading", material.celShading);
    w.putBool("rimLight", material.rimLight);

    w.put("\n");
    w.putBool("outputColor", material.outputColor);
    w.putBool("outputNormal", material.outputNormal);
    w.putBool("outputPBR", material.outputPBR);
    w.putBool("outputEmission", material.outputEmission);

    writeFileBytes(path, w.buffer.data);
}
