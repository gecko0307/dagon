/**
 * Manages the application context, assets, world,
 * and environment for a 3D scene.
 *
 * Description:
 * The `Scene` class provides methods for adding assets
 * (textures, OBJ, GLTF, text, binary), creating entities,
 * cameras, lights, and decals, and handling scene loading
 * and update logic. It supports threaded asset loading,
 * progress reporting, and customizable hooks for loading
 * and update events.
 */
class Scene: EventListener
{
    /// The application.
    Application application;
    
    protected AssetManager assetManagerInternal;
    protected World worldInternal;
    protected Environment environmentInternal;
    
    /// The asset manager for this scene.
    AssetManager assetManager;

    /// The world containing all entities.
    World world;

    /// The environment settings for the scene.
    Environment environment;

    /// Default shape for decals.
    ShapeBox decalShape;

    /// True if loading has started.
    bool startedLoading = false;

    /// True if assets are currently loading.
    bool isLoading = false;

    /// True if loading is complete.
    bool loaded = false;

    /// True if the scene is ready to render.
    bool canRender = false;

    /// True if the scene is focused.
    bool focused = true;

    /// True if the scene is paused.
    bool paused = false;
    
    /// Graphical user interface manager
    UIManager ui;
    
    private Entity timerEntity; // dummy entity used for delayed calls

    /**
     * Constructs a new scene with the given application.
     *
     * Params:
     *   application = The application instance.
     */
    this(Application application)
    {
        super(application.eventManager, application);
        this.application = application;
        
        assetManagerInternal = New!AssetManager(eventManager, application.vfs, this);
        assetManager = assetManagerInternal;
        assetManager.application = application;
        
        worldInternal = New!World(this);
        world = worldInternal;

        environmentInternal = New!Environment(this);
        environment = environmentInternal;
        
        decalShape = New!ShapeBox(Vector3f(1, 1, 1), this);
        
        ui = New!UIManager(this, assetManager);
        
        timerEntity = New!Entity(this);
        timerEntity.visible = false;
    }

    /**
     * Adds an asset to the scene's asset manager, optionally preloading.
     *
     * Params:
     *   asset    = The asset to add.
     *   filename = The asset filename.
     *   preload  = If true, preload the asset immediately.
     * Returns:
     *   The added asset.
     */
    Asset addAsset(Asset asset, string filename, bool preload = false)
    {
        if (preload)
            assetManager.preloadAsset(asset, filename);
        else
            assetManager.addAsset(asset, filename);
        return asset;
    }

    /**
     * Adds a scene asset to the scene's asset manager, optionally preloading.
     *
     * Params:
     *   filename = The asset filename.
     *   preload  = If true, preload the asset immediately.
     * Returns:
     *   The added asset.
     */
    SceneAsset addSceneAsset(string filename, bool preload = false)
    {
        SceneAsset newAsset;
        if (assetManager.assetExists(filename))
        {
            newAsset = cast(SceneAsset)assetManager.getAsset(filename);
        }
        else
        {
            newAsset = New!SceneAsset(world, assetManager);
            addAsset(newAsset, filename, preload);
        }
        return newAsset;
    }

    /**
     * Adds an asset of type `T` by filename, optionally preloading.
     *
     * Params:
     *   filename = The asset filename.
     *   preload  = If true, preload the asset immediately.
     * Returns:
     *   The loaded or newly created asset of type `T`.
     */
    T addAssetAs(T)(string filename, bool preload = false)
    {
        T newAsset;
        if (assetManager.assetExists(filename))
        {
            newAsset = cast(T)assetManager.getAsset(filename);
        }
        else
        {
            newAsset = New!T(assetManager);
            addAsset(newAsset, filename, preload);
        }
        return newAsset;
    }

    /// Adds a texture asset by filename.
    alias addTextureAsset = addAssetAs!TextureAsset;

    /// Adds an OBJ mesh asset by filename.
    alias addOBJAsset = addAssetAs!OBJAsset;

    /// Adds a GLTF mesh asset by filename.
    alias addGLTFAsset = addAssetAs!GLTFAsset;

    /// Adds a text asset by filename.
    alias addTextAsset = addAssetAs!TextAsset;

    /// Adds a binary asset by filename.
    alias addBinaryAsset = addAssetAs!BinaryAsset;
    
    /// Adds a material asset by filename.
    alias addMaterialAsset = addAssetAs!MaterialAsset;
    
    /// Adds a font asset by filename.
    FontAsset addFontAsset(string filename, uint height, bool preload = false)
    {
        FontAsset fontAsset;
        if (assetManager.assetExists(filename))
        {
            fontAsset = cast(FontAsset)assetManager.getAsset(filename);
        }
        else
        {
            fontAsset = New!FontAsset(height, application.pixelRatio, assetManager);
            addAsset(fontAsset, filename, preload);
        }
        return fontAsset;
    }

    /// Creates and adds a new material.
    Material addMaterial()
    {
        return New!Material(assetManager);
    }

    /// Creates and adds a new decal material (transparent, no depth write, no culling).
    Material addDecalMaterial()
    {
        auto mat = addMaterial();
        mat.blendMode = Transparent;
        mat.depthWrite = false;
        mat.useCulling = false;
        return mat;
    }

    /// Creates and adds a new entity, optionally with a parent.
    Entity addEntity(Entity parent = null)
    {
        Entity e = New!Entity(world);
        if (parent)
            e.setParent(parent);
        return e;
    }

    /// Adds an existing entity to the world.
    Entity useEntity(Entity e, bool useChildren = false)
    {
        world.add(e);
        if (useChildren)
        {
            foreach(child; e.children)
                useEntity(child, useChildren);
        }
        return e;
    }
    
    /// Removes an entity from the world without deleting it.
    void removeEntity(Entity e, bool removeChildren = false)
    {
        world.remove(e);
        if (removeChildren)
        {
            foreach(child; e.children)
                removeEntity(child, removeChildren);
        }
    }

    /// Creates and adds a new HUD entity (foreground layer), optionally with a parent.
    Entity addEntityHUD(Entity parent = null)
    {
        Entity e = New!Entity(world);
        e.layer = EntityLayer.Foreground;
        if (parent)
            e.setParent(parent);
        return e;
    }

    /// Creates and adds a new camera, optionally with a parent.
    Camera addCamera(Entity parent = null)
    {
        Camera c = New!Camera(world);
        if (parent)
        {
            c.setParent(parent);
            c.updateTransformationBottomUp();
        }
        return c;
    }

    /// Creates and adds a new light of the given type, optionally with a parent.
    Light addLight(LightType type, Entity parent = null)
    {
        Light light = New!Light(world);
        if (parent)
            light.setParent(parent);
        light.type = type;
        return light;
    }

    /// Creates and adds a new decal entity, optionally with a parent.
    Entity addDecal(Entity parent = null)
    {
        Entity e = New!Entity(world);
        e.decal = true;
        e.drawable = decalShape;
        if (parent)
            e.setParent(parent);
        return e;
    }
    
    T addWidget(T)(UIWidget parent = null)
    {
        return New!T(ui, parent);
    }
    
    PersistentStorage addPersistentStorage(string filename)
    {
        return New!PersistentStorage(application.vfs, filename, this);
    }
    
    Tween* delayedCall(double delay, scope void delegate(Tween*) callback)
    {
        Tween* tween = timerEntity.getTween();
        *tween = Tween(timerEntity, delay);
        tween.onComplete = callback;
        return tween;
    }

    /// Override to perform actions before loading assets.
    void beforeLoad()
    {
    }

    /**
     * Override to handle loading progress.
     *
     * Params:
     *   t        = Frame timing information.
     *   progress = Loading progress (0..1).
     */
    void onLoad(Time t, float progress)
    {
    }

    /// Override to perform actions after loading is complete.
    void afterLoad()
    {
    }

    /**
     * Override to run custom logic each time step before all entities are updated.
     *
     * Params:
     *   t = Frame timing information.
     */
    void onUpdate(Time t)
    {
    }
    
    /**
     * Override to run custom logic each time step after all entities were updated.
     *
     * Params:
     *   t = Frame timing information.
     */
    void onEndUpdate(Time t)
    {
    }
    
    /**
     * Override to run custom logic each time step when the scene is paused.
     *
     * Params:
     *   t = Frame timing information.
     */
    void onPauseUpdate(Time t)
    {
    }
    
    /// Override to handle scene reset.
    void onReset()
    {
    }
    
    /// Called after rendering.
    void afterRender()
    {
    }

    /**
     * Updates the scene, processes events, and updates all entities.
     *
     * Params:
     *   t = Frame timing information.
     */
    void update(Time t)
    {
        processEvents(focused && loaded);
        
        if (paused)
        {
            onPauseUpdate(t);
            return;
        }
        
        if (!startedLoading)
        {
            startedLoading = true;
            beforeLoad();
            isLoading = true;
            assetManager.loadThreadSafePart();
        }
        else if (isLoading)
        {
            onLoad(t, assetManager.nextLoadingPercentage);
            isLoading = assetManager.isLoading;
        }
        else
        {
            if (!loaded)
            {
                assetManager.loadThreadUnsafePart();
                loaded = true;
                afterLoad();
                onLoad(t, 1.0f);
                SDL_RaiseWindow(application.window);
                canRender = true;
            }
            else
            {
                timerEntity.update(t);
                ui.update(t);
                onUpdate(t);
                foreach(e; world)
                {
                    e.update(t);
                }
                onEndUpdate(t);
            }
        }
    }
}

/**
 * Scene asset in JSON format.
 * Used by the Dagon Editor.
 */
class SceneAsset: Asset
{
    /// Asset manager that is used to load external resources of the asset.
    AssetManager assetManager;
    
    /// Unmanaged string that stores JSON source file.
    protected String str;
    
    /// JSON document that stores the structure of the glTF file.
    JSONDocument doc;
    
    /// The world that containts all loaded entities. Can be changed before loading the asset.
    World world;
    
    /// Array of loaded scene materials.
    Array!Material materials;
    
    /// Array of loaded scene entities.
    Array!Entity entities;
    
    protected Dict!(MaterialAsset, string) materialAssets;
    protected Dict!(OBJAsset, string) meshAssets;
    
    /**
     * Constructs a new scene asset.
     *
     * Params:
     *   world = World object to store loaded entities (normally should be `Scene.world` by default).
     *   owner = Owner object.
     */
    this(World world, Owner owner)
    {
        super(owner);
        this.world = world;
        materialAssets = New!(Dict!(MaterialAsset, string));
        meshAssets = New!(Dict!(OBJAsset, string));
    }
    
    /// Destructor. Releases all resources.
    ~this()
    {
        release();
    }
    
    override bool loadThreadSafePart(string filename, InputStream istrm, ReadOnlyFileSystem fs, AssetManager assetManager)
    {
        version(GLTFDebug) logDebug("Loading ", filename);
        this.assetManager = assetManager;
        
        str = String(istrm);
        doc = New!JSONDocument(str.toString);
        JSONValue root = doc.root;
        
        if (!doc.isValid || root.type != JSONType.Object)
        {
            logError("Cannot load scene \"", filename, "\": invalid scene file");
            release();
            return false;
        }
        
        string assetRootPath = dirName(filename);
        
        loadMaterials(assetRootPath);
        loadEntities(assetRootPath);
        
        threadSafePartLoaded = true;
        return true;
    }
    
    protected void loadMaterials(string assetRootPath)
    {
        JSONValue materialsNode = doc.root.asObject["materials"];
        if (materialsNode !is null && materialsNode.type == JSONType.Array)
        {
            foreach (m; materialsNode.asArray.data)
            {
                string path = m.asObject["path"].asString;
                materials.append((path.length > 0)? loadMaterial(assetRootPath, path) : null);
            }
        }
    }
    
    protected Material loadMaterial(string assetRootPath, string path)
    {
        String p = String(assetRootPath);
        p ~= "/";
        p ~= path;
        scope(exit)
        {
            p.free();
        }
        string materialPath = p.toString;
        
        if (materialPath in assetManager.assetsByFilename)
        {
            MaterialAsset materialAsset = cast(MaterialAsset)assetManager.assetsByFilename[materialPath];
            if (materialAsset)
                return materialAsset.material;
            else
                return null;
        }
        else if (materialPath in materialAssets)
        {
            return materialAssets[materialPath].material;
        }
        else
        {
            MaterialAsset materialAsset = New!MaterialAsset(assetManager);
            assetManager.loadAssetThreadSafePart(materialAsset, materialPath);
            materialAssets[materialPath] = materialAsset;
            return materialAsset.material;
        }
    }
    
    protected Mesh loadMesh(string assetRootPath, string path)
    {
        String p = String(assetRootPath);
        p ~= "/";
        p ~= path;
        scope(exit)
        {
            p.free();
        }
        string meshPath = p.toString;
        
        if (meshPath in assetManager.assetsByFilename)
        {
            OBJAsset objAsset = cast(OBJAsset)assetManager.assetsByFilename[meshPath];
            if (objAsset)
                return objAsset.mesh;
            else
                return null;
        }
        else if (meshPath in meshAssets)
        {
            return meshAssets[meshPath].mesh;
        }
        else
        {
            OBJAsset objAsset = New!OBJAsset(assetManager);
            assetManager.loadAssetThreadSafePart(objAsset, meshPath);
            meshAssets[meshPath] = objAsset;
            return objAsset.mesh;
        }
    }
    
    protected void loadEntities(string assetRootPath)
    {
        JSONValue entitiesNode = doc.root.asObject["entities"];
        if (entitiesNode !is null && entitiesNode.type == JSONType.Array)
        {
            foreach (i, e; entitiesNode.asArray.data)
            {
                if (e.type != JSONType.Object)
                {
                    logError("Entity ", i, " is not an object, ignoring");
                    Entity entity = New!Entity(world);
                    entities.append(entity);
                    continue;
                }
                
                auto lj = "light" in e.asObject;
                if (lj !is null && lj.type == JSONType.Object)
                {
                    Light light = New!Light(world);
                    entities.append(light);
                }
                else
                {
                    Entity entity = New!Entity(world);
                    entities.append(entity);
                }
            }
            
            foreach (i, e; entitiesNode.asArray.data)
            {
                readEntity(entities[i], i, e.asObject, assetRootPath);
            }
        }
    }
    
    protected void readEntity(Entity e, size_t eIndex, JSONObject obj, string assetRootPath)
    {
        long parentIndex = obj.fieldAs("parent", -1L);
        if (parentIndex >= 0)
        {
            if (parentIndex >= entities.length)
                logError("Entity ", eIndex, " has invalid parent index ", parentIndex);
            else
            {
                Entity parent = entities[cast(size_t)parentIndex];
                e.setParent(parent);
            }
        }
        
        e.name = obj.fieldAs("name", e.name);
        e.layer = cast(EntityLayer)obj.fieldAs("layer", cast(uint)e.layer);
        e.type = cast(EntityType)obj.fieldAs("type", cast(uint)e.type);
        e.renderLayer = obj.fieldAs("renderLayer", e.renderLayer);
        e.visible = obj.fieldAs("visible", e.visible);
        e.castShadow = obj.fieldAs("castShadow", e.castShadow);
        e.solid = obj.fieldAs("solid", e.solid);
        e.dynamic = obj.fieldAs("dynamic", e.dynamic);
        e.decal = obj.fieldAs("decal", e.decal);
        e.probe = obj.fieldAs("probe", e.probe);
        e.probeExtents = obj.fieldAs("probeExtents", e.probeExtents);
        e.probeFalloffMargin = obj.fieldAs("probeFalloffMargin", e.probeFalloffMargin);
        e.probeUseBoxProjection = obj.fieldAs("probeUseBoxProjection", e.probeUseBoxProjection);
        e.transparent = obj.fieldAs("transparent", e.transparent);
        e.opacity = obj.fieldAs("opacity", e.opacity);
        e.position = obj.fieldAs("position", e.position);
        e.rotation = obj.fieldAs("rotation", e.rotation);
        e.scaling = obj.fieldAs("scaling", e.scaling);
        
        string meshPath = obj.fieldAs("mesh", "");
        if (meshPath.length > 0)
        {
            Mesh mesh = loadMesh(assetRootPath, meshPath);
            if (mesh !is null)
                e.drawable = mesh;
        }
        
        long matIndex = obj.fieldAs("material", -1L);
        if (matIndex >= 0)
        {
            if (matIndex >= materials.length)
                logError("Entity ", eIndex, " has invalid material index ", matIndex);
            else
            {
                Material material = materials[cast(size_t)matIndex];
                e.material = material;
            }
        }
        
        Light l = cast(Light)e;
        if (l)
        {
            auto light = obj["light"].asObject;
            l.type = cast(LightType)light.fieldAs("type", cast(uint)l.type);
            l.shining = light.fieldAs("shining", l.shining);
            l.color = light.fieldAs("color", l.color);
            l.energy = light.fieldAs("energy", l.energy);
            l.angularRadius = light.fieldAs("angularRadius", l.angularRadius);
            l.volumeRadius = light.fieldAs("volumeRadius", l.volumeRadius);
            l.radius = light.fieldAs("radius", l.radius);
            l.length = light.fieldAs("length", l.length);
            l.spotOuterCutoff = light.fieldAs("spotOuterCutoff", l.spotOuterCutoff);
            l.spotInnerCutoff = light.fieldAs("spotInnerCutoff", l.spotInnerCutoff);
            l.shadowEnabled = light.fieldAs("shadowEnabled", l.shadowEnabled);
            l.scatteringEnabled = light.fieldAs("scatteringEnabled", l.scatteringEnabled);
            l.scattering = light.fieldAs("scattering", l.scattering);
            l.mediumDensity = light.fieldAs("mediumDensity", l.mediumDensity);
            l.scatteringSamples = light.fieldAs("scatteringSamples", l.scatteringSamples);
            l.scatteringMaxRandomStepOffset = light.fieldAs("scatteringMaxRandomStepOffset", l.scatteringMaxRandomStepOffset);
            l.scatteringUseShadow = light.fieldAs("scatteringUseShadow", l.scatteringUseShadow);
            l.diffuse = light.fieldAs("diffuse", l.diffuse);
            l.specular = light.fieldAs("specular", l.specular);
        }
    }
    
    override bool loadThreadUnsafePart()
    {
        foreach(filename, asset; materialAssets)
        {
            asset.loadThreadUnsafePart();
        }
        
        foreach(filename, asset; meshAssets)
        {
            asset.loadThreadUnsafePart();
        }
        
        threadUnsafePartLoaded = true;
        return true;
    }
    
    /// Releases all resources associated with the asset.
    override void release()
    {
        materials.free();
        entities.free();
        
        if (doc)
            Delete(doc);
        str.free();
        
        Delete(materialAssets);
        Delete(meshAssets);
    }
}
