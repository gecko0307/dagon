/**
 * Defines mesh data structure and utilities.
 *
 * Description:
 * The `dagon.graphics.mesh` module provides the `Mesh` class for storing
 * and rendering 3D geometry (indexed triangle mesh). The module also defines
 * the `VertexAttrib` enumeration for standard attribute locations used in the engine,
 * and the `TriangleSet` interface for triangle iteration.
 * Meshes support bounding box calculation, normal/tangent generation, and OpenGL VAO/VBO management.
 *
 * Copyright: Timur Gafarov 2017-2026
 * License: $(LINK2 https://boost.org/LICENSE_1_0.txt, Boost License 1.0).
 * Authors: Timur Gafarov
 */
module dagon.graphics.mesh;

import std.algorithm;

import dlib.core.memory;
import dlib.core.ownership;
import dlib.geometry.triangle;
import dlib.math.base;
import dlib.math.vector;
import dlib.geometry.aabb;
import dlib.image.color;

import dagon.core.bindings;
import dagon.graphics.drawable;
import dagon.graphics.material;

/**
 * Enumerates vertex attribute locations for mesh data.
 */
enum VertexAttrib
{
    /// Vertices - array of float[3].
    Vertices = 0,
    
    /// Normals - array of float[3].
    Normals = 1,
    
    /// Texture coordinates - array of float[2].
    Texcoords = 2,
    
    /// Bone indices - array of uint[4].
    Bones = 3,
    
    /// Bone weights - array of float[4].
    Weights = 4,
    
    /// Second texture coordinates - array of float[2].
    Texcoords2 = 5,
    
    /// Per-vertex colors - array of float[4].
    Colors = 6,
    
    /// Per-vertex tangents - array of float[4].
    Tangents = 7
}

/**
 * Interface for objects that provide access to a set of triangles.
 */
interface TriangleSet
{
    /**
     * Iterates over all triangles in the set.
     *
     * Params:
     *   dg = Delegate to call for each triangle.
     * Returns:
     *   0 if iteration completed, or the value returned by the delegate if nonzero.
     */
    int opApply(scope int delegate(Triangle* t) dg);
    
    /// Returns a total number of triangles in the set.
    size_t numTriangles();
}

/**
 * A group of triangles that use the same material.
 */
struct FaceGroup
{
    /// First triangle index in Mesh.indices array.
    uint firstTriangle;
    
    /// Number of triangles in the face group.
    uint numTriangles;
    
    /// Material for the face group.
    Material material;
    
    /// Face group visibility flag.
    bool visible;
}

/**
 * Represents an indexed 3D mesh.
 *
 * Description:
 * The `Mesh` class stores arrays of vertex attributes,
 * triangle indices, and face groups, managing their
 * OpenGL VAO/VBO counterparts.
 * It supports bounding box calculation, normal and tangent generation,
 * and implements the `Drawable` and `TriangleSet` interfaces.
 */
class Mesh: Owner, Drawable, TriangleSet
{
    /// Symbolic name (optional).
    string name;

    /// True if mesh data is ready for rendering.
    bool dataReady = false;

    /// True if OpenGL buffers are prepared and mesh can be rendered.
    bool canRender = false;

    /// Array of vertex positions.
    Vector3f[] vertices;

    /// Array of vertex normals.
    Vector3f[] normals;

    /// Array of texture coordinates.
    Vector2f[] texcoords;

    /// Array of second texture coordinates (optional).
    Vector2f[] texcoords2;

    /// Array of vertex tangents (optional).
    Vector4f[] tangents;

    /// Array of colors (optional).
    Color4f[] colors;

    /// Array of bone indices for skeletal animation (optional).
    uint[4][] bones;

    /// Array of bone weights for skeletal animation (optional).
    Vector4f[] weights;

    /// Array of triangle indices.
    uint[3][] indices;

    /// Array of face groups (optional).
    FaceGroup[] facegroups;

    /// If true, facegroups will be rendered instead of the whole indices array.
    bool renderFacegroups = true;

    /// If true, second texture coordinates buffer will be used (set before `prepareVAO`).
    bool useTexcoords2 = false;

    /// If true, tangents buffer will be used (set before `prepareVAO`).
    bool useTangents = false;

    /// If true, colors buffer will be used (set before `prepareVAO`).
    bool useColors = false;

    /// If true, bone indices buffer will be used (set before `prepareVAO`).
    bool useBones = false;

    /// If true, bone weights buffer will be used (set before `prepareVAO`).
    bool useWeights = false;

    /// Axis-aligned bounding box for the mesh.
    AABB boundingBox;

    /// OpenGL vertex array object.
    GLuint vao = 0;

    /// OpenGL vertex buffer object for positions.
    GLuint vbo = 0;

    /// OpenGL vertex buffer object for normals.
    GLuint nbo = 0;

    /// OpenGL vertex buffer object for texture coordinates.
    GLuint tbo = 0;

    /// OpenGL vertex buffer object for texture coordinates 2.
    GLuint t2bo = 0;

    /// OpenGL vertex buffer object for colors.
    GLuint cbo = 0;

    /// OpenGL vertex buffer object for tangents.
    GLuint tnbo = 0;

    /// OpenGL vertex buffer object for bone indices.
    GLuint bbo = 0;

    /// OpenGL vertex buffer object for bone weights.
    GLuint wbo = 0;

    /// OpenGL element array object for indices.
    GLuint eao = 0;
    
    /**
     * Constructs a mesh with the given owner.
     *
     * Params:
     *   owner = The owner object.
     */
    this(Owner owner)
    {
        super(owner);
    }
    
    /// Destructor. Releases all mesh data and OpenGL resources.
    ~this()
    {
        if (vertices.length) Delete(vertices);
        if (normals.length) Delete(normals);
        if (tangents.length) Delete(tangents);
        if (texcoords.length) Delete(texcoords);
        if (texcoords2.length) Delete(texcoords2);
        if (colors.length) Delete(colors);
        if (bones.length) Delete(bones);
        if (weights.length) Delete(weights);
        if (indices.length) Delete(indices);
        if (facegroups.length) Delete(facegroups);
        
        if (canRender)
        {
            if (vao)  glDeleteVertexArrays(1, &vao);
            if (vbo)  glDeleteBuffers(1, &vbo);
            if (nbo)  glDeleteBuffers(1, &nbo);
            if (tbo)  glDeleteBuffers(1, &tbo);
            if (t2bo) glDeleteBuffers(1, &t2bo);
            if (cbo)  glDeleteBuffers(1, &cbo);
            if (tnbo) glDeleteBuffers(1, &tnbo);
            if (bbo)  glDeleteBuffers(1, &bbo);
            if (wbo)  glDeleteBuffers(1, &wbo);
            if (eao)  glDeleteBuffers(1, &eao);
        }
    }
    
    /**
     * Calculates the axis-aligned bounding box for the mesh.
     *
     * Sets the `boundingBox` member based on the furthest vertex extents.
     */
    void calcBoundingBox()
    {
        Vector3f minPoint = Vector3f(float.max, float.max, float.max);
        Vector3f maxPoint = Vector3f(-float.max, -float.max, -float.max);
        
        foreach(v; vertices)
        {
            if (v.x < minPoint.x) minPoint.x = v.x;
            if (v.y < minPoint.y) minPoint.y = v.y;
            if (v.z < minPoint.z) minPoint.z = v.z;
            if (v.x > maxPoint.x) maxPoint.x = v.x;
            if (v.y > maxPoint.y) maxPoint.y = v.y;
            if (v.z > maxPoint.z) maxPoint.z = v.z;
        }
        
        boundingBox = boxFromMinMaxPoints(minPoint, maxPoint);
    }
    
    /**
     * Returns the triangle at the specified face index.
     *
     * Params:
     *   faceIndex = The index of the triangle to retrieve.
     * Returns:
     *   The triangle at the given index.
     */
    Triangle getTriangle(size_t faceIndex)
    {
        uint[3] f = indices[faceIndex];
        Triangle tri;
        tri.v[0] = vertices[f[0]];
        tri.v[1] = vertices[f[1]];
        tri.v[2] = vertices[f[2]];
        tri.n[0] = normals[f[0]];
        tri.n[1] = normals[f[1]];
        tri.n[2] = normals[f[2]];
        tri.t1[0] = texcoords[f[0]];
        tri.t1[1] = texcoords[f[1]];
        tri.t1[2] = texcoords[f[2]];
        tri.normal = (tri.n[0] + tri.n[1] + tri.n[2]) / 3.0f;
        return tri;
    }
    
    /**
     * Iterates over all triangles in the mesh.
     *
     * Params:
     *   dg = Delegate to call for each triangle.
     * Returns:
     *   0 if iteration completed, or the value returned by the delegate if nonzero.
     */
    int opApply(scope int delegate(Triangle* t) dg)
    {
        int result = 0;

        foreach(i, ref f; indices)
        {
            Triangle tri = getTriangle(i);
            result = dg(&tri);
            if (result)
                break;
        }

        return result;
    }

    /// Returns a total number of triangles in the set.
    size_t numTriangles()
    {
        return indices.length;
    }
    
    /**
     * Generates smooth vertex normals for the mesh based on triangle geometry.
     * Overwrites the `normals` array with computed normals.
     * `normals` array should already be allocated.
     */
    bool generateNormals()
    {
        if (vertices.length == 0 ||
            normals.length == 0)
            return false;
    
        normals[] = Vector3f(0.0f, 0.0f, 0.0f);
    
        foreach(i, ref f; indices)
        {
            Vector3f v0 = vertices[f[0]];
            Vector3f v1 = vertices[f[1]];
            Vector3f v2 = vertices[f[2]];
            
            Vector3f p = cross(v1 - v0, v2 - v0);
            
            normals[f[0]] += p;
            normals[f[1]] += p;
            normals[f[2]] += p;
        }
        
        foreach(i, n; normals)
        {
            normals[i] = n.normalized;
        }
        
        return true;
    }
    
    /**
     * Generates tangent vectors for the mesh based on existing vertex data.
     * Requires vertices, normals, texcoords, and indices.
     * Overwrites the `tangents` array with computed tangents (alighed with U-direction in texture space).
     * `tangents` array should already be allocated.
     */
    bool generateTangents()
    {
        if (indices.length == 0 ||
            vertices.length == 0 ||
            normals.length == 0 ||
            tangents.length == 0 ||
            texcoords.length == 0)
            return false;
        
        // Temporary array for accumulating tangents and bitangents
        Vector3f[] tSum = New!(Vector3f[])(vertices.length);
        Vector3f[] bSum = New!(Vector3f[])(vertices.length);
        tSum[] = Vector3f(0.0f, 0.0f, 0.0f);
        bSum[] = Vector3f(0.0f, 0.0f, 0.0f);
        
        foreach(ref tri; indices)
        {
            uint i0 = tri[0];
            uint i1 = tri[1];
            uint i2 = tri[2];
            
            Vector3f v0 = vertices[i0];
            Vector3f v1 = vertices[i1];
            Vector3f v2 = vertices[i2];
            
            Vector2f uv0 = texcoords[i0];
            Vector2f uv1 = texcoords[i1];
            Vector2f uv2 = texcoords[i2];
            
            Vector3f edge1 = v1 - v0;
            Vector3f edge2 = v2 - v0;
            
            Vector2f duv1 = uv1 - uv0;
            Vector2f duv2 = uv2 - uv0;
            
            float det = (duv1.x * duv2.y) - (duv2.x * duv1.y);
            
            // Skip degenerate UV triangles
            if (abs(det) < 1e-8f)
                continue;
            
            float f = 1.0f / det;
            
            Vector3f tangent   = (edge1 * duv2.y - edge2 * duv1.y) * f;
            Vector3f bitangent = (edge2 * duv1.x - edge1 * duv2.x) * f;
            
            tSum[i0] += tangent;
            tSum[i1] += tangent;
            tSum[i2] += tangent;
            
            bSum[i0] += bitangent;
            bSum[i1] += bitangent;
            bSum[i2] += bitangent;
        }
        
        foreach(i, ref tangent; tangents)
        {
            Vector3f n = normals[i];
            Vector3f t = tSum[i];
            Vector3f b = bSum[i];

            // Gram-Schmidt orthogonalization
            t = (t - n * dot(n, t)).normalized;
            
            float handedness = dot(cross(n, t), b) < 0.0f ? -1.0f : 1.0f;
            
            tangent = Vector4f(t.x, t.y, t.z, handedness);
        }
        
        Delete(tSum);
        Delete(bSum);
        
        return true;
    }
    
    /**
     * Prepares OpenGL VAO and VBOs for rendering the mesh.
     * Uploads vertex, normal, texcoord, and index data to the GPU.
     * Sets up attribute pointers and enables rendering.
     */
    void prepareVAO()
    {
        if (!dataReady)
            return;

        glGenBuffers(1, &vbo);
        glBindBuffer(GL_ARRAY_BUFFER, vbo);
        glBufferData(GL_ARRAY_BUFFER, vertices.length * float.sizeof * 3, vertices.ptr, GL_STATIC_DRAW); 

        glGenBuffers(1, &nbo);
        glBindBuffer(GL_ARRAY_BUFFER, nbo);
        glBufferData(GL_ARRAY_BUFFER, normals.length * float.sizeof * 3, normals.ptr, GL_STATIC_DRAW);

        glGenBuffers(1, &tbo);
        glBindBuffer(GL_ARRAY_BUFFER, tbo);
        glBufferData(GL_ARRAY_BUFFER, texcoords.length * float.sizeof * 2, texcoords.ptr, GL_STATIC_DRAW);

        if (texcoords2.length && useTexcoords2)
        {
            glGenBuffers(1, &t2bo);
            glBindBuffer(GL_ARRAY_BUFFER, t2bo);
            glBufferData(GL_ARRAY_BUFFER, texcoords2.length * float.sizeof * 2, texcoords2.ptr, GL_STATIC_DRAW);
        }
        
        if (tangents.length && useTangents)
        {
            glGenBuffers(1, &tnbo);
            glBindBuffer(GL_ARRAY_BUFFER, tnbo);
            glBufferData(GL_ARRAY_BUFFER, tangents.length * float.sizeof * 4, tangents.ptr, GL_STATIC_DRAW);
        }
        
        if (colors.length && useColors)
        {
            glGenBuffers(1, &cbo);
            glBindBuffer(GL_ARRAY_BUFFER, cbo);
            glBufferData(GL_ARRAY_BUFFER, colors.length * float.sizeof * 4, colors.ptr, GL_STATIC_DRAW);
        }
        
        if (bones.length && useBones)
        {
            glGenBuffers(1, &bbo);
            glBindBuffer(GL_ARRAY_BUFFER, bbo);
            glBufferData(GL_ARRAY_BUFFER, bones.length * uint.sizeof * 4, bones.ptr, GL_STATIC_DRAW);
        }
        
        if (weights.length && useWeights)
        {
            glGenBuffers(1, &wbo);
            glBindBuffer(GL_ARRAY_BUFFER, wbo);
            glBufferData(GL_ARRAY_BUFFER, weights.length * float.sizeof * 4, weights.ptr, GL_STATIC_DRAW);
        }
        
        glGenBuffers(1, &eao);
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, eao);
        glBufferData(GL_ELEMENT_ARRAY_BUFFER, indices.length * uint.sizeof * 3, indices.ptr, GL_STATIC_DRAW);

        glGenVertexArrays(1, &vao);
        glBindVertexArray(vao);
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, eao);
    
        glEnableVertexAttribArray(VertexAttrib.Vertices);
        glBindBuffer(GL_ARRAY_BUFFER, vbo);
        glVertexAttribPointer(VertexAttrib.Vertices, 3, GL_FLOAT, GL_FALSE, 0, null);
    
        glEnableVertexAttribArray(VertexAttrib.Normals);
        glBindBuffer(GL_ARRAY_BUFFER, nbo);
        glVertexAttribPointer(VertexAttrib.Normals, 3, GL_FLOAT, GL_FALSE, 0, null);
    
        glEnableVertexAttribArray(VertexAttrib.Texcoords);
        glBindBuffer(GL_ARRAY_BUFFER, tbo);
        glVertexAttribPointer(VertexAttrib.Texcoords, 2, GL_FLOAT, GL_FALSE, 0, null);

        if (t2bo && useTexcoords2)
        {
            glEnableVertexAttribArray(VertexAttrib.Texcoords2);
            glBindBuffer(GL_ARRAY_BUFFER, t2bo);
            glVertexAttribPointer(VertexAttrib.Texcoords2, 2, GL_FLOAT, GL_FALSE, 0, null);
        }

        if (tnbo && useTangents)
        {
            glEnableVertexAttribArray(VertexAttrib.Tangents);
            glBindBuffer(GL_ARRAY_BUFFER, tnbo);
            glVertexAttribPointer(VertexAttrib.Tangents, 4, GL_FLOAT, GL_FALSE, 0, null);
        }

        if (cbo && useColors)
        {
            glEnableVertexAttribArray(VertexAttrib.Colors);
            glBindBuffer(GL_ARRAY_BUFFER, cbo);
            glVertexAttribPointer(VertexAttrib.Colors, 4, GL_FLOAT, GL_FALSE, 0, null);
        }

        if (bbo && useBones)
        {
            glEnableVertexAttribArray(VertexAttrib.Bones);
            glBindBuffer(GL_ARRAY_BUFFER, bbo);
            glVertexAttribPointer(VertexAttrib.Bones, 4, GL_UNSIGNED_INT, GL_FALSE, 0, null);
        }

        if (wbo && useWeights)
        {
            glEnableVertexAttribArray(VertexAttrib.Weights);
            glBindBuffer(GL_ARRAY_BUFFER, wbo);
            glVertexAttribPointer(VertexAttrib.Weights, 4, GL_FLOAT, GL_FALSE, 0, null);
        }

        glBindVertexArray(0);
        
        canRender = true;
    }
    
    /**
     * Renders the mesh using the provided graphics pipeline state.
     *
     * Params:
     *   state = Pointer to the current graphics pipeline state.
     */
    void render(GraphicsState* state)
    {
        if (!canRender)
            return;
        
        if (facegroups.length && renderFacegroups)
        {
            glBindVertexArray(vao);
            
            foreach(ref fg; facegroups)
            {
                if (fg.visible)
                {
                    Material previousMaterial;
                    if (fg.material)
                    {
                        previousMaterial = state.material;
                        state.material = fg.material;
                        state.material.bind(state);
                    }
                    
                    state.shader.bindParameters(state);

                    glDrawElements(GL_TRIANGLES, fg.numTriangles * 3, GL_UNSIGNED_INT, cast(void*)(fg.firstTriangle * 3 * uint.sizeof));

                    state.shader.unbindParameters(state);

                    if (fg.material)
                    {
                        state.material.unbind(state);
                        state.material = previousMaterial;
                    }
                }
            }
            
            glBindVertexArray(0);
        }
        else
        {
            glBindVertexArray(vao);
            glDrawElements(GL_TRIANGLES, cast(uint)indices.length * 3, GL_UNSIGNED_INT, cast(void*)0);
            glBindVertexArray(0);
        }
    }
}
