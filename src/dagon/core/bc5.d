/**
 * BC5 texture encoder.
 *
 * Description:
 * Provides `bc5Compress` function that converts images to BC5.
 *
 * Copyright: Timur Gafarov 2026
 * License: $(LINK2 https://boost.org/LICENSE_1_0.txt, Boost License 1.0).
 * Authors: Timur Gafarov
 */
module dagon.core.bc5;

import std.math;
import dlib.math.utils;
import dagon.core.bc4;

/**
 * Compress image to BC5 to the memory buffer.
 * The buffer must be allocated and have the required capacity which is
 * calculated as numBlocksH * numBlocksV * 16.
 * BC5 block is 4x4 pixels.
 *
 * Params:
 *   output = Pointer to the output buffer.
 *   image  = Pointer to the input image.
 *   width  = Width of the image.
 *   height = Height of the image.
 *   numChannels = number of channels in the input image (R and G channels are used).
 */
void bc5Compress(ubyte* output, ubyte* image, uint width, uint height, uint numChannels)
{
    ubyte[16] blockR; // 4x4 for the red channel
    ubyte[16] blockG; // 4x4 for the green channel
    
    auto hblocks = max2(1, (width + 3) / 4);
    auto vblocks = max2(1, (height + 3) / 4);
    
    for (uint by = 0; by < vblocks; by++)
    {
        for (uint bx = 0; bx < hblocks; bx++)
        {
            // Fill 4x4 input blocks for both channels
            for (uint y = 0; y < 4; y++)
            {
                for (uint x = 0; x < 4; x++)
                {
                    uint srcx = bx * 4 + x;
                    uint srcy = by * 4 + y;
                    
                    if (srcx >= width)  srcx = width - 1;
                    if (srcy >= height) srcy = height - 1;
                    uint srcIndex = (srcy * width + srcx) * numChannels;
                    
                    uint dstIndex = y * 4 + x;
                    blockR[dstIndex] = image[srcIndex];
                    
                    if (numChannels > 1)
                        blockG[dstIndex] = image[srcIndex + 1];
                    else
                        blockG[dstIndex] = image[srcIndex];
                }
            }

            uint blockIndex = by * hblocks + bx;
            uint blockOffset = blockIndex * 16;
            
            bc4CompressBlock(output + blockOffset, blockR.ptr);
            bc4CompressBlock(output + blockOffset + 8, blockG.ptr);
        }
    }
}
