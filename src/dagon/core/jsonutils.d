module dagon.core.jsonutils;

import dlib.math.vector;
import dlib.math.matrix;
import dlib.math.quaternion;
import dlib.image.color;
import dlib.serialization.json;

/**
 * Universal JSON object field getter.
 */
T fieldAs(T)(JSONObject obj, string key, T def)
{
    JSONValue* p = key in obj;
    if (p is null)
        return def;

    static if (is(T == bool))
    {
        return (p.type == JSONType.Boolean)? p.asBoolean : def;
    }
    else static if (is(T == string))
    {
        return p.asString;
    }
    else static if (is(T == ulong))
    {
        return (p.type == JSONType.Number)? cast(ulong)p.asNumber : def;
    }
    else static if (is(T == long))
    {
        return (p.type == JSONType.Number)? cast(long)p.asNumber : def;
    }
    else static if (is(T == uint))
    {
        return (p.type == JSONType.Number)? cast(uint)p.asNumber : def;
    }
    else static if (is(T == int))
    {
        return (p.type == JSONType.Number)? cast(int)p.asNumber : def;
    }
    else static if (is(T == double) || is(T == float))
    {
        return (p.type == JSONType.Number)? p.asNumber : def;
    }
    else static if (is(T == Color4f))
    {
        if (p.type != JSONType.Array)
            return def;
        Color4f col = def;
        foreach(i, v; p.asArray)
        {
            if (i < 4)
                col[i] = (v.type == JSONType.Number)? v.asNumber : def[i];
        }
        return col;
    }
    else static if (is(T == Vector2f))
    {
        if (p.type != JSONType.Array)
            return def;
        Vector2f vec = def;
        foreach(i, v; p.asArray)
        {
            if (i < 2)
                vec[i] = (v.type == JSONType.Number)? v.asNumber : def[i];
        }
        return vec;
    }
    else static if (is(T == Vector3f))
    {
        if (p.type != JSONType.Array)
            return def;
        Vector3f vec = def;
        foreach(i, v; p.asArray)
        {
            if (i < 3)
                vec[i] = (v.type == JSONType.Number)? v.asNumber : def[i];
        }
        return vec;
    }
    else static if (is(T == Vector4f))
    {
        if (p.type != JSONType.Array)
            return def;
        Vector4f vec = def;
        foreach(i, v; p.asArray)
        {
            if (i < 4)
                vec[i] = (v.type == JSONType.Number)? v.asNumber : def[i];
        }
        return vec;
    }
    else static if (is(T == Quaternionf))
    {
        if (p.type != JSONType.Array)
            return def;
        Quaternionf q = def;
        foreach(i, v; p.asArray)
        {
            if (i < 4)
                q[i] = (v.type == JSONType.Number)? v.asNumber : def[i];
        }
        return q;
    }
    else static if (is(T == Matrix3x3f))
    {
        if (p.type != JSONType.Array)
            return def;
        Matrix3x3f m = def;
        foreach(i, v; p.asArray)
        {
            if (i < 9)
                m[i] = (v.type == JSONType.Number)? v.asNumber : def[i];
        }
        return m;
    }
    else static if (is(T == Matrix4x4f))
    {
        if (p.type != JSONType.Array)
            return def;
        Matrix4x4f m = def;
        foreach(i, v; p.asArray)
        {
            if (i < 16)
                m[i] = (v.type == JSONType.Number)? v.asNumber : def[i];
        }
        return m;
    }
    else static assert(false, "jsonGet: unsupported type " ~ T.stringof);
}

/**
 * Converts a JSON array value to a `Vector3f`.
 *
 * Params:
 *   value = The JSON value.
 * Returns:
 *   The corresponding vector.
 */
Vector3f asVector(JSONValue value)
{
    Vector3f vec = Vector3f(0.0f, 0.0f, 0.0f);
    foreach(i, v; value.asArray)
    {
        if (i < 3)
            vec[i] = v.asNumber;
    }
    return vec;
}

/**
 * Converts a JSON array value to a `Matrix4x4f`.
 *
 * Params:
 *   value = The JSON value.
 * Returns:
 *   The corresponding matrix.
 */
Matrix4x4f asMatrix(JSONValue value)
{
    Matrix4x4f mat = Matrix4x4f.identity;
    foreach(i, v; value.asArray)
    {
        if (i < 16)
            mat[i] = v.asNumber;
    }
    return mat;
}

/**
 * Converts a JSON array value to a `Quaternionf`.
 *
 * Params:
 *   value = The JSON value.
 * Returns:
 *   The corresponding quaternion.
 */
Quaternionf asQuaternion(JSONValue value)
{
    Quaternionf q = Quaternionf.identity;
    foreach(i, v; value.asArray)
    {
        if (i < 4)
            q[i] = v.asNumber;
    }
    return q;
}

/**
 * Converts a JSON array value to a `Color4f`.
 *
 * Params:
 *   value = The JSON value.
 * Returns:
 *   The corresponding color.
 */
Color4f asColor(JSONValue value)
{
    Color4f col = Color4f(1.0f, 1.0f, 1.0f, 1.0f);
    foreach(i, v; value.asArray)
    {
        if (i < 4)
            col[i] = v.asNumber;
    }
    return col;
}

/**
 * Converts a JSON number value to uint.
 *
 * Params:
 *   value = The JSON value.
 * Returns:
 *   Unsigned integer.
 */
uint asUint(JSONValue value)
{
    return cast(uint)value.asNumber;
}
